# InwardClub 2.0 server environment. Copy to .env and fill in for your machine.
# Only variable names are listed; never commit real secrets.

APP_ENV=development
LOG_LEVEL=info
HTTP_ADDR=:8081

# Set false in production once real WeChat/Qiniu/printer/acquirer are configured.
USE_FAKE_ADAPTERS=true

# Business-day reference for day-bucketed features (daily sign-in calendar day,
# weekly/monthly leaderboard windows). BUSINESS_TZ fixes the wall-clock zone.
# BUSINESS_NOW_RFC3339 is a dev/acceptance-only override that pins the current
# instant; leave it EMPTY in production so the clock uses real host time.
BUSINESS_TZ=Asia/Shanghai
BUSINESS_NOW_RFC3339=

MYSQL_DSN=
REDIS_ADDR=

JWT_SIGNING_KEY=
JWT_ISSUER=inwardclub

# Mini-program app id + secret. Required when USE_FAKE_ADAPTERS=false: they power
# the real WeChat login (jscode2session) and phone binding (getuserphonenumber).
WECHAT_MINI_APP_ID=
WECHAT_MINI_APP_SECRET=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_MCH_CERT_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY_PATH=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_NOTIFY_URL=

# Offline aggregated-collection acquirer (门店线下聚合收款). All five are required
# when USE_FAKE_ADAPTERS=false; the real HTTP client signs each request/callback
# with API_KEY (HMAC-SHA256) and posts to BASE_URL. Alipay lives only in this
# channel. NOTIFY_URL is where the acquirer posts payment callbacks.
OFFLINE_ACQUIRER_PROVIDER=
OFFLINE_ACQUIRER_MERCHANT_ID=
OFFLINE_ACQUIRER_API_KEY=
OFFLINE_ACQUIRER_NOTIFY_URL=
OFFLINE_ACQUIRER_BASE_URL=

QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=
QINIU_REGION=
QINIU_PUBLIC_DOMAIN=
QINIU_PRIVATE_DOMAIN=
QINIU_UPLOAD_CALLBACK_URL=
QINIU_TOKEN_TTL_SECONDS=600
QINIU_PRIVATE_URL_TTL_SECONDS=300

# Xpyun (芯烨云) cloud printer account auth. Both are required when
# USE_FAKE_ADAPTERS=false; the worker's print:receipt handler prints through the
# real client and signs each request SHA1(user+ukey+timestamp).
XPYUN_USER=
XPYUN_UKEY=

# Used only by cmd/reconcile to read the legacy v1 database (read-only).
V1_MYSQL_DSN=
