# 总后台独立环境变量（admin-console）
# 应用标识，用于错误监控 / 埋点区分总后台
VITE_APP_ID=inwardclub-admin-console

# 总后台 API 根路径；生产由 Nginx 将同源 /api/v2 反向代理到 API 服务
VITE_API_BASE_URL=/api/v2

# token audience 固定为 admin，前端收到非 admin audience 必须清空登录态
VITE_AUTH_AUDIENCE=admin

# 资产公共访问域名（可选），仅用于展示 assetId 对应的图片
VITE_ASSET_PUBLIC_DOMAIN=
