# 门店后台独立环境变量（store-console）
# 应用标识，用于错误监控 / 埋点区分门店后台
VITE_APP_ID=inwardclub-store-console

# 门店后台 API 根地址，必须指向 /api/v2 网关
VITE_API_BASE_URL=https://api.inwardclub.cn/api/v2

# token audience 固定为 store，前端收到非 store audience 必须清空登录态
VITE_AUTH_AUDIENCE=store

# 资产公共访问域名（可选），仅用于展示 assetId 对应的图片
VITE_ASSET_PUBLIC_DOMAIN=
