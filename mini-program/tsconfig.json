{
  "compilerOptions": {
    "target": "ES2019",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": [],
    "lib": ["ES2019"]
  },
  "include": ["miniprogram/**/*.js", "typings/**/*.d.ts"],
  "exclude": ["node_modules", "miniprogram_npm"]
}
