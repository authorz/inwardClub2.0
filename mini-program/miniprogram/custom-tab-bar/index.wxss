.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  display: flex;
  height: 100rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: #ffffff;
  border-top: 1rpx solid #ededed;
}
.tabbar__item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}
.tabbar__icon {
  width: 48rpx;
  height: 48rpx;
}
.tabbar__text {
  font-size: 20rpx;
  color: #8a8a8a;
}
.tabbar__item.is-active .tabbar__text {
  color: #111111;
  font-weight: 600;
}
