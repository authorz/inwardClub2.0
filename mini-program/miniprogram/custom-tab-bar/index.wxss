.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  display: flex;
  align-items: flex-end;
  /* Preserve the full tabbar size while removing the former 12rpx bottom lift. */
  height: calc(112rpx + env(safe-area-inset-bottom));
  padding: 0 24rpx env(safe-area-inset-bottom);
  box-sizing: border-box;
}

.tabbar__glass {
  position: relative;
  display: flex;
  width: 100%;
  height: 112rpx;
  padding: 4rpx 8rpx;
  overflow: hidden;
  box-sizing: border-box;
  border: 1rpx solid rgba(255, 255, 255, 0.28);
  border-radius: 56rpx;
  background: rgba(22, 25, 30, 0.34);
  -webkit-backdrop-filter: blur(40rpx) saturate(155%) brightness(0.92);
  backdrop-filter: blur(40rpx) saturate(155%) brightness(0.92);
  box-shadow:
    0 8rpx 16rpx rgba(0, 0, 0, 0.2),
    inset 0 1rpx 2rpx rgba(255, 255, 255, 0.34),
    inset 0 -1rpx 2rpx rgba(0, 0, 0, 0.18);
}

.tabbar__glass::before {
  content: "";
  position: absolute;
  top: 0;
  right: 20rpx;
  left: 20rpx;
  height: 48rpx;
  border-radius: 56rpx 56rpx 40% 40%;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.16), rgba(255, 255, 255, 0));
  pointer-events: none;
}

.tabbar__item {
  position: relative;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
  min-width: 0;
  z-index: 1;
  color: rgba(255, 255, 255, 0.68);
  transition: transform 180ms cubic-bezier(0.22, 1, 0.36, 1);
}

.tabbar__item.is-pressed {
  transform: scale(0.95);
}

.tabbar__icon-shell {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  box-sizing: border-box;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.05);
  box-shadow:
    inset 0 1rpx 1rpx rgba(255, 255, 255, 0.12),
    inset 0 -1rpx 1rpx rgba(0, 0, 0, 0.08);
  transition:
    background-color 200ms cubic-bezier(0.22, 1, 0.36, 1),
    border-color 200ms cubic-bezier(0.22, 1, 0.36, 1),
    transform 200ms cubic-bezier(0.22, 1, 0.36, 1);
}

.tabbar__item.is-active .tabbar__icon-shell {
  border-color: rgba(255, 255, 255, 0.76);
  background: rgba(255, 255, 255, 0.82);
  -webkit-backdrop-filter: blur(16rpx) saturate(125%) brightness(1.06);
  backdrop-filter: blur(16rpx) saturate(125%) brightness(1.06);
  box-shadow:
    0 2rpx 6rpx rgba(0, 0, 0, 0.18),
    inset 0 2rpx 2rpx rgba(255, 255, 255, 0.74),
    inset 0 -2rpx 3rpx rgba(20, 23, 28, 0.12);
  transform: translateY(-2rpx);
}

.tabbar__item.is-active .tabbar__icon-shell::before {
  content: "";
  position: absolute;
  top: 2rpx;
  left: 10rpx;
  right: 10rpx;
  height: 22rpx;
  border-top: 2rpx solid rgba(255, 255, 255, 0.82);
  border-radius: 50%;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.22), rgba(255, 255, 255, 0));
}

.tabbar__icon {
  position: relative;
  z-index: 1;
  width: 42rpx;
  height: 42rpx;
  opacity: 0.66;
  -webkit-filter: brightness(0) invert(1);
  filter: brightness(0) invert(1);
  transition: opacity 180ms ease-out;
}

.tabbar__item.is-active .tabbar__icon {
  opacity: 1;
  -webkit-filter: none;
  filter: none;
}

.tabbar__text {
  font-size: 20rpx;
  line-height: 28rpx;
  color: currentColor;
}

.tabbar__item.is-active .tabbar__text {
  color: rgba(255, 255, 255, 0.96);
  font-weight: 600;
}

@media (prefers-reduced-motion: reduce) {
  .tabbar__item,
  .tabbar__icon-shell,
  .tabbar__icon {
    transition: none;
  }
}
