.mine {
  position: relative;
}
.mine__nav {
  position: fixed;
  top: 0;
  right: 0;
  left: 0;
  z-index: 10;
  background: transparent;
}
.mine__nav-spacer { width: 100%; flex: none; pointer-events: none; }
.mine__nav-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}
.mine__nav-logo {
  display: block;
  width: auto;
  height: 52rpx;
  filter: brightness(0) invert(1) drop-shadow(0 2rpx 6rpx rgba(0, 0, 0, 0.3));
  opacity: 0.96;
}
.mine__content {
  position: relative;
  z-index: 1;
  padding: 70rpx 24rpx calc(160rpx + env(safe-area-inset-bottom));
}
/* ---- profile ---- */
.mine__summary { padding: 12rpx 6rpx 20rpx; }
.mine__profile {
  min-height: 166rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
}
.mine__profile-benefits {
  min-width: 0;
  min-height: 166rpx;
  padding: 18rpx 0 18rpx 30rpx;
  flex: 1;
  display: flex;
  align-items: center;
  box-sizing: border-box;
}
.mine__profile-edit {
  width: 112rpx;
  align-self: stretch;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
}
.mine__profile-benefits--hover,
.mine__profile-edit--hover { opacity: 0.72; }
.mine__avatar {
  position: relative;
  width: 112rpx;
  height: 112rpx;
  flex: none;
  border-radius: 50%;
  overflow: visible;
  background: rgba(255, 255, 255, 0.12);
  box-shadow: 0 0 0 1rpx rgba(255, 255, 255, 0.48);
}
.mine__avatar-img { width: 100%; height: 100%; border-radius: 50%; }
.mine__avatar-ph {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.12);
  color: rgba(255, 255, 255, 0.92);
  font-size: 24rpx;
}
.mine__gender {
  position: absolute;
  right: -2rpx;
  bottom: -2rpx;
  width: 34rpx;
  height: 34rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.96);
  border-radius: 50%;
  box-sizing: border-box;
  background: var(--ic-white);
}
.mine__ident { flex: 1; min-width: 0; margin-left: 28rpx; }
.mine__nameline { display: flex; align-items: center; gap: 14rpx; min-width: 0; }
.mine__name {
  min-width: 0;
  max-width: 300rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.25;
  color: rgba(255, 255, 255, 0.96);
}
.mine__tier {
  flex: none;
  padding: 7rpx 14rpx;
  border-radius: 999rpx;
  font-size: 18rpx;
  font-weight: 600;
  line-height: 1.25;
  background: rgba(255, 255, 255, 0.84);
  color: #14171b;
}
.mine__invite { display: inline-flex; align-items: center; gap: 4rpx; margin-top: 12rpx; }
.mine__invite-text { font-size: 20rpx; color: rgba(255, 255, 255, 0.68); line-height: 1; }
.mine__invite-copy-hit {
  width: 64rpx;
  height: 64rpx;
  margin: -18rpx -16rpx -18rpx -8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.mine__invite-copy { width: 28rpx; height: 28rpx; color: rgba(255, 255, 255, 0.68); transform: translateY(-4rpx) scale(0.58); transform-origin: center; }
.mine__profile-arrow { flex: none; margin-left: 0; border-color: rgba(255, 255, 255, 0.5); }

/* ---- assets ---- */
.mine__assets {
  margin: 0 18rpx;
  padding: 34rpx 6rpx 30rpx;
  display: flex;
  align-items: center;
}
.mine__asset {
  flex: 1;
  min-width: 0;
  padding: 8rpx 10rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}
.mine__asset--hover { opacity: 0.56; }
.mine__asset-num {
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 36rpx;
  font-weight: 650;
  line-height: 1.2;
  color: rgba(255, 255, 255, 0.96);
  font-variant-numeric: tabular-nums;
}
.mine__asset-label { font-size: 22rpx; line-height: 1.35; color: rgba(255, 255, 255, 0.66); }

/* ---- independent service glass controls ---- */
.mine__service-stage {
  position: relative;
  margin-top: 64rpx;
}
.mine__services {
  padding: 0 4rpx;
}
.mine__services-title {
  display: block;
  padding: 0 12rpx 18rpx;
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1.35;
  color: rgba(255, 255, 255, 0.72);
}
.mine__service-grid {
  position: relative;
  z-index: 1;
  display: flex;
  flex-wrap: wrap;
  row-gap: 28rpx;
  padding: 0;
  box-sizing: border-box;
}
.mine__service-item {
  width: 33.333%;
  min-height: 166rpx;
  padding: 0 4rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
}
.mine__service-item--hover .mine__service-icon-box {
  opacity: 0.78;
  transform: scale(0.98);
}
.mine__service-icon-box {
  width: 62rpx;
  height: 62rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.18s ease-out, opacity 0.18s ease-out;
}
.mine__service-icon { width: 54rpx; height: 54rpx; color: var(--ic-black); }
.mine__service-icon--activity { transform: scale(0.94); }
.mine__service-icon--recharge { transform: scale(0.96); }
.mine__service-icon--coupon { transform: scale(1.02); }
.mine__service-image {
  position: relative;
  z-index: 1;
  width: 58rpx;
  height: 58rpx;
  filter: grayscale(1) brightness(0) invert(1);
  opacity: 0.76;
}
.mine__service-label { font-size: 22rpx; line-height: 1.3; color: rgba(255, 255, 255, 0.82); text-align: center; white-space: nowrap; }
.mine__services--staff { margin-top: 34rpx; }
.mine__services--staff .mine__service-item { width: 33.333%; }

/* ---- recharge sheet ---- */
/* 三列档位：保持快速比较的紧凑结构，通过留白区分金额与赠送权益 */
.rc__tiles { display: flex; flex-wrap: wrap; gap: 14rpx; margin: 22rpx 0 12rpx; }
.rc__tile {
  position: relative;
  width: calc((100% - 28rpx) / 3);
  min-height: 176rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 24rpx 8rpx 22rpx;
  border: 1rpx solid var(--ic-line);
  border-radius: 16rpx;
  background: #fff;
}
.rc__tile.is-active { border: 2rpx solid var(--ic-black); }
.rc__price { font-size: 28rpx; font-weight: 700; line-height: 1.15; color: var(--ic-black); }
.rc__coins { margin-top: 14rpx; font-size: 22rpx; line-height: 1.25; color: var(--ic-text-2); white-space: nowrap; }
.rc__points { margin-top: 8rpx; font-size: 20rpx; line-height: 1.25; color: var(--ic-text-3); white-space: nowrap; }
.rc__check { position: absolute; top: -2rpx; right: -2rpx; width: 36rpx; height: 36rpx; border-radius: 0 14rpx 0 14rpx; background: #111; display: flex; align-items: center; justify-content: center; }
.rc__check .ic-ic { color: #fff; }
.rc__notice { display: block; margin: 8rpx 0 22rpx; color: var(--ic-text-2); font-size: 22rpx; line-height: 1.65; }
/* 自定义金额行 */
.rc__custom { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; margin: 4rpx 0 8rpx; padding: 22rpx 24rpx; border: 2rpx solid var(--ic-line-strong); border-radius: 18rpx; background: #fff; }
.rc__custom.is-active { border-color: #111; }
.rc__custom-label { font-size: 24rpx; color: var(--ic-text); flex: none; }
.rc__custom-field { display: flex; align-items: baseline; gap: 6rpx; }
.rc__custom-sign { font-size: 26rpx; font-weight: 700; color: var(--ic-black); }
.rc__custom-input { min-width: 160rpx; text-align: right; font-size: 26rpx; font-weight: 700; color: var(--ic-black); }
.rc__custom-ph { font-weight: 400; color: var(--ic-text-4); }
.rc__pay { display: flex; align-items: center; gap: 14rpx; font-size: 24rpx; color: var(--ic-text); }
.rc__wx { width: 42rpx; height: 42rpx; display: block; }
/* footer 避开自定义 tabbar（100rpx）与底部安全区，确认按钮宽度稳定 */
.rc__footer { display: flex; align-items: center; gap: 24rpx; margin-bottom: calc(100rpx + env(safe-area-inset-bottom)); }
.rc__total { display: flex; align-items: baseline; gap: 8rpx; flex: none; }
.rc__total-label { font-size: 22rpx; color: var(--ic-text-2); }
.rc__total-num { font-size: 30rpx; font-weight: 700; color: var(--ic-black); font-variant-numeric: tabular-nums; }
.rc__btn { flex: 1; margin-left: 0 !important; margin-right: 0 !important; }
.rc__btn::after { border: none; }

/* ---- point-saving sheet ---- */
.ps__store { margin-top: 12rpx; }
/* 门店信息视觉弱化：更小、更浅 */
.ps__store-label { font-size: 22rpx; color: var(--ic-text-3); }
.ps__store-name { max-width: 60%; font-size: 22rpx; color: var(--ic-text-2); }
/* 表单 item 固定 44px(88rpx)，行与行之间再留一点垂直间距 */
.ps__row { height: 88rpx; box-sizing: border-box; padding: 0; margin-bottom: 12rpx; }
/* 余额行：弱提示，让输入行成为主内容 */
.ps__balance { display: flex; align-items: baseline; justify-content: space-between; padding: 12rpx 0; }
.ps__balance-label { font-size: 22rpx; color: var(--ic-text-3); }
.ps__balance-num { font-size: 22rpx; color: var(--ic-text-3); }
.ps__field { display: flex; align-items: center; gap: 16rpx; height: 104rpx; box-sizing: border-box; padding: 0; margin-top: 20rpx; margin-bottom: 12rpx; border-top: 1rpx solid var(--ic-line); }
.ps__field-label { width: 140rpx; font-size: 26rpx; color: var(--ic-text); }
.ps__input { flex: 1; font-size: 26rpx; color: var(--ic-black); }
.ps__ph { color: var(--ic-text-4); }
.ps__unit { font-size: 22rpx; color: var(--ic-text-3); }
.ps__hint { display: flex; align-items: center; gap: 8rpx; margin-top: 20rpx; font-size: 20rpx; color: var(--ic-text-4); }
.ps__hint-ico { display: inline-flex; align-items: center; justify-content: center; width: 26rpx; height: 26rpx; border: 1rpx solid var(--ic-text-4); border-radius: 50%; font-size: 18rpx; line-height: 1; color: var(--ic-text-4); }
.ps__ledger { display: flex; align-items: center; justify-content: center; gap: 8rpx; padding: 26rpx 0 4rpx; font-size: 22rpx; color: var(--ic-text-2); }
/* 提交按钮需避开自定义 tabbar（100rpx）与底部安全区 */
.ps__footer { width: 100%; box-sizing: border-box; margin-bottom: calc(100rpx + env(safe-area-inset-bottom)); }
/* 提交申请按钮横向撑满：强覆盖微信 button 默认左右 margin */
.ps__submit { width: 100% !important; margin-left: 0 !important; margin-right: 0 !important; display: flex; align-items: center; justify-content: center; height: 88rpx; line-height: 88rpx; padding-left: 0; padding-right: 0; box-sizing: border-box; text-align: center; }
.ps__submit::after { border: none; }
