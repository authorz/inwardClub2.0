<page-meta page-style="{{ (showRecharge || showPoint) ? 'overflow: hidden;' : '' }}" />
<ic-app-background />
<view class="mine ic-scroll-shell">
  <view class="mine__nav-spacer" style="height: {{navStatusBar + navContentHeight}}px;" aria-hidden="true"></view>
  <view class="mine__nav" style="padding-top: {{navStatusBar}}px;">
    <view class="mine__nav-bar" style="height: {{navContentHeight}}px; padding-left: {{navRightGap}}px; padding-right: {{navRightGap}}px;">
      <image
        class="mine__nav-logo"
        src="https://assets.inwardclub.com/public/images/inward-logo-optimized.gif?imageMogr2/format/png"
        mode="heightFix"
        aria-label="Inward Club"
      />
    </view>
  </view>

  <scroll-view class="mine__scroll ic-scroll-view" scroll-y enhanced show-scrollbar="{{false}}" bounces="{{false}}">
  <view class="mine__content">
    <!-- Identity and assets share one continuous glass card. -->
    <view class="mine__summary ic-glass-recessed">
      <view class="mine__profile">
        <view
          class="mine__profile-benefits"
          hover-class="mine__profile-benefits--hover"
          bindtap="goBenefits"
          aria-role="button"
          aria-label="查看会员权益"
        >
          <view class="mine__avatar">
            <image wx:if="{{me.avatarUrl}}" class="mine__avatar-img" src="{{me.avatarUrl}}" mode="aspectFill" />
            <view wx:else class="mine__avatar-ph"><text>{{me.nickname || '会员'}}</text></view>
            <image wx:if="{{genderIcon}}" class="mine__gender" src="{{genderIcon}}" mode="aspectFit" />
          </view>
          <view class="mine__ident">
            <view class="mine__nameline">
              <text class="mine__name">{{me.nickname || '会员'}}</text>
              <view wx:if="{{me.tierShort}}" class="mine__tier">{{me.tierShort}}</view>
            </view>
            <view class="mine__invite">
              <text class="mine__invite-text">邀请码 {{me.inviteCode || '--'}}</text>
              <view
                class="mine__invite-copy-hit"
                catchtap="copyInvite"
                aria-role="button"
                aria-label="复制邀请码"
              ><view class="ic-ic ic-ic-copy mine__invite-copy"></view></view>
            </view>
          </view>
        </view>
        <view
          class="mine__profile-edit"
          hover-class="mine__profile-edit--hover"
          bindtap="goProfile"
          aria-role="button"
          aria-label="编辑个人资料"
        ><view class="ic-arrow mine__profile-arrow"></view></view>
      </view>

      <!-- assets: 优惠券 / 金币余额 / 积分 -->
      <view class="mine__assets">
        <view class="mine__asset" data-asset="coupons" bindtap="onAsset" hover-class="mine__asset--hover">
          <text class="mine__asset-num">{{wallet.couponCount || 0}}</text>
          <text class="mine__asset-label">优惠券</text>
        </view>
        <view class="mine__asset" data-asset="coins" bindtap="onAsset" hover-class="mine__asset--hover">
          <text class="mine__asset-num">{{coinsText}}</text>
          <text class="mine__asset-label">金币余额</text>
        </view>
        <view class="mine__asset" data-asset="points" bindtap="onAsset" hover-class="mine__asset--hover">
          <text class="mine__asset-num">{{pointsText}}</text>
          <text class="mine__asset-label">积分</text>
        </view>
      </view>
    </view>

    <!-- Primary actions use independent circular glass controls. -->
    <view class="mine__service-stage">
      <view class="mine__services">
        <view class="mine__service-grid">
          <view class="mine__service-item" bindtap="goOrder" hover-class="mine__service-item--hover">
            <view class="mine__service-icon-box"><image class="mine__service-image" src="{{orderEntry.icon}}" mode="aspectFit" /></view>
            <text class="mine__service-label">{{orderEntry.label}}</text>
          </view>
          <view class="mine__service-item" wx:for="{{memberMenuEntries}}" wx:key="label" data-index="{{index}}" bindtap="goMember" hover-class="mine__service-item--hover">
            <view class="mine__service-icon-box"><image class="mine__service-image" src="{{item.icon}}" mode="aspectFit" /></view>
            <text class="mine__service-label">{{item.label}}</text>
          </view>
        </view>
      </view>

      <!-- 工作人员工作台（仅员工当前选中其绑定门店时可见） -->
      <view wx:if="{{isStaff}}" class="mine__staff">
        <view class="mine__staff-head">
          <view class="mine__staff-heading">
            <text class="mine__staff-title">工作人员工作台</text>
            <text class="mine__staff-store ic-ellipsis">{{staffStoreName || '当前绑定门店'}}</text>
          </view>
          <text class="mine__staff-scope">仅当前门店</text>
        </view>

        <view class="mine__staff-actions">
          <view
            class="mine__staff-action"
            wx:for="{{staffActionEntries}}"
            wx:key="label"
            data-index="{{index}}"
            bindtap="goStaffMenu"
            hover-class="mine__staff-action--hover"
            aria-role="button"
            aria-label="{{item.label}}，{{item.note}}"
          >
            <image class="mine__staff-action-icon" src="{{item.icon}}" mode="aspectFit" />
            <view class="mine__staff-action-copy">
              <text class="mine__staff-action-label">{{item.label}}</text>
              <text class="mine__staff-action-note">{{item.note}}</text>
            </view>
            <view class="ic-arrow mine__staff-arrow"></view>
          </view>
        </view>

        <view class="mine__staff-section">
          <view class="mine__staff-section-head">
            <view class="mine__staff-section-titleline">
              <text class="mine__staff-section-title">待审核积分存入</text>
              <text class="mine__staff-count">{{pendingReviewCount}}</text>
            </view>
            <text class="mine__staff-link" bindtap="goStaffReviewList">查看全部</text>
          </view>
          <view class="mine__staff-search">
            <input
              class="mine__staff-search-input"
              type="number"
              maxlength="11"
              value="{{staffPhone}}"
              placeholder="输入手机号或尾号搜索"
              placeholder-class="mine__staff-search-ph"
              confirm-type="search"
              bindinput="onStaffPhoneInput"
              bindconfirm="searchStaffPhone"
            />
            <text wx:if="{{staffPhone}}" class="mine__staff-search-clear" bindtap="clearStaffPhone">清除</text>
            <text class="mine__staff-search-btn" bindtap="searchStaffPhone">搜索</text>
          </view>
          <text wx:if="{{staffLoading}}" class="mine__staff-loading">正在更新门店数据…</text>
          <view wx:if="{{pendingSavings.length}}" class="mine__review-list">
            <view class="mine__review-row" wx:for="{{pendingSavings}}" wx:key="id">
              <view class="mine__review-main" data-id="{{item.id}}" bindtap="goStaffPointDetail">
                <view class="mine__review-primary">
                  <text class="mine__review-name ic-ellipsis">{{item.memberName}}</text>
                  <text class="mine__review-points">{{item.pointsText}} 积分</text>
                </view>
                <text class="mine__review-meta">{{item.phoneText}} · {{item.timeText}}</text>
              </view>
              <view class="mine__review-actions">
                <button class="mine__review-btn mine__review-btn--ghost" data-id="{{item.id}}" data-decision="reject" catchtap="reviewPendingSaving">驳回</button>
                <button class="mine__review-btn mine__review-btn--primary" data-id="{{item.id}}" data-decision="approve" catchtap="reviewPendingSaving">通过</button>
              </view>
            </view>
          </view>
          <view wx:elif="{{!staffLoading}}" class="mine__staff-empty">
            <text>{{staffPhone ? '未找到该手机号的待审核申请' : '当前门店暂无待审核积分存入'}}</text>
          </view>
        </view>

        <view class="mine__staff-section mine__staff-section--today">
          <view class="mine__staff-section-head">
            <view class="mine__staff-section-titleline">
              <text class="mine__staff-section-title">今日营业明细</text>
              <text class="mine__staff-date">实时</text>
            </view>
            <text class="mine__staff-link" bindtap="goStaffToday">查看全部</text>
          </view>
          <view class="mine__staff-totals">
            <view class="mine__staff-total">
              <text class="mine__staff-total-num">{{todaySummary.coinConsumptionAmountText}}</text>
              <text class="mine__staff-total-label">金币消费 · {{todaySummary.coinConsumptionCount}} 笔</text>
            </view>
            <view class="mine__staff-total">
              <text class="mine__staff-total-num">{{todaySummary.pointDepositAmountText}}</text>
              <text class="mine__staff-total-label">积分存入 · {{todaySummary.pointDepositCount}} 笔</text>
            </view>
            <view class="mine__staff-total">
              <text class="mine__staff-total-num">{{todaySummary.pointWithdrawalAmountText}}</text>
              <text class="mine__staff-total-label">积分提取 · {{todaySummary.pointWithdrawalCount}} 笔</text>
            </view>
          </view>
          <view wx:if="{{todayOperations.length}}" class="mine__operation-list">
            <view class="mine__operation-row" wx:for="{{todayOperations}}" wx:key="recordKey">
              <view class="mine__operation-main">
                <view class="mine__operation-titleline">
                  <text class="mine__operation-type">{{item.typeLabel}}</text>
                  <text class="mine__operation-member ic-ellipsis">{{item.memberName}}</text>
                </view>
                <text class="mine__operation-meta">{{item.phoneText || item.statusLabel}} · {{item.timeText}}</text>
              </view>
              <text class="mine__operation-amount">{{item.amountText}}</text>
            </view>
          </view>
          <view wx:else class="mine__staff-empty"><text>今日暂无金币消费或积分存取记录</text></view>
          <view class="mine__staff-records" bindtap="goStaffRecords">
            <text>查看门票核销记录</text><view class="ic-arrow mine__staff-records-arrow"></view>
          </view>
        </view>
      </view>
    </view>
  </view>
  </scroll-view>
</view>

<!-- 充值金币弹层（仅微信支付） -->
<ic-bottom-sheet show="{{showRecharge}}" title="充值金币" height="78vh" max-height="78vh" bind:close="closeRecharge">
  <view class="sheet-row">
    <text class="sheet-row__label">当前金币</text>
    <text class="sheet-row__num">{{wallet.coins}}</text>
  </view>
  <view class="rc__tiles">
    <view
      class="rc__tile {{productId === item.id ? 'is-active' : ''}}"
      wx:for="{{products}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="pickProduct"
    >
      <text class="rc__price">¥{{item.priceYuan}}</text>
      <text class="rc__coins">得 {{item.totalCoins}} 金币</text>
      <text wx:if="{{item.pointsAmount > 0}}" class="rc__points">赠 {{item.pointsAmount}} 积分</text>
      <view wx:if="{{productId === item.id}}" class="rc__check"><view class="ic-ic ic-ic-check ic-ic--sm"></view></view>
    </view>
  </view>
  <text wx:if="{{rechargeNotice}}" class="rc__notice">{{rechargeNotice}}</text>
  <view class="rc__custom {{productId === 'custom' ? 'is-active' : ''}}" data-id="custom" bindtap="pickProduct">
    <text class="rc__custom-label">自定义金额</text>
    <view class="rc__custom-field">
      <text class="rc__custom-sign">¥</text>
      <input class="rc__custom-input" type="number" maxlength="7" value="{{customAmount}}" placeholder="输入金额" placeholder-class="rc__custom-ph" bindinput="onCustomAmount" />
    </view>
  </view>
  <view class="sheet-row sheet-row--bordered">
    <text class="sheet-row__label">支付方式</text>
    <view class="rc__pay"><image class="rc__wx" src="/assets/payment/wechat-pay.png" mode="aspectFit" /><text>微信支付</text></view>
  </view>
  <text class="sheet-note">到账金币以后台充值档位为准</text>
  <view slot="footer" class="rc__footer">
    <view class="rc__total"><text class="rc__total-label">合计</text><text class="rc__total-num">¥{{rechargeTotal}}</text></view>
    <button class="ic-btn ic-btn-primary rc__btn" loading="{{submitting}}" bindtap="confirmRecharge">确认充值</button>
  </view>
</ic-bottom-sheet>

<!-- 存取积分弹层（固定当前门店，工作人员审核） -->
<ic-bottom-sheet show="{{showPoint}}" title="{{pointSheetTitle}}" height="auto" max-height="58vh" scroll-body="{{false}}" bind:close="closePoint">
  <view class="sheet-row sheet-row--bordered ps__store ps__row">
    <text class="sheet-row__label ps__store-label">门店</text>
    <text class="ps__store-name ic-ellipsis">{{pointStoreName}}</text>
  </view>
  <view class="ps__balance">
    <text class="ps__balance-label">积分余额</text>
    <text class="ps__balance-num">{{wallet.points}}</text>
  </view>
  <view class="ps__field">
    <text class="ps__field-label">积分数量</text>
    <input class="ps__input" type="number" maxlength="10" value="{{pointAmount}}" placeholder="请输入积分数量" placeholder-class="ps__ph" bindinput="onPointAmount" />
    <text class="ps__unit">积分</text>
  </view>
  <view class="ps__hint"><text class="ps__hint-ico">!</text>提交后由工作人员审核</view>
  <view class="ps__ledger" bindtap="goLedger"><text>查看积分流水</text><view class="ic-arrow"></view></view>
  <view slot="footer" class="ps__footer">
    <button class="ic-btn ic-btn-primary ic-btn-block ps__submit" loading="{{submitting}}" bindtap="confirmPoint">{{pointSubmitText}}</button>
  </view>
</ic-bottom-sheet>
