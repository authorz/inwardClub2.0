<view class="ad">
  <view class="ad__nav {{navSolid ? 'is-solid' : ''}}" style="padding-top: {{navStatusBar}}px;">
    <view class="ad__nav-bar" style="height: {{navContentHeight}}px; padding-right: {{navRightGap}}px;">
      <view class="ad__nav-action" bindtap="goHome">
        <image class="ad__nav-home" src="/assets/icons/go-home.svg" mode="aspectFit" />
      </view>
      <text wx:if="{{navSolid && activity}}" class="ad__nav-title">{{activity.title}}</text>
      <button wx:if="{{navSolid && activity}}" class="ad__nav-share" open-type="share">
        <image class="ad__nav-share-icon" src="/assets/icons/share.svg" mode="aspectFit" />
      </button>
    </view>
  </view>

  <ic-loading wx:if="{{loading}}" />

  <ic-empty wx:elif="{{loadError}}" text="{{loadError}}" />

  <block wx:elif="{{activity}}">
    <view class="ad__hero">
      <ic-poster src="{{activity.imageUrl}}" title="{{activity.title}}" tone="{{activity.tone}}" radius="0" />
    </view>

    <scroll-view
      class="ad__scroll"
      scroll-y
      enhanced
      scroll-top="{{initialScrollTop}}"
      show-scrollbar="{{false}}"
      bindscroll="onScroll"
    >
      <view class="ad__hero-spacer"></view>
      <view class="ad__content">
        <view class="ad__pull-hint" aria-hidden="true"></view>
        <view class="ad__head">
          <text class="ad__title">{{activity.title}}</text>
          <text wx:if="{{activity.description}}" class="ad__description">{{activity.description}}</text>
          <view class="ad__head-sub">
            <view class="ad__status">
              <view class="ad__status-dot"></view>
              <text class="ad__status-text">{{activity.statusText}}</text>
            </view>
            <view wx:if="{{activity.hasTickets}}" class="ad__head-price">
              <text class="ad__head-yuan">¥{{minPriceText}}</text>
              <text class="ad__head-from">起</text>
            </view>
            <text wx:else class="ad__head-empty">暂无可售门票</text>
          </view>
        </view>

        <view wx:if="{{activity.dateText || activity.clockText}}" class="ad__schedule">
          <text wx:if="{{activity.dateText}}" class="ad__schedule-date">{{activity.dateText}}</text>
          <text wx:if="{{activity.clockText}}" class="ad__schedule-time">{{activity.clockText}}</text>
        </view>

        <view wx:if="{{activity.locationText}}" class="ad__venue">
          <view class="ad__venue-head">
            <text class="ad__venue-label">地址</text>
            <text wx:if="{{activity.storeScopeText}}" class="ad__venue-scope">{{activity.storeScopeText}}</text>
          </view>
          <view class="ad__venue-card {{mapPoint ? 'ad__venue-card--tap' : ''}}" bindtap="openLocation">
            <image class="ad__venue-map" src="/assets/icons/venue-map.svg" mode="aspectFill" />
            <view class="ad__venue-copy">
              <text class="ad__venue-name">{{activity.storeName}}</text>
              <text wx:if="{{activity.address}}" class="ad__venue-address">{{activity.address}}</text>
            </view>
            <view class="ad__venue-aside">
              <image class="ad__venue-pin" src="/assets/icons/location.svg" mode="aspectFit" />
              <text wx:if="{{activity.distanceText}}" class="ad__venue-distance">{{activity.distanceText}}</text>
              <text wx:elif="{{mapPoint}}" class="ad__venue-distance">导航</text>
            </view>
          </view>
        </view>

        <view class="ad__section">
          <text class="ad__section-title">活动详情</text>
          <rich-text wx:if="{{activity.hasDetail}}" class="ad__rich" nodes="{{activity.detailNodes}}"></rich-text>
          <view wx:else class="ad__empty">暂无图文详情</view>
        </view>

        <view class="ad__section ad__section--last">
          <text class="ad__section-title">购票须知</text>
          <view class="ad__notice">
            <text class="ad__notice-line">❖ 票务售出，不可退换</text>
            <text class="ad__notice-line">❖ 现场票售罄可于线下购买</text>
            <text class="ad__notice-line">❖ 未成年人禁止入内！禁止暴力！毒品及性骚扰事件！</text>
          </view>
        </view>
      </view>
    </scroll-view>

    <view class="ad__bar">
      <button
        class="ic-btn ic-btn-primary ad__bar-btn {{activity.hasTickets ? '' : 'ic-disabled'}}"
        disabled="{{!activity.hasTickets}}"
        bindtap="openPurchase"
      >立即预约</button>
    </view>
  </block>
</view>
