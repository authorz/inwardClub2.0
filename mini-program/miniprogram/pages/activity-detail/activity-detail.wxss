page { background: #000; color: rgba(255, 255, 255, 0.88); }
.ad {
  --ad-text-primary: rgba(255, 255, 255, 0.88);
  --ad-text-secondary: rgba(255, 255, 255, 0.72);
  --ad-text-muted: rgba(255, 255, 255, 0.58);
  position: relative; height: 100vh; overflow: hidden; background: #000; color: var(--ad-text-primary);
}
.ad__hero { position: absolute; top: 0; left: 0; width: 100%; height: 1000rpx; background: #000; }
.ad__scroll {
  position: relative; z-index: 1; height: 100vh;
  padding-bottom: calc(152rpx + env(safe-area-inset-bottom));
  background: transparent; box-sizing: border-box;
}
.ad__scroll--no-action { padding-bottom: env(safe-area-inset-bottom); }
.ad__hero-spacer { width: 100%; height: 1000rpx; }

/* Custom navigation stays transparent; scrolling only reveals the title and share action. */
.ad__nav { position: fixed; top: 0; left: 0; right: 0; z-index: 50; color: var(--ad-text-primary); }
.ad__nav-bar { display: flex; align-items: center; gap: 12rpx; padding-left: 24rpx; box-sizing: border-box; }
.ad__nav-action, .ad__nav-share {
  display: flex; align-items: center; justify-content: center; flex: none;
  width: 64rpx; height: 64rpx; margin: 0; padding: 0; border: 1rpx solid rgba(0, 0, 0, 0.08); border-radius: 50%;
  background: rgba(255, 255, 255, 0.92); box-sizing: border-box;
}
button.ad__nav-share {
  width: 64rpx !important; min-width: 64rpx; max-width: 64rpx;
  height: 64rpx !important; min-height: 64rpx; max-height: 64rpx;
  margin-left: 0 !important; margin-right: 0 !important;
  padding: 0 !important; line-height: 1;
}
.ad__nav-action:active, .ad__nav-share:active { opacity: 0.7; }
.ad__nav-share::after { border: none; }
.ad__nav-home, .ad__nav-share-icon { width: 36rpx; height: 36rpx; display: block; }
.ad__nav-title {
  flex: 1; min-width: 0; font-size: 26rpx; font-weight: 600; color: var(--ad-text-primary);
  text-shadow: -1rpx 0 0 rgba(0, 0, 0, 0.55), 1rpx 0 0 rgba(0, 0, 0, 0.55), 0 -1rpx 0 rgba(0, 0, 0, 0.55), 0 1rpx 0 rgba(0, 0, 0, 0.55);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}

/* Poster-led editorial content sheet */
.ad__content {
  position: relative; padding: 0 40rpx;
  border-radius: 50rpx 50rpx 0 0; background: #000; overflow: hidden;
}
.ad__pull-hint {
  position: absolute; top: 16rpx; left: 50%;
  width: 76rpx; height: 8rpx; margin-left: -38rpx;
  border-radius: 999rpx; background: rgba(255, 255, 255, 0.92);
  animation: ad-pull-hint-breathe 2.6s cubic-bezier(0.45, 0, 0.55, 1) infinite;
}
@keyframes ad-pull-hint-breathe {
  0%, 100% { opacity: 0.38; }
  50% { opacity: 1; }
}
@media (prefers-reduced-motion: reduce) {
  .ad__pull-hint { animation: none; opacity: 0.72; }
}
.ad__head { padding: 44rpx 0 40rpx; border-bottom: 1rpx solid rgba(255, 255, 255, 0.18); }
.ad__title { display: block; font-size: 30rpx; font-weight: 700; color: var(--ad-text-primary); line-height: 1.28; }
.ad__description { display: block; margin-top: 18rpx; font-size: 24rpx; line-height: 1.65; color: var(--ad-text-secondary); }
.ad__head-sub { display: flex; align-items: center; justify-content: space-between; gap: 24rpx; margin-top: 28rpx; }
.ad__status { display: inline-flex; align-items: center; gap: 12rpx; min-width: 0; }
.ad__status-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: #fff; }
.ad__status-text { font-size: 24rpx; color: var(--ad-text-secondary); }
.ad__head-price { display: flex; align-items: baseline; flex: none; }
.ad__head-yuan { font-size: 30rpx; font-weight: 700; color: var(--ad-text-primary); font-variant-numeric: tabular-nums; }
.ad__head-from { margin-left: 6rpx; font-size: 20rpx; color: var(--ad-text-muted); }
.ad__head-empty { font-size: 22rpx; color: var(--ad-text-muted); }

/* Date and time share one row, anchored to opposite edges. */
.ad__schedule { display: flex; align-items: baseline; justify-content: space-between; gap: 24rpx; padding: 38rpx 0 42rpx; }
.ad__schedule-date { font-size: 26rpx; font-weight: 600; color: var(--ad-text-primary); font-variant-numeric: tabular-nums; }
.ad__schedule-time { margin-left: auto; text-align: right; font-size: 24rpx; color: var(--ad-text-secondary); font-variant-numeric: tabular-nums; }
.ad__venue { padding-bottom: 46rpx; }
.ad__venue-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 18rpx; }
.ad__venue-label { font-size: 22rpx; font-weight: 600; color: var(--ad-text-primary); }
.ad__venue-scope { font-size: 20rpx; color: var(--ad-text-muted); }
.ad__venue-card {
  position: relative; overflow: hidden;
  display: flex; align-items: center; justify-content: space-between; gap: 24rpx;
  min-height: 142rpx; padding: 26rpx 30rpx; border-radius: 14rpx;
  background: #111; box-sizing: border-box;
}
.ad__venue-card--tap:active { opacity: 0.74; }
.ad__venue-map { position: absolute; top: 0; left: 0; width: 100%; height: 100%; opacity: 0.48; }
.ad__venue-copy { position: relative; z-index: 1; display: flex; flex-direction: column; gap: 8rpx; flex: 1; min-width: 0; }
.ad__venue-name { font-size: 28rpx; font-weight: 700; line-height: 1.3; color: var(--ad-text-primary); text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.7); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.ad__venue-address { font-size: 22rpx; line-height: 1.4; color: var(--ad-text-secondary); text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.7); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.ad__venue-aside { position: relative; z-index: 1; display: flex; flex-direction: column; align-items: center; gap: 8rpx; flex: none; min-width: 92rpx; }
.ad__venue-distance { font-size: 22rpx; font-weight: 700; line-height: 1.2; color: var(--ad-text-primary); text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.7); }
.ad__venue-pin {
  width: 48rpx; height: 48rpx;
  filter: brightness(0) invert(1) drop-shadow(0 2rpx 6rpx rgba(0, 0, 0, 0.7));
  opacity: 0.96;
}

/* Long-form sections */
.ad__section { padding: 48rpx 0; border-top: 1rpx solid rgba(255, 255, 255, 0.18); }
.ad__section--last { padding-bottom: 72rpx; }
.ad__section-title { display: block; font-size: 24rpx; font-weight: 600; color: var(--ad-text-primary); }
.ad__rich { display: block; margin-top: 28rpx; font-size: 24rpx; line-height: 1.8; color: var(--ad-text-secondary); overflow: hidden; }
.ad__empty { padding: 40rpx 0 12rpx; text-align: left; font-size: 24rpx; color: var(--ad-text-muted); }
.ad__notice { display: flex; flex-direction: column; gap: 8rpx; margin-top: 24rpx; }
.ad__notice-line, .ad__notice-ps { display: block; font-size: 22rpx; line-height: 1.6; color: var(--ad-text-secondary); }
.ad__notice-ps { margin-top: 2rpx; font-weight: 400; }

/* Fixed purchase action */
.ad__bar {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 40;
  display: flex; align-items: center;
  padding: 28rpx 48rpx calc(18rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(0, 0, 0, 0), rgba(0, 0, 0, 0.92) 44%);
}
.ad__bar-btn {
  flex: 1; width: 100% !important; height: 104rpx;
  margin-left: 0 !important; margin-right: 0 !important;
  border-radius: 999rpx;
  color: rgba(255, 255, 255, 0.94); font-size: 28rpx;
}
.ad__bar-btn.ic-glass-recessed {
  border-color: rgba(255, 255, 255, 0.22);
  background: rgba(168, 180, 198, 0.2);
  -webkit-backdrop-filter: blur(40rpx) saturate(155%) brightness(0.98);
  backdrop-filter: blur(40rpx) saturate(155%) brightness(0.98);
  box-shadow:
    inset 0 5rpx 10rpx rgba(4, 7, 11, 0.3),
    inset 0 -2rpx 3rpx rgba(255, 255, 255, 0.17),
    inset 1rpx 0 2rpx rgba(0, 0, 0, 0.08),
    inset -1rpx 0 2rpx rgba(255, 255, 255, 0.06);
}
.ad__bar-btn.ic-glass-recessed::before {
  right: 24rpx;
  left: 24rpx;
  height: 42rpx;
  border-radius: 999rpx 999rpx 45% 45%;
}
.ad__bar-btn.ic-disabled {
  border-color: rgba(255, 255, 255, 0.1);
  background: rgba(168, 180, 198, 0.09);
  color: rgba(255, 255, 255, 0.46);
}
