page { background: #000; color: #fff; }
.ad { height: 100vh; background: #000; color: #fff; }
.ad__scroll { height: 100vh; padding-bottom: calc(152rpx + env(safe-area-inset-bottom)); background: #000; box-sizing: border-box; }
.ad__hero { width: 100%; height: 1000rpx; background: #000; }

/* Custom navigation stays transparent; scrolling only reveals the title and share action. */
.ad__nav { position: fixed; top: 0; left: 0; right: 0; z-index: 50; color: #fff; }
.ad__nav-bar { display: flex; align-items: center; gap: 12rpx; padding-left: 24rpx; box-sizing: border-box; }
.ad__nav-action, .ad__nav-share {
  display: flex; align-items: center; justify-content: center; flex: none;
  width: 64rpx; height: 64rpx; margin: 0; padding: 0; border: 1rpx solid rgba(0, 0, 0, 0.08); border-radius: 50%;
  background: rgba(255, 255, 255, 0.92); box-sizing: border-box;
}
button.ad__nav-share {
  width: 64rpx !important; min-width: 64rpx; max-width: 64rpx;
  height: 64rpx !important; min-height: 64rpx; max-height: 64rpx;
  margin-left: 0 !important; margin-right: 0 !important;
  padding: 0 !important; line-height: 1;
}
.ad__nav-action:active, .ad__nav-share:active { opacity: 0.7; }
.ad__nav-share::after { border: none; }
.ad__nav-home, .ad__nav-share-icon { width: 36rpx; height: 36rpx; display: block; }
.ad__nav-title {
  flex: 1; min-width: 0; font-size: 30rpx; font-weight: 600; color: #fff;
  text-shadow: -1rpx 0 0 rgba(0, 0, 0, 0.55), 1rpx 0 0 rgba(0, 0, 0, 0.55), 0 -1rpx 0 rgba(0, 0, 0, 0.55), 0 1rpx 0 rgba(0, 0, 0, 0.55);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}

/* Poster-led editorial content sheet */
.ad__content {
  position: relative; margin-top: -32rpx; padding: 0 40rpx;
  border-radius: 28rpx 28rpx 0 0; background: #000; overflow: hidden;
}
.ad__head { padding: 44rpx 0 40rpx; border-bottom: 1rpx solid rgba(255, 255, 255, 0.18); }
.ad__title { display: block; font-size: 46rpx; font-weight: 700; color: #fff; line-height: 1.28; }
.ad__description { display: block; margin-top: 18rpx; font-size: 27rpx; line-height: 1.65; color: #fff; }
.ad__head-sub { display: flex; align-items: center; justify-content: space-between; gap: 24rpx; margin-top: 28rpx; }
.ad__status { display: inline-flex; align-items: center; gap: 12rpx; min-width: 0; }
.ad__status-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: #fff; }
.ad__status-text { font-size: 27rpx; color: #fff; }
.ad__head-price { display: flex; align-items: baseline; flex: none; }
.ad__head-yuan { font-size: 42rpx; font-weight: 700; color: #fff; font-variant-numeric: tabular-nums; }
.ad__head-from { margin-left: 6rpx; font-size: 22rpx; color: #fff; }
.ad__head-empty { font-size: 24rpx; color: #fff; }

/* Date and compact venue card */
.ad__schedule { display: flex; flex-direction: column; gap: 10rpx; padding: 38rpx 0 42rpx; }
.ad__schedule-date { font-size: 30rpx; font-weight: 600; color: #fff; font-variant-numeric: tabular-nums; }
.ad__schedule-time { font-size: 26rpx; color: #fff; font-variant-numeric: tabular-nums; }
.ad__venue { padding-bottom: 46rpx; }
.ad__venue-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 18rpx; }
.ad__venue-label { font-size: 25rpx; font-weight: 600; color: #fff; }
.ad__venue-scope { font-size: 23rpx; color: #fff; }
.ad__venue-card {
  position: relative; overflow: hidden;
  display: flex; align-items: center; justify-content: space-between; gap: 24rpx;
  min-height: 142rpx; padding: 26rpx 30rpx; border-radius: 14rpx;
  background: #111; box-sizing: border-box;
}
.ad__venue-card--tap:active { opacity: 0.74; }
.ad__venue-map { position: absolute; top: 0; left: 0; width: 100%; height: 100%; }
.ad__venue-copy { position: relative; z-index: 1; display: flex; flex-direction: column; gap: 8rpx; flex: 1; min-width: 0; }
.ad__venue-name { font-size: 31rpx; font-weight: 700; color: #fff; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.ad__venue-address { font-size: 23rpx; color: #fff; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.ad__venue-aside { position: relative; z-index: 1; display: flex; flex-direction: column; align-items: center; gap: 6rpx; flex: none; min-width: 76rpx; }
.ad__venue-distance { font-size: 22rpx; font-weight: 600; color: #fff; }
.ad__venue-pin { width: 42rpx; height: 42rpx; opacity: 0.42; }

/* Long-form sections */
.ad__section { padding: 48rpx 0; border-top: 1rpx solid rgba(255, 255, 255, 0.18); }
.ad__section--last { padding-bottom: 72rpx; }
.ad__section-title { display: block; font-size: 28rpx; font-weight: 600; color: #fff; }
.ad__rich { display: block; margin-top: 28rpx; font-size: 28rpx; line-height: 1.8; color: #fff; overflow: hidden; }
.ad__empty { padding: 40rpx 0 12rpx; text-align: left; font-size: 26rpx; color: #fff; }
.ad__notice { display: flex; flex-direction: column; gap: 8rpx; margin-top: 24rpx; }
.ad__notice-line, .ad__notice-ps { display: block; font-size: 24rpx; line-height: 1.6; color: #fff; }
.ad__notice-ps { margin-top: 2rpx; font-weight: 400; }

/* Fixed purchase action */
.ad__bar {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 40;
  display: flex; align-items: center;
  padding: 18rpx 48rpx calc(18rpx + env(safe-area-inset-bottom));
  background: #000;
}
.ad__bar-btn {
  flex: 1; width: 100% !important; height: 104rpx;
  margin-left: 0 !important; margin-right: 0 !important;
  border: 1rpx solid #fff; border-radius: 999rpx;
  background: #000; color: #fff; font-size: 32rpx;
}
.ad__bar-btn.ic-disabled { border-color: #666; background: #333; color: #fff; }
