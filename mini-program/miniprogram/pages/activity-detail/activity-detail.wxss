.ad { height: 100vh; background: var(--ic-white); }
.ad__scroll { height: 100vh; padding-bottom: calc(160rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }

.ad__hero { width: 100%; height: 480rpx; }

/* title + price header */
.ad__head { padding: 32rpx 24rpx 20rpx; }
.ad__title { display: block; font-size: 44rpx; font-weight: 700; color: var(--ic-black); line-height: 1.25; }
.ad__head-sub { display: flex; align-items: center; justify-content: space-between; margin-top: 18rpx; }
.ad__status { display: inline-flex; align-items: center; gap: 10rpx; }
.ad__status-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: var(--ic-black); }
.ad__status text { font-size: 24rpx; color: var(--ic-text); }
.ad__head-price { display: flex; align-items: baseline; }
.ad__head-yuan { font-size: 40rpx; font-weight: 700; color: var(--ic-black); font-variant-numeric: tabular-nums; }
.ad__head-from { font-size: 24rpx; color: var(--ic-text-3); margin-left: 4rpx; }

/* sticky anchor tabs */
.ad__tabs { position: sticky; top: 0; z-index: 20; background: var(--ic-white); padding: 0 12rpx; }
.ad__tabs.is-fixed { box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05); }

/* anchor offset targets — sit above each block for scroll-into-view landing */
.ad__anchor { height: 0; scroll-margin-top: 0; }

/* section blocks */
.ad__block { padding: 36rpx 24rpx; }
.ad__block + .ad__block { border-top: 16rpx solid var(--ic-bg, #f5f5f5); }
.ad__block--last { padding-bottom: 48rpx; }
.ad__block-title { display: block; margin-bottom: 24rpx; }

/* rich text + empty */
.ad__empty { padding: 40rpx 0; text-align: center; font-size: 26rpx; color: var(--ic-text-3); }

/* map card */
.ad__map { margin-top: 28rpx; border: 1rpx solid var(--ic-line); border-radius: 16rpx; overflow: hidden; }
.ad__map-canvas { width: 100%; height: 280rpx; display: block; }
.ad__map-foot { display: flex; align-items: center; justify-content: space-between; padding: 20rpx 24rpx; }
.ad__map-name { font-size: 26rpx; color: var(--ic-text); min-width: 0; }
.ad__map-go { flex: none; margin-left: 16rpx; font-size: 26rpx; font-weight: 600; color: var(--ic-black); }

/* notice list */
.ad__notice { display: flex; flex-direction: column; gap: 20rpx; }
.ad__notice-item { display: flex; align-items: baseline; gap: 16rpx; }
.ad__notice-label { flex: none; width: 72rpx; font-size: 26rpx; font-weight: 600; color: var(--ic-text-3); }
.ad__notice-text { flex: 1; min-width: 0; font-size: 28rpx; color: var(--ic-text); line-height: 1.6; }

/* compact meta grid */
.ad__meta { display: flex; flex-wrap: wrap; padding: 0 8rpx; }
.ad__meta-item { box-sizing: border-box; width: 50%; display: flex; align-items: center; gap: 12rpx; min-height: 64rpx; min-width: 0; }
.ad__meta-item--tap:active { opacity: 0.6; }
.ad__meta-text { font-size: 26rpx; color: var(--ic-text-2); min-width: 0; }

/* unified local line icons (32rpx, 2rpx stroke, no skew) */
.ad__mi { position: relative; flex: none; width: 32rpx; height: 32rpx; box-sizing: border-box; }
.ad__mi::before, .ad__mi::after { content: ""; position: absolute; box-sizing: border-box; }
/* time — clock face + hands */
.ad__mi--time::before { top: 2rpx; left: 2rpx; width: 28rpx; height: 28rpx; border: 2rpx solid var(--ic-text-2); border-radius: 50%; }
.ad__mi--time::after { top: 9rpx; left: 15rpx; width: 7rpx; height: 7rpx; border-left: 2rpx solid var(--ic-text-2); border-bottom: 2rpx solid var(--ic-text-2); }
/* store — location marker */
.ad__mi--store::before { top: 3rpx; left: 6rpx; width: 20rpx; height: 20rpx; border: 2rpx solid var(--ic-text-2); border-radius: 50%; }
.ad__mi--store::after { bottom: 3rpx; left: 15rpx; width: 2rpx; height: 8rpx; background: var(--ic-text-2); }
/* distance — navigation arrow */
.ad__mi--distance::before { top: 5rpx; left: 6rpx; border-left: 10rpx solid transparent; border-right: 10rpx solid transparent; border-bottom: 18rpx solid var(--ic-text-2); }
/* sale — calendar */
.ad__mi--sale::before { top: 5rpx; left: 4rpx; width: 24rpx; height: 22rpx; border: 2rpx solid var(--ic-text-2); border-radius: 3rpx; }
.ad__mi--sale::after { top: 11rpx; left: 4rpx; width: 24rpx; height: 2rpx; background: var(--ic-text-2); }

.ad__sec { margin-top: 32rpx; padding: 0 8rpx; }
.ad__sec--tickets { margin-top: 32rpx; padding: 28rpx 8rpx 0; border-top: 1rpx solid var(--ic-line); }
.ad__rich { display: block; font-size: 28rpx; color: var(--ic-text-2); line-height: 1.7; }

/* lightweight section label */
.ad__section-title { display: block; font-size: 28rpx; font-weight: 600; color: var(--ic-text-2); }
.ad__section-title--muted { font-weight: 500; color: var(--ic-text-3); }

/* ticket overview — only vertical dividers between columns */
.ad__tickets { display: flex; gap: 0; margin: 16rpx -24rpx 28rpx; background: transparent; border: none; border-radius: 0; overflow: hidden; }
.ad__ticket { flex: 1 1 0; min-width: 0; box-sizing: border-box; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6rpx; padding: 18rpx 14rpx; background: transparent; border: none; text-align: center; }
.ad__ticket + .ad__ticket { border-left: 1rpx solid var(--ic-line); }
.ad__tickets--single { justify-content: flex-start; }
.ad__tickets--single .ad__ticket { flex: 0 0 33.3333%; }
.ad__ticket-name { font-size: 28rpx; font-weight: 600; color: var(--ic-text-2); min-width: 0; }
.ad__ticket-yuan { font-size: 30rpx; font-weight: 700; color: var(--ic-black); }
.ad__ticket-side { font-size: 22rpx; color: var(--ic-text-3); }

/* fixed purchase bar */
.ad__bar {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 40;
  display: flex; align-items: center; gap: 24rpx;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: var(--ic-white); border-top: 1rpx solid var(--ic-line);
}
.ad__bar-price { display: flex; flex-direction: column; }
.ad__bar-amount { display: flex; align-items: baseline; }
.ad__bar-yuan { font-size: 42rpx; font-weight: 700; color: var(--ic-black); font-variant-numeric: tabular-nums; }
.ad__bar-from { font-size: 24rpx; color: var(--ic-text-3); margin-left: 6rpx; }
.ad__bar-ticket { font-size: 22rpx; color: var(--ic-text-3); }
.ad__bar-btn { flex: 1; }

/* purchase sheet */
.pt__list { margin-bottom: 12rpx; }
.pt__item { display: flex; flex-wrap: wrap; align-items: center; padding: 26rpx 24rpx; border: 2rpx solid var(--ic-line); border-radius: 18rpx; margin-bottom: 18rpx; }
.pt__item.is-active { border-color: #111; }
.pt__radio { width: 36rpx; height: 36rpx; border-radius: 50%; border: 3rpx solid #cfcfcf; margin-right: 20rpx; display: flex; align-items: center; justify-content: center; flex: none; }
.pt__item.is-active .pt__radio { border-color: #111; }
.pt__radio-on { width: 18rpx; height: 18rpx; border-radius: 50%; background: #111; }
.pt__main { flex: 1; min-width: 0; }
.pt__line { display: flex; align-items: baseline; justify-content: space-between; }
.pt__name { font-size: 34rpx; font-weight: 700; color: var(--ic-black); }
.pt__price { font-size: 34rpx; font-weight: 700; color: var(--ic-black); }
.pt__sub { display: block; margin-top: 8rpx; font-size: 22rpx; color: var(--ic-text-3); }
.pt__qty { width: 100%; display: flex; align-items: center; justify-content: space-between; margin-top: 22rpx; padding-top: 22rpx; border-top: 1rpx solid var(--ic-line); }
.pt__qty-label { font-size: 24rpx; color: var(--ic-text-2); }

.pt__pay { margin-top: 20rpx; }
.pt__pay .ic-h2 { display: block; margin-bottom: 20rpx; }
.pt__limit { display: flex; align-items: center; gap: 10rpx; margin-top: 22rpx; font-size: 24rpx; color: var(--ic-text-3); }

.pt__footer { display: flex; align-items: center; gap: 24rpx; }
.pt__total { display: flex; align-items: baseline; gap: 8rpx; }
.pt__total-label { font-size: 24rpx; color: var(--ic-text-2); }
.pt__total-num { font-size: 42rpx; font-weight: 700; color: var(--ic-black); font-variant-numeric: tabular-nums; }
.pt__btn { flex: 1; }
