<ic-loading wx:if="{{loading}}" />

<view wx:elif="{{tier}}" class="bf">
  <view
    class="bf__identity"
    style="background-color: {{tier.tone}}; color: {{tier.ink}};"
    aria-role="img"
    aria-label="{{tier.currentVer}} {{tier.currentName}}"
  >
    <image class="bf__identity-logo {{tier.logoClass}}" src="/assets/brand/logo-wordmark.png" mode="aspectFit"></image>
    <view class="bf__identity-vip" aria-hidden="true">
      <text class="bf__identity-vip-label">VIP</text>
      <view class="bf__identity-vip-rule"></view>
      <text class="bf__identity-vip-number">{{tier.currentNo}}</text>
    </view>
  </view>

  <view class="bf__status">
    <view class="bf__status-head">
      <view class="bf__member">
        <text class="bf__label">会员等级</text>
        <view class="bf__member-line">
          <text class="bf__member-name">{{tier.currentName}}</text>
          <text class="bf__member-vip">{{tier.currentVer}}</text>
        </view>
      </view>
      <view class="bf__growth-value">
        <text class="bf__label">成长值</text>
        <text class="bf__growth-num">{{tier.growthValue}}</text>
      </view>
    </view>
    <view class="bf__bar" aria-role="progressbar" aria-valuenow="{{tier.growthValue}}" aria-valuemax="{{tier.growthTarget || tier.growthValue}}">
      <view class="bf__bar-fill" style="width: {{tier.growthPct}}%;"></view>
    </view>
    <view class="bf__growth-foot">
      <text class="bf__growth-hint">{{tier.growthHint}}</text>
      <text wx:if="{{tier.growthTarget}}" class="bf__growth-target">{{tier.growthValue}} / {{tier.growthTarget}}</text>
    </view>
  </view>
</view>
