.bf {
  min-height: 100vh;
  padding: 28rpx 36rpx calc(52rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: var(--ic-white);
}

/* 会员身份面只保留品牌 LOGO 与 VIP 等级。 */
.bf__identity {
  height: 300rpx;
  padding: 34rpx 38rpx 30rpx;
  border-radius: 16rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}
.bf__identity-logo { width: 238rpx; height: 106rpx; align-self: flex-start; }
.bf__identity-logo.is-light { filter: brightness(0) invert(1); }
.bf__identity-logo.is-dark { filter: brightness(0); }
.bf__identity-vip {
  align-self: flex-end;
  font-size: 64rpx;
  font-weight: 700;
  line-height: 1;
  letter-spacing: -1rpx;
  font-variant-numeric: tabular-nums;
}

.bf__status { padding: 34rpx 4rpx 38rpx; }
.bf__status-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 28rpx; }
.bf__member { min-width: 0; }
.bf__label { display: block; font-size: 22rpx; line-height: 1.4; color: var(--ic-text-3); }
.bf__member-line { display: flex; align-items: center; gap: 12rpx; margin-top: 8rpx; min-width: 0; }
.bf__member-name { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 34rpx; font-weight: 650; line-height: 1.25; color: var(--ic-black); }
.bf__member-vip { flex: none; padding: 4rpx 10rpx; border-radius: 6rpx; background: var(--ic-black); color: var(--ic-white); font-size: 18rpx; font-weight: 650; line-height: 1.25; }
.bf__growth-value { flex: none; text-align: right; }
.bf__growth-num { display: block; margin-top: 4rpx; font-size: 38rpx; font-weight: 700; line-height: 1.2; color: var(--ic-black); font-variant-numeric: tabular-nums; }
.bf__bar { height: 10rpx; margin-top: 28rpx; overflow: hidden; border-radius: 999rpx; background: var(--ic-fill); }
.bf__bar-fill { height: 100%; border-radius: 999rpx; background: var(--ic-black); }
.bf__growth-foot { display: flex; align-items: center; justify-content: space-between; gap: 24rpx; margin-top: 12rpx; }
.bf__growth-hint, .bf__growth-target { font-size: 20rpx; line-height: 1.4; color: var(--ic-text-3); }
.bf__growth-target { flex: none; font-variant-numeric: tabular-nums; }
