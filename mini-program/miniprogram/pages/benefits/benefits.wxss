.bf {
  min-height: 100vh;
  padding: 28rpx 36rpx calc(52rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: var(--ic-white);
}

/* 会员身份面只保留品牌 LOGO 与 VIP 等级。 */
.bf__identity {
  height: 300rpx;
  padding: 34rpx 38rpx 30rpx;
  border-radius: 16rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}
.bf__identity.needs-border, .bf__level-mark.needs-border { border: 1rpx solid var(--ic-line-strong); }
.bf__identity-logo { width: 238rpx; height: 106rpx; align-self: flex-start; }
.bf__identity-logo.is-light, .bf__level-logo.is-light { filter: brightness(0) invert(1); }
.bf__identity-logo.is-dark, .bf__level-logo.is-dark { filter: brightness(0); }
.bf__identity-vip {
  align-self: flex-end;
  font-size: 64rpx;
  font-weight: 700;
  line-height: 1;
  letter-spacing: -1rpx;
  font-variant-numeric: tabular-nums;
}

.bf__status { padding: 34rpx 4rpx 38rpx; border-bottom: 1rpx solid var(--ic-line); }
.bf__status-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 28rpx; }
.bf__member { min-width: 0; }
.bf__label { display: block; font-size: 22rpx; line-height: 1.4; color: var(--ic-text-3); }
.bf__member-line { display: flex; align-items: center; gap: 12rpx; margin-top: 8rpx; min-width: 0; }
.bf__member-name { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 34rpx; font-weight: 650; line-height: 1.25; color: var(--ic-black); }
.bf__member-vip { flex: none; padding: 4rpx 10rpx; border-radius: 6rpx; background: var(--ic-black); color: var(--ic-white); font-size: 18rpx; font-weight: 650; line-height: 1.25; }
.bf__growth-value { flex: none; text-align: right; }
.bf__growth-num { display: block; margin-top: 4rpx; font-size: 38rpx; font-weight: 700; line-height: 1.2; color: var(--ic-black); font-variant-numeric: tabular-nums; }
.bf__bar { height: 10rpx; margin-top: 28rpx; overflow: hidden; border-radius: 999rpx; background: var(--ic-fill); }
.bf__bar-fill { height: 100%; border-radius: 999rpx; background: var(--ic-black); }
.bf__growth-foot { display: flex; align-items: center; justify-content: space-between; gap: 24rpx; margin-top: 12rpx; }
.bf__growth-hint, .bf__growth-target { font-size: 20rpx; line-height: 1.4; color: var(--ic-text-3); }
.bf__growth-target { flex: none; font-variant-numeric: tabular-nums; }

.bf__sec { margin-top: 44rpx; }
.bf__sec-title { display: block; padding-bottom: 18rpx; font-size: 28rpx; font-weight: 700; line-height: 1.3; color: var(--ic-black); }
.bf__benefits, .bf__levels { border-top: 1rpx solid var(--ic-line); }
.bf__benefit { display: flex; align-items: center; gap: 22rpx; min-height: 108rpx; padding: 24rpx 4rpx; border-bottom: 1rpx solid var(--ic-line); box-sizing: border-box; }
.bf__benefit-main { display: flex; flex: 1; min-width: 0; flex-direction: column; gap: 6rpx; }
.bf__benefit-title { font-size: 26rpx; font-weight: 600; line-height: 1.35; color: var(--ic-black); }
.bf__benefit-desc { font-size: 22rpx; line-height: 1.4; color: var(--ic-text-3); }

.bf__icon { position: relative; width: 36rpx; height: 36rpx; box-sizing: border-box; flex: none; color: var(--ic-black); }
.bf__icon--calendar { border: 2rpx solid currentColor; border-radius: 6rpx; }
.bf__icon--calendar::before { content: ""; position: absolute; left: -2rpx; right: -2rpx; top: 9rpx; height: 2rpx; background: currentColor; }
.bf__icon--calendar::after { content: ""; position: absolute; top: -6rpx; left: 9rpx; width: 2rpx; height: 8rpx; background: currentColor; box-shadow: 15rpx 0 0 currentColor; }
.bf__icon--coupon { border: 2rpx solid currentColor; border-radius: 6rpx; }
.bf__icon--coupon::before { content: ""; position: absolute; top: 50%; left: -2rpx; width: 10rpx; height: 10rpx; margin-top: -5rpx; border-radius: 50%; background: var(--ic-white); border: 2rpx solid currentColor; }
.bf__icon--coupon::after { content: ""; position: absolute; top: 50%; right: -2rpx; width: 10rpx; height: 10rpx; margin-top: -5rpx; border-radius: 50%; background: var(--ic-white); border: 2rpx solid currentColor; }
.bf__icon--gift { background: linear-gradient(currentColor, currentColor) no-repeat; background-size: 28rpx 7rpx; background-position: 4rpx 8rpx; }
.bf__icon--gift::before { content: ""; position: absolute; left: 6rpx; right: 6rpx; top: 15rpx; bottom: 3rpx; border: 2rpx solid currentColor; border-top: none; }
.bf__icon--gift::after { content: ""; position: absolute; left: 50%; top: 8rpx; bottom: 3rpx; width: 2rpx; margin-left: -1rpx; background: currentColor; }

.bf__level { display: flex; align-items: center; gap: 22rpx; min-height: 118rpx; padding: 24rpx 4rpx; border-bottom: 1rpx solid var(--ic-line); box-sizing: border-box; }
.bf__level-mark { width: 126rpx; height: 78rpx; padding: 10rpx 12rpx 9rpx; border-radius: 10rpx; box-sizing: border-box; display: flex; flex-direction: column; justify-content: space-between; }
.bf__level-logo { width: 76rpx; height: 34rpx; align-self: flex-start; }
.bf__level-vip { align-self: flex-end; font-size: 18rpx; font-weight: 700; line-height: 1; font-variant-numeric: tabular-nums; }
.bf__level-main { flex: 1; min-width: 0; }
.bf__level-head { display: flex; align-items: center; gap: 12rpx; }
.bf__level-name { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 26rpx; font-weight: 600; line-height: 1.35; color: var(--ic-black); }
.bf__level-tag { flex: none; padding: 3rpx 10rpx; border-radius: 6rpx; background: var(--ic-black); color: var(--ic-white); font-size: 18rpx; line-height: 1.25; }
.bf__level-desc { display: block; margin-top: 7rpx; font-size: 21rpx; line-height: 1.4; color: var(--ic-text-3); }
.bf__note { display: block; margin-top: 34rpx; text-align: center; font-size: 20rpx; line-height: 1.4; color: var(--ic-text-4); }
