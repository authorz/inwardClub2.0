<page-meta page-style="{{ showConfirm ? 'overflow: hidden;' : '' }}"></page-meta>

<view class="rsv-shell">
  <ic-page-nav
    title="预约"
    back="{{false}}"
    store-name="{{store.name || '选择门店'}}"
    store-address="{{store.address || '地址请咨询门店'}}"
    store-hours="{{store.hours || '营业时间请咨询门店'}}"
    bind:storetap="switchStore"
  />

  <scroll-view class="rsv__scroll" scroll-y enhanced show-scrollbar="{{false}}" bounces="{{false}}">
    <view class="rsv">
      <view class="rsv__sec">
        <text class="ic-h2">可预约桌台</text>
      </view>

      <ic-loading wx:if="{{loading}}" />
      <ic-empty wx:elif="{{!tables.length}}" text="当前门店暂无可预约桌台" />

      <block wx:else>
        <view class="rsv__table ic-glass-recessed" wx:for="{{tables}}" wx:key="id" data-tid="{{item.id}}">
          <view class="rsv__thead">
            <view class="rsv__table-title">
              <text class="rsv__tname">{{item.name}}</text>
              <text class="rsv__tseats">座位 {{item.reservedText}}</text>
            </view>
          </view>

          <view class="rsv__seat-line">
            <view class="rsv__seat-row">
              <view
                class="rsv__seat rsv__seat--{{seat.state}} {{seat.isMine ? 'rsv__seat--mine' : ''}}"
                wx:for="{{item.seats}}"
                wx:for-item="seat"
                wx:key="no"
                aria-label="{{seat.accessibilityLabel}}"
              >
                <block wx:if="{{seat.state === 'reserved'}}">
                  <image wx:if="{{seat.avatarUrl}}" class="rsv__seat-avatar {{seat.isGuest ? 'rsv__seat-avatar--brand' : ''}}" src="{{seat.avatarUrl}}" mode="{{seat.isGuest ? 'aspectFit' : 'aspectFill'}}"></image>
                  <text wx:else class="rsv__seat-initial">{{seat.initial}}</text>
                  <image wx:if="{{seat.genderIcon}}" class="rsv__seat-gender" src="{{seat.genderIcon}}" mode="aspectFit"></image>
                </block>
              </view>
            </view>
            <button
              class="rsv__reserve {{item.isMineTable ? 'rsv__reserve--cancel' : ''}} {{item.actionDisabled ? 'rsv__reserve--disabled' : ''}}"
              disabled="{{item.actionDisabled || cancellingReservationId}}"
              loading="{{item.isMineTable && cancellingReservationId === item.mineReservationId}}"
              data-id="{{item.id}}"
              bindtap="onTableAction"
            >{{item.actionText}}</button>
          </view>
        </view>
      </block>
    </view>
  </scroll-view>

  <view class="rsv__waitbar ic-glass-recessed">
    <button class="rsv__waitbtn" loading="{{waitlisting}}" disabled="{{waitlisting}}" bindtap="onWaitlist">
      <text>排队等候</text>
      <view class="rsv__wait-arrow"></view>
    </button>
  </view>
</view>

<!-- 座位预约确认弹层 -->
<ic-bottom-sheet show="{{showConfirm}}" title="确认预约" max-height="78vh" bind:close="onCloseConfirm">
  <view class="rsvc">
    <view class="rsvc__row">
      <view class="ic-ic ic-ic-person ic-ic--sm"></view>
      <text class="rsvc__val">{{selected.tableName}} · 系统自动分配空闲座位</text>
    </view>
    <view class="ic-divider"></view>
    <view class="rsvc__row">
      <view class="ic-ic ic-ic-clock ic-ic--sm"></view>
      <text class="rsvc__val">营业时间：{{store.hours || '请咨询门店'}}</text>
    </view>
    <view class="ic-divider"></view>
    <view class="rsvc__row">
      <image class="rsv__ic" src="/assets/icons/location.svg" mode="aspectFit"></image>
      <text class="rsvc__val ic-ellipsis">{{store.name}}</text>
    </view>
    <view class="rsvc__hint">预约后座位将保持占用，如不再需要可在当前桌台点击取消预约</view>
    <view class="rsvc__waitlist" hover-class="rsv__field--hover" bindtap="onWaitlist">
      <text>改为排队等候</text>
      <view class="ic-arrow"></view>
    </view>
  </view>
  <view slot="footer" class="rsvc__footer">
    <button class="ic-btn ic-btn-ghost rsvc__btn" bindtap="onCloseConfirm">取消</button>
    <button class="ic-btn ic-btn-primary rsvc__btn" loading="{{submitting}}" bindtap="onConfirm">确认预约</button>
  </view>
</ic-bottom-sheet>
