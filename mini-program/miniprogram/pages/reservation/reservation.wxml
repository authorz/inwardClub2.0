<page-meta page-style="{{ (showConfirm || showSignInSheet) ? 'overflow: hidden;' : '' }}"></page-meta>
<ic-app-background />

<view class="rsv-shell">
  <ic-page-nav
    title="预约"
    back="{{false}}"
    store-name="{{store.name || '选择门店'}}"
    store-address="{{store.address || '地址请咨询门店'}}"
    store-hours="{{store.hours || '营业时间请咨询门店'}}"
    bind:storetap="switchStore"
  />

  <scroll-view class="rsv__scroll" scroll-y enhanced show-scrollbar="{{false}}" bounces="{{false}}">
    <view class="rsv">
      <view class="rsv__sec">
        <view class="rsv__sec-title">
          <text class="ic-h2">可预约桌台</text>
          <text class="rsv__availability {{reservationAvailability.reservable ? '' : 'rsv__availability--closed'}}">{{reservationAvailability.availabilityHint}}</text>
        </view>
        <button
          class="rsv__sign-in ic-glass-control {{signInStatus.signedToday ? 'rsv__sign-in--done' : ''}} {{signInSubmitting ? 'rsv__sign-in--loading' : ''}}"
          size="mini"
          aria-label="{{signInStatus.signedToday ? '查看今日签到状态' : '查看签到规则'}}"
          disabled="{{signInSubmitting}}"
          hover-class="rsv__sign-in--hover"
          bindtap="onSignIn"
        >
          <view class="ic-ic ic-ic-calendar ic-ic--sm rsv__sign-in-icon"></view>
          <text class="rsv__sign-in-label">签到得积分</text>
          <text wx:if="{{signInStatus.signedToday}}" class="rsv__sign-in-badge">✓</text>
          <view wx:if="{{!signInStatus.signedToday && !signInSubmitting}}" class="rsv__sign-in-dot"></view>
        </button>
      </view>

      <ic-loading wx:if="{{loading}}" />
      <ic-empty wx:elif="{{!tables.length}}" text="当前门店暂无可预约桌台" />

      <block wx:else>
        <view class="rsv__table ic-glass-recessed" wx:for="{{tables}}" wx:key="id" data-tid="{{item.id}}">
          <view class="rsv__thead">
            <view class="rsv__table-title">
              <text class="rsv__tname">{{item.name}}</text>
              <text class="rsv__tseats">座位 {{item.reservedText}}</text>
            </view>
          </view>

          <view class="rsv__seat-line">
            <view class="rsv__seat-row">
              <view
                class="rsv__seat rsv__seat--{{seat.state}} {{seat.isMine ? 'rsv__seat--mine' : ''}}"
                wx:for="{{item.seats}}"
                wx:for-item="seat"
                wx:key="no"
                aria-label="{{seat.accessibilityLabel}}"
              >
                <block wx:if="{{seat.state === 'reserved'}}">
                  <image wx:if="{{seat.avatarUrl}}" class="rsv__seat-avatar {{seat.isGuest ? 'rsv__seat-avatar--brand' : ''}}" src="{{seat.avatarUrl}}" mode="{{seat.isGuest ? 'aspectFit' : 'aspectFill'}}"></image>
                  <text wx:else class="rsv__seat-initial">{{seat.initial}}</text>
                  <image wx:if="{{seat.genderIcon}}" class="rsv__seat-gender" src="{{seat.genderIcon}}" mode="aspectFit"></image>
                </block>
              </view>
            </view>
            <button
              class="rsv__reserve {{item.isMineTable ? 'rsv__reserve--cancel' : ''}} {{item.actionDisabled ? 'rsv__reserve--disabled' : ''}}"
              disabled="{{item.actionDisabled || cancellingReservationId !== ''}}"
              loading="{{item.isMineTable && cancellingReservationId === item.mineReservationId}}"
              data-id="{{item.id}}"
              bindtap="onTableAction"
            >{{item.actionText}}</button>
          </view>
        </view>
      </block>
    </view>
  </scroll-view>

  <view class="rsv__waitbar ic-glass-recessed">
    <button class="rsv__waitbtn" loading="{{waitlisting}}" disabled="{{waitlisting || !reservationAvailability.reservable}}" bindtap="onWaitlist">
      <view wx:if="{{waitlistAvatars.length}}" class="rsv__wait-avatars" aria-hidden="true">
        <image
          class="rsv__wait-avatar {{item.isFallback ? 'rsv__wait-avatar--fallback' : ''}}"
          wx:for="{{waitlistAvatars}}"
          wx:key="id"
          src="{{item.avatarUrl}}"
          mode="{{item.isFallback ? 'aspectFit' : 'aspectFill'}}"
        ></image>
      </view>
      <view wx:if="{{waitlistAvatars.length}}" class="rsv__wait-shade"></view>
      <view class="rsv__wait-content">
        <text>排队等候</text>
        <view class="rsv__wait-arrow"></view>
      </view>
    </button>
  </view>

  <view wx:if="{{showSignInSheet}}" class="rsv__sign-dialog">
    <view class="rsv__sign-dialog-panel">
      <view class="rsv__sign-dialog-head">
        <view class="rsv__sign-dialog-title">
          <view class="ic-ic ic-ic-calendar ic-ic--sm"></view>
          <text>签到得积分</text>
        </view>
        <view
          class="rsv__sign-dialog-close"
          aria-label="关闭签到弹窗"
          aria-role="button"
          hover-class="rsv__sign-dialog-close--hover"
          bindtap="closeSignInSheet"
        >×</view>
      </view>

      <view wx:if="{{signInStatus.dailyRewards.length}}" class="rsv__sign-rules">
        <view
          class="rsv__sign-rule {{signInStatus.streakDays >= index + 1 ? 'rsv__sign-rule--earned' : ''}} {{!signInStatus.signedToday && signInStatus.streakDays === index ? 'rsv__sign-rule--current' : ''}}"
          wx:for="{{signInStatus.dailyRewards}}"
          wx:key="index"
        >
          <text class="rsv__sign-rule-day">{{index === signInStatus.dailyRewards.length - 1 ? ('第' + (index + 1) + '天及以上') : ('第' + (index + 1) + '天')}}</text>
          <text class="rsv__sign-rule-points">+{{item}}</text>
          <text class="rsv__sign-rule-unit">积分</text>
        </view>
      </view>
      <text wx:else class="rsv__sign-dialog-loading">规则加载中…</text>

      <text class="rsv__sign-dialog-note">连续签到可获得更多积分，断签后从第 1 天重新计算</text>
      <button
        class="rsv__sign-dialog-button {{signInStatus.signedToday ? 'rsv__sign-dialog-button--done' : ''}}"
        loading="{{signInSubmitting}}"
        disabled="{{signInSubmitting || signInStatus.signedToday}}"
        bindtap="confirmSignIn"
      >{{signInStatus.signedToday ? '今日已签到' : '签到'}}</button>
    </view>
  </view>

  <view wx:if="{{showSignInReward}}" class="rsv__reward">
    <view class="rsv__reward-halo"></view>
    <view class="rsv__reward-panel">
      <view class="rsv__reward-check">✓</view>
      <text class="rsv__reward-title">签到成功</text>
      <text class="rsv__reward-points">+{{signInReward}} 积分</text>
      <text class="rsv__reward-streak">已连续签到 {{signInStreak}} 天</text>
    </view>
  </view>
</view>

<!-- 座位预约确认弹层 -->
<ic-bottom-sheet show="{{showConfirm}}" title="确认预约" max-height="78vh" bind:close="onCloseConfirm">
  <view class="rsvc">
    <view class="rsvc__row">
      <view class="ic-ic ic-ic-person ic-ic--sm"></view>
      <text class="rsvc__val">{{selected.tableName}} · 系统自动分配空闲座位</text>
    </view>
    <view class="ic-divider"></view>
    <view class="rsvc__row">
      <view class="ic-ic ic-ic-clock ic-ic--sm"></view>
      <text class="rsvc__val">营业时间：{{store.hours || '请咨询门店'}}</text>
    </view>
    <view class="ic-divider"></view>
    <view class="rsvc__row">
      <image class="rsv__ic" src="/assets/icons/location.svg" mode="aspectFit"></image>
      <text class="rsvc__val ic-ellipsis">{{store.name}}</text>
    </view>
    <view class="rsvc__hint">预约后座位将保持占用，如不再需要可在当前桌台点击取消预约</view>
    <view class="rsvc__waitlist" hover-class="rsv__field--hover" bindtap="onWaitlist">
      <text>改为排队等候</text>
      <view class="ic-arrow"></view>
    </view>
  </view>
  <view slot="footer" class="rsvc__footer">
    <button class="ic-btn ic-btn-ghost rsvc__btn" bindtap="onCloseConfirm">取消</button>
    <button class="ic-btn ic-btn-primary rsvc__btn" loading="{{submitting}}" disabled="{{submitting || !reservationAvailability.reservable}}" bindtap="onConfirm">确认预约</button>
  </view>
</ic-bottom-sheet>
