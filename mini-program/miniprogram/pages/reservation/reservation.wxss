/* bottom padding keeps the last table clear of the floating action + custom tabbar */
.rsv { padding: 0 24rpx; padding-bottom: calc(236rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }

/* ---- current store ---- */
.rsv__field--hover { opacity: 0.72; }
.rsv__store {
  min-height: 132rpx;
  margin: 0 -24rpx;
  padding: 20rpx 32rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  background: var(--ic-white);
  border-bottom: 1rpx solid var(--ic-line);
  box-sizing: border-box;
}
.rsv__store-icon {
  width: 58rpx;
  height: 58rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--ic-fill);
}
.rsv__ic { width: 34rpx; height: 34rpx; flex: none; display: block; }
.rsv__store-copy { flex: 1; min-width: 0; }
.rsv__store-name-line { display: flex; align-items: center; gap: 12rpx; min-width: 0; }
.rsv__store-name { min-width: 0; font-size: 30rpx; font-weight: 700; line-height: 1.25; color: var(--ic-black); }
.rsv__store-current {
  flex: none;
  padding: 3rpx 9rpx;
  border-radius: 6rpx;
  background: var(--ic-black);
  color: var(--ic-white);
  font-size: 17rpx;
  line-height: 1.35;
}
.rsv__store-meta { display: flex; align-items: center; gap: 20rpx; margin-top: 10rpx; min-width: 0; }
.rsv__store-address { flex: 1; min-width: 0; color: var(--ic-text-2); font-size: 20rpx; }
.rsv__store-hours { flex: 1; min-width: 0; display: flex; align-items: center; gap: 7rpx; color: var(--ic-text-2); font-size: 20rpx; }
.rsv__hours-icon { width: 24rpx; height: 24rpx; flex: none; display: block; }
.rsv__caret { width: 13rpx; height: 13rpx; flex: none; border-right: 2rpx solid var(--ic-text-3); border-bottom: 2rpx solid var(--ic-text-3); transform: rotate(-45deg); }

.rsv__sec { min-height: 96rpx; padding: 18rpx 8rpx 8rpx; display: flex; align-items: center; justify-content: space-between; gap: 24rpx; }
.rsv__mine-link { min-height: 88rpx; display: flex; align-items: center; gap: 10rpx; font-size: 22rpx; color: var(--ic-text-3); }
.rsv__mine-link .ic-arrow { margin-left: 0; width: 12rpx; height: 12rpx; border-width: 2rpx; }

/* ---- fixed table summary ---- */
.rsv__table { margin-bottom: 20rpx; padding: 28rpx 30rpx 30rpx; }
.rsv__thead { display: flex; align-items: center; }
.rsv__table-title { display: flex; align-items: baseline; gap: 26rpx; min-width: 0; }
.rsv__tname { font-size: 28rpx; font-weight: 700; color: var(--ic-black); }
.rsv__tseats { font-size: 22rpx; color: var(--ic-text-2); }
.rsv__seat-line { display: flex; align-items: center; gap: 18rpx; margin-top: 26rpx; }
.rsv__reserve {
  flex: 0 0 112rpx;
  width: 112rpx !important;
  min-width: 112rpx;
  max-width: 112rpx;
  height: 60rpx;
  margin-left: 0 !important;
  margin-right: 0 !important;
  padding: 0 12rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  background: var(--ic-black);
  color: var(--ic-white);
  font-size: 21rpx;
  font-weight: 600;
  line-height: 1;
}
.rsv__reserve::after { border: 0; }
.rsv__reserve--cancel { background: var(--ic-white); color: var(--ic-black); box-shadow: inset 0 0 0 2rpx var(--ic-black); }
.rsv__reserve--disabled { background: var(--ic-fill); color: var(--ic-text-4); }
.rsv__seat-row { flex: 1; min-width: 0; display: flex; flex-wrap: nowrap; justify-content: flex-start; gap: 6rpx; }
.rsv__seat {
  position: relative;
  width: 38rpx;
  height: 38rpx;
  flex: none;
  overflow: visible;
  border-radius: 50%;
  box-sizing: border-box;
  background: #ededed;
  border: 1rpx solid #dcdcdc;
}
.rsv__seat--reserved { background: #353535; border-color: #353535; }
.rsv__seat--selected { background: var(--ic-black); border-color: var(--ic-black); box-shadow: 0 0 0 5rpx rgba(17, 17, 17, 0.12); }
.rsv__seat--mine { box-shadow: 0 0 0 3rpx var(--ic-white), 0 0 0 5rpx var(--ic-black); }
.rsv__seat-avatar { width: 100%; height: 100%; display: block; border-radius: 50%; }
.rsv__seat-avatar--brand { box-sizing: border-box; padding: 9rpx 4rpx; background: var(--ic-white); }
.rsv__seat-initial { display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; color: var(--ic-white); font-size: 16rpx; font-weight: 700; }
.rsv__seat-gender {
  position: absolute;
  right: -4rpx;
  bottom: -4rpx;
  width: 18rpx;
  height: 18rpx;
  padding: 2rpx;
  border-radius: 50%;
  background: var(--ic-white);
  box-shadow: 0 0 0 2rpx var(--ic-white);
  box-sizing: border-box;
}

/* ---- floating waitlist action ---- */
.rsv__waitbar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(120rpx + env(safe-area-inset-bottom));
  z-index: 40;
}
.rsv__waitbtn {
  width: 100% !important;
  margin-left: 0 !important;
  margin-right: 0 !important;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  height: 84rpx;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.14);
}

/* ---- confirm sheet body ---- */
.rsvc__row { display: flex; align-items: center; gap: 18rpx; padding: 20rpx 4rpx; }
.rsvc__val { font-size: 26rpx; color: var(--ic-black); min-width: 0; }
.rsvc__hint { margin-top: 18rpx; padding: 20rpx 24rpx; background: var(--ic-fill); border-radius: 14rpx; font-size: 22rpx; color: var(--ic-text-2); }
.rsvc__waitlist { display: flex; align-items: center; justify-content: center; gap: 8rpx; padding: 24rpx 0 4rpx; font-size: 22rpx; color: var(--ic-text-2); }
/* keep footer clear of the custom tabbar (100rpx) + safe area */
.rsvc__footer { display: flex; gap: 20rpx; margin-bottom: 100rpx; }
/* stable equal widths; override WeChat button default side margins, center text */
.rsvc__btn { flex: 1; margin-left: 0 !important; margin-right: 0 !important; width: auto; box-sizing: border-box; display: flex; align-items: center; justify-content: center; text-align: center; }
