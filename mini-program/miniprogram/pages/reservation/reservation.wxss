/* bottom padding keeps the last table clear of the floating action + custom tabbar */
.rsv-shell { position: relative; z-index: 1; height: 100vh; display: flex; flex-direction: column; overflow: hidden; }
.rsv__scroll { flex: 1; min-height: 0; }
.rsv { position: relative; z-index: 1; padding: 0 24rpx; padding-bottom: calc(236rpx + env(safe-area-inset-bottom)); box-sizing: border-box; background: transparent; }

.rsv__field--hover { opacity: 0.72; }
.rsv__ic { width: 34rpx; height: 34rpx; flex: none; display: block; }

.rsv__sec { min-height: 96rpx; padding: 24rpx 8rpx 8rpx; display: flex; align-items: center; gap: 24rpx; }
.rsv__sec .ic-h2 { color: rgba(255, 255, 255, 0.94); }

/* ---- daily sign-in ---- */
.rsv__sign-in {
  flex: none;
  width: 216rpx !important;
  min-width: 216rpx;
  max-width: 216rpx;
  height: 68rpx;
  margin-top: 0 !important;
  margin-right: 0 !important;
  margin-bottom: 0 !important;
  margin-left: auto !important;
  padding: 0 20rpx !important;
  border-radius: 34rpx;
  color: rgba(255, 255, 255, 0.94);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  font-size: 20rpx !important;
  font-weight: 600;
  line-height: 1 !important;
}
.rsv__sign-in::after { border: 0; }
.rsv__sign-in-icon { top: 14rpx; flex: none; color: currentColor; transform: scale(0.82); }
.rsv__sign-in-label { position: relative; top: 4rpx; z-index: 1; white-space: nowrap; }
.rsv__sign-in-dot {
  position: absolute;
  top: 6rpx;
  right: 8rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 0 0 3rpx rgba(20, 24, 30, 0.72);
}
.rsv__sign-in-badge {
  position: absolute;
  top: 3rpx;
  right: 5rpx;
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.94);
  color: var(--ic-black);
  font-size: 16rpx;
  font-weight: 700;
  line-height: 22rpx;
  text-align: center;
  box-shadow: 0 0 0 3rpx rgba(20, 24, 30, 0.72);
}
.rsv__sign-in--loading { opacity: 0.62; }
.rsv__sign-in--hover { opacity: 0.78; transform: scale(0.98); }

.rsv__sign-dialog {
  position: fixed;
  inset: 0;
  z-index: 80;
  box-sizing: border-box;
  padding: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.38);
  animation: rsv-sign-dialog-backdrop 0.2s ease-out both;
}
.rsv__sign-dialog-panel {
  width: 100%;
  max-width: 686rpx;
  box-sizing: border-box;
  padding: 28rpx 32rpx 32rpx;
  border-radius: 24rpx;
  background: var(--ic-white);
  color: var(--ic-text);
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.16);
  animation: rsv-sign-dialog-enter 0.28s cubic-bezier(0.22, 1, 0.36, 1) both;
}
.rsv__sign-dialog-head {
  height: 76rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid var(--ic-line);
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.rsv__sign-dialog-title {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ic-black);
}
.rsv__sign-dialog-title .ic-ic { color: currentColor; }
.rsv__sign-dialog-close {
  width: 72rpx;
  height: 72rpx;
  margin-right: -18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 300;
  line-height: 1;
  color: var(--ic-text-3);
}
.rsv__sign-dialog-close--hover { opacity: 0.55; }
.rsv__sign-rules {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 32rpx;
}
.rsv__sign-rule {
  width: calc((100% - 24rpx) / 3);
  height: 136rpx;
  box-sizing: border-box;
  border-radius: 14rpx;
  background: var(--ic-fill-2);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.rsv__sign-rule--earned { background: var(--ic-fill); }
.rsv__sign-rule--current {
  background: var(--ic-white);
  box-shadow: inset 0 0 0 2rpx var(--ic-black);
}
.rsv__sign-rule-day {
  font-size: 20rpx;
  line-height: 1.2;
  color: var(--ic-text-3);
  white-space: nowrap;
}
.rsv__sign-rule-points {
  margin-top: 12rpx;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1;
  color: var(--ic-text-2);
  font-variant-numeric: tabular-nums;
}
.rsv__sign-rule--earned .rsv__sign-rule-points,
.rsv__sign-rule--current .rsv__sign-rule-points { color: var(--ic-black); }
.rsv__sign-rule-unit { margin-top: 6rpx; font-size: 20rpx; line-height: 1; color: var(--ic-text-3); }
.rsv__sign-dialog-loading {
  display: block;
  padding: 90rpx 0;
  text-align: center;
  font-size: 22rpx;
  color: var(--ic-text-3);
}
.rsv__sign-dialog-note {
  display: block;
  margin-top: 24rpx;
  text-align: center;
  font-size: 20rpx;
  line-height: 1.5;
  color: var(--ic-text-3);
}
.rsv__sign-dialog-button {
  width: 100% !important;
  height: 88rpx;
  margin: 28rpx 0 0 !important;
  padding: 0;
  border-radius: 8rpx;
  background: var(--ic-black);
  color: var(--ic-white);
  font-size: 26rpx;
  font-weight: 700;
  line-height: 88rpx;
}
.rsv__sign-dialog-button::after { border: none; }
.rsv__sign-dialog-button--done { background: var(--ic-fill); color: var(--ic-text-3); }
@keyframes rsv-sign-dialog-enter {
  from { opacity: 0; transform: translateY(20rpx) scale(0.97); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}
@keyframes rsv-sign-dialog-backdrop {
  from { opacity: 0; }
  to { opacity: 1; }
}

.rsv__reward {
  position: fixed;
  inset: 0;
  z-index: 90;
  pointer-events: none;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.16);
  animation: rsv-reward-backdrop 1.6s ease-out both;
}
.rsv__reward-panel {
  position: relative;
  z-index: 1;
  width: 300rpx;
  padding: 38rpx 28rpx 34rpx;
  box-sizing: border-box;
  border-radius: 20rpx;
  background: var(--ic-white);
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 20rpx 50rpx rgba(0, 0, 0, 0.22);
  animation: rsv-reward-rise 0.48s cubic-bezier(0.22, 1, 0.36, 1) both;
}
.rsv__reward-check {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--ic-black);
  color: var(--ic-white);
  font-size: 28rpx;
  line-height: 72rpx;
  text-align: center;
}
.rsv__reward-title { margin-top: 20rpx; font-size: 24rpx; font-weight: 600; color: var(--ic-black); }
.rsv__reward-points { margin-top: 4rpx; font-size: 30rpx; font-weight: 700; color: var(--ic-black); font-variant-numeric: tabular-nums; }
.rsv__reward-streak { margin-top: 8rpx; font-size: 20rpx; color: var(--ic-text-3); }
.rsv__reward-halo {
  position: absolute;
  width: 210rpx;
  height: 210rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 50%;
  animation: rsv-reward-halo 0.72s ease-out both;
}
@keyframes rsv-reward-rise {
  from { opacity: 0; transform: translateY(30rpx) scale(0.9); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}
@keyframes rsv-reward-halo {
  from { opacity: 0.85; transform: scale(0.6); }
  to { opacity: 0; transform: scale(2); }
}
@keyframes rsv-reward-backdrop {
  0% { opacity: 0; }
  15%, 78% { opacity: 1; }
  100% { opacity: 0; }
}
@media (prefers-reduced-motion: reduce) {
  .rsv__sign-dialog,
  .rsv__sign-dialog-panel,
  .rsv__reward,
  .rsv__reward-panel,
  .rsv__reward-halo { animation-duration: 0.01ms; }
}

/* ---- fixed table summary ---- */
.rsv__table {
  position: relative;
  margin-bottom: 20rpx;
  padding: 28rpx 30rpx 30rpx;
}
.rsv__thead { display: flex; align-items: center; }
.rsv__table-title { display: flex; align-items: baseline; gap: 26rpx; min-width: 0; }
.rsv__tname { font-size: 28rpx; font-weight: 700; color: rgba(255, 255, 255, 0.94); }
.rsv__tseats { font-size: 22rpx; color: rgba(255, 255, 255, 0.58); }
.rsv__seat-line { display: flex; align-items: center; gap: 18rpx; margin-top: 26rpx; }
.rsv__reserve {
  flex: 0 0 112rpx;
  width: 112rpx !important;
  min-width: 112rpx;
  max-width: 112rpx;
  height: 60rpx;
  margin-left: 0 !important;
  margin-right: 0 !important;
  padding: 0 12rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  background: var(--ic-black);
  color: var(--ic-white);
  font-size: 21rpx;
  font-weight: 600;
  line-height: 1;
}
.rsv__reserve::after { border: 0; }
.rsv__reserve--cancel { background: var(--ic-white); color: var(--ic-black); box-shadow: inset 0 0 0 2rpx var(--ic-black); }
.rsv__reserve--disabled { background: var(--ic-fill); color: var(--ic-text-4); }
.rsv__seat-row { flex: 1; min-width: 0; display: flex; flex-wrap: nowrap; justify-content: flex-start; gap: 6rpx; }
.rsv__seat {
  position: relative;
  width: 38rpx;
  height: 38rpx;
  flex: none;
  overflow: visible;
  border-radius: 50%;
  box-sizing: border-box;
  background: #ededed;
  border: 1rpx solid #dcdcdc;
}
.rsv__seat--reserved { background: #353535; border-color: #353535; }
.rsv__seat--selected { background: var(--ic-black); border-color: var(--ic-black); box-shadow: 0 0 0 5rpx rgba(17, 17, 17, 0.12); }
.rsv__seat--mine { box-shadow: 0 0 0 3rpx var(--ic-white), 0 0 0 5rpx var(--ic-black); }
.rsv__seat-avatar { width: 100%; height: 100%; display: block; border-radius: 50%; }
.rsv__seat-avatar--brand { box-sizing: border-box; padding: 9rpx 4rpx; background: var(--ic-white); }
.rsv__seat-initial { display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; color: var(--ic-white); font-size: 16rpx; font-weight: 700; }
.rsv__seat-gender {
  position: absolute;
  right: -4rpx;
  bottom: -4rpx;
  width: 18rpx;
  height: 18rpx;
  padding: 2rpx;
  border-radius: 50%;
  background: var(--ic-white);
  box-shadow: 0 0 0 2rpx var(--ic-white);
  box-sizing: border-box;
}

/* ---- floating waitlist action ---- */
.rsv__waitbar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(120rpx + env(safe-area-inset-bottom));
  z-index: 40;
  height: 88rpx;
  overflow: hidden;
  border-radius: 32rpx;
}
.rsv__waitbtn {
  position: relative;
  width: 100% !important;
  height: 100%;
  margin-left: 0 !important;
  margin-right: 0 !important;
  padding: 0 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  box-sizing: border-box;
  border: 0;
  border-radius: 32rpx;
  background: transparent;
  color: rgba(255, 255, 255, 0.94);
  font-size: 26rpx;
  font-weight: 650;
  overflow: hidden;
}
.rsv__waitbtn::after { border: 0; }
.rsv__waitbtn[disabled] { opacity: 0.68; }
.rsv__wait-avatars {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: stretch;
  overflow: hidden;
}
.rsv__wait-avatar {
  flex: 0 0 94rpx;
  width: 94rpx;
  height: 100%;
  display: block;
  opacity: 0.66;
}
.rsv__wait-avatar--fallback {
  box-sizing: border-box;
  padding: 24rpx 14rpx;
  background: rgba(255, 255, 255, 0.9);
}
.rsv__wait-shade {
  position: absolute;
  inset: 0;
  background: rgba(20, 24, 30, 0.52);
}
.rsv__wait-content {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
}
.rsv__wait-arrow { width: 13rpx; height: 13rpx; transform: rotate(45deg); border-top: 2rpx solid rgba(255, 255, 255, 0.7); border-right: 2rpx solid rgba(255, 255, 255, 0.7); }

/* ---- confirm sheet body ---- */
.rsvc__row { display: flex; align-items: center; gap: 18rpx; padding: 20rpx 4rpx; }
.rsvc__val { font-size: 26rpx; color: var(--ic-black); min-width: 0; }
.rsvc__hint { margin-top: 18rpx; padding: 20rpx 24rpx; background: var(--ic-fill); border-radius: 14rpx; font-size: 22rpx; color: var(--ic-text-2); }
.rsvc__waitlist { display: flex; align-items: center; justify-content: center; gap: 8rpx; padding: 24rpx 0 4rpx; font-size: 22rpx; color: var(--ic-text-2); }
/* keep footer clear of the custom tabbar (100rpx) + safe area */
.rsvc__footer { display: flex; gap: 20rpx; margin-bottom: 100rpx; }
/* stable equal widths; override WeChat button default side margins, center text */
.rsvc__btn { flex: 1; margin-left: 0 !important; margin-right: 0 !important; width: auto; box-sizing: border-box; display: flex; align-items: center; justify-content: center; text-align: center; }
