/* bottom padding keeps last content clear of the custom tabbar */
.rsv { padding: 24rpx; padding-bottom: calc(180rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }

/* ---- selectors ---- */
.rsv__field {
  display: flex; align-items: center; gap: 16rpx;
  height: 96rpx; padding: 0 28rpx; margin-bottom: 20rpx;
  background: var(--ic-white); border-radius: 18rpx;
}
.rsv__field--hover { opacity: 0.7; }
/* location icon — same box as clock/person icons (ic-ic--sm = 36rpx) */
.rsv__ic { width: 36rpx; height: 36rpx; flex: none; display: block; }
.rsv__field-text { flex: 1; min-width: 0; font-size: 30rpx; color: var(--ic-black); }
.rsv__caret { width: 16rpx; height: 16rpx; border-right: 3rpx solid var(--ic-text-3); border-bottom: 3rpx solid var(--ic-text-3); transform: rotate(45deg); margin-top: -6rpx; }

/* ---- legend ---- */
.rsv__legend { display: flex; gap: 44rpx; padding: 8rpx 12rpx 4rpx; }
.rsv__legend-item { display: flex; align-items: center; gap: 12rpx; }
.rsv__legend-text { font-size: 24rpx; color: var(--ic-text-2); }

.rsv__sec { padding: 32rpx 8rpx 20rpx; }

/* ---- table card ---- */
.rsv__table { margin-bottom: 24rpx; padding: 28rpx; }
.rsv__thead { display: flex; align-items: center; gap: 18rpx; }
.rsv__tname { font-size: 34rpx; font-weight: 700; color: var(--ic-black); }
.rsv__ttype { font-size: 24rpx; color: var(--ic-text-3); }
.rsv__tseats { font-size: 24rpx; color: var(--ic-text-2); }
.rsv__tupdated { flex: 1; text-align: right; font-size: 22rpx; color: var(--ic-text-4); }
.rsv__tmore { flex: 1; text-align: right; font-size: 24rpx; color: var(--ic-text-2); }
.rsv__tcaret { width: 16rpx; height: 16rpx; border-right: 3rpx solid var(--ic-text-3); border-bottom: 3rpx solid var(--ic-text-3); transform: rotate(45deg); transition: transform 0.2s; }
.rsv__tcaret.is-open { transform: rotate(-135deg); }

/* ---- compact dot summary ---- */
.rsv__dots { display: flex; gap: 14rpx; margin-top: 24rpx; }

/* ---- seat dots (legend + collapsed) ---- */
.rseat__dot { width: 26rpx; height: 26rpx; border-radius: 50%; box-sizing: border-box; }
.rseat__dot--free { background: #ececec; border: 1rpx solid #d8d8d8; }
.rseat__dot--reserved { background: #3a3a3a; }
.rseat__dot--selected { background: #111; box-shadow: 0 0 0 4rpx rgba(0, 0, 0, 0.12); }

/* ---- poker table ---- */
.rtable { position: relative; height: 520rpx; margin: 30rpx 8rpx 12rpx; }
.rtable__felt {
  position: absolute; top: 60rpx; left: 48rpx; right: 48rpx; bottom: 60rpx;
  border-radius: 240rpx;
  background: radial-gradient(120% 120% at 50% 40%, #2f5d40 0%, #1f4530 70%, #143020 100%);
  border: 14rpx solid #2a2724;
  box-shadow: inset 0 0 40rpx rgba(0, 0, 0, 0.45);
  display: flex; flex-direction: column; align-items: center; justify-content: center;
}
.rtable__suits { display: flex; gap: 18rpx; color: rgba(255, 255, 255, 0.28); font-size: 30rpx; }
.rtable__brand { margin-top: 12rpx; font-size: 24rpx; letter-spacing: 4rpx; color: rgba(255, 255, 255, 0.4); }

.rseat { position: absolute; transform: translate(-50%, -50%); display: flex; flex-direction: column; align-items: center; }
.rseat__circle {
  width: 76rpx; height: 76rpx; border-radius: 50%; box-sizing: border-box;
  display: flex; align-items: center; justify-content: center;
  font-size: 30rpx; font-weight: 700;
  position: relative; overflow: visible;
}
.rseat__label { margin-top: 8rpx; font-size: 22rpx; color: var(--ic-text-3); white-space: nowrap; max-width: 120rpx; overflow: hidden; text-overflow: ellipsis; }

/* reserved seat: avatar + gender badge inside the circle */
.rseat__avatar { width: 100%; height: 100%; border-radius: 50%; display: block; }
.rseat__initial { font-size: 28rpx; font-weight: 700; line-height: 1; }
.rseat__gender {
  position: absolute; right: -6rpx; bottom: -6rpx;
  width: 28rpx; height: 28rpx; border-radius: 50%;
  background: #fff; box-sizing: border-box; padding: 3rpx;
  box-shadow: 0 0 0 2rpx #fff;
}

.rseat--free .rseat__circle { background: #fff; border: 2rpx solid #d8d8d8; color: #111; }
.rseat--reserved .rseat__circle { background: #3a3a3a; color: #fff; }
.rseat--reserved .rseat__label { color: var(--ic-text-4); }
.rseat--selected .rseat__circle { background: #111; color: #fff; box-shadow: 0 0 0 6rpx rgba(0, 0, 0, 0.12); }
.rseat--selected .rseat__label { color: var(--ic-black); font-weight: 600; }

/* ---- bottom actions ---- */
.rsv__actions { margin-top: 12rpx; }
/* full-width waitlist button; override WeChat button default side margins */
.rsv__waitbtn {
  width: 100% !important;
  margin-left: 0 !important;
  margin-right: 0 !important;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  height: 96rpx;
}
.rsv__mine { display: flex; align-items: center; gap: 16rpx; height: 96rpx; padding: 0 28rpx; margin-top: 20rpx; }
.rsv__mine-text { flex: 1; font-size: 30rpx; color: var(--ic-black); }

/* ---- confirm sheet body ---- */
.rsvc__row { display: flex; align-items: center; gap: 18rpx; padding: 20rpx 4rpx; }
.rsvc__val { font-size: 30rpx; color: var(--ic-black); min-width: 0; }
.rsvc__hint { margin-top: 18rpx; padding: 20rpx 24rpx; background: var(--ic-fill); border-radius: 14rpx; font-size: 24rpx; color: var(--ic-text-2); }
.rsvc__waitlist { display: flex; align-items: center; justify-content: center; gap: 8rpx; padding: 24rpx 0 4rpx; font-size: 24rpx; color: var(--ic-text-2); }
/* keep footer clear of the custom tabbar (100rpx) + safe area */
.rsvc__footer { display: flex; gap: 20rpx; margin-bottom: 100rpx; }
/* stable equal widths; override WeChat button default side margins, center text */
.rsvc__btn { flex: 1; margin-left: 0 !important; margin-right: 0 !important; width: auto; box-sizing: border-box; display: flex; align-items: center; justify-content: center; text-align: center; }
