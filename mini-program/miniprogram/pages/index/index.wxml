<ic-app-background />
<view class="ic-scroll-shell home">
  <view wx:if="{{currentActivityImage}}" class="home__ambient" aria-hidden="true">
    <image class="home__ambient-image" src="{{currentActivityImage}}" mode="aspectFill" />
    <view class="home__ambient-wash"></view>
  </view>

  <!-- Custom navigation: white brand bar aligned to the WeChat capsule -->
  <view class="home__nav" style="padding-top: {{navStatusBar}}px;">
    <view class="home__nav-bar" style="height: {{navContentHeight}}px; padding-left: {{navRightGap}}px; padding-right: {{navRightGap}}px;">
      <view
        class="home__nav-store"
        aria-label="切换门店 {{store ? store.name : '请选择门店'}}{{store ? (storeDistanceText === '位置未配置' ? '，位置未配置' : (storeDistanceText ? ('，距离' + storeDistanceText) : '，距离未知')) : ''}}"
        aria-role="button"
        hover-class="home__nav-store--hover"
        bindtap="switchStore"
      >
        <view class="home__nav-store-copy">
          <text class="home__nav-store-name ic-ellipsis">{{store ? store.name : '选择门店'}}</text>
          <text wx:if="{{store}}" class="home__nav-store-distance">· {{storeDistanceText}}</text>
        </view>
        <view class="ic-arrow home__nav-store-arrow"></view>
      </view>
      <image class="home__nav-logo" src="https://assets.inwardclub.com/public/images/inward-logo-optimized.gif?imageMogr2/format/png" mode="heightFix" />
    </view>
  </view>

  <scroll-view
    class="home__scroll ic-scroll-view"
    scroll-y="{{!showSignInSheet}}"
    enhanced
    show-scrollbar="{{false}}"
    bounces="{{false}}"
  >
  <view class="home__scroll-content">
  <!-- Activity hero: the former advertising Banner API is intentionally disabled. -->
  <view class="home__banner-stage">
    <swiper
      wx:if="{{activities.length}}"
      class="home__banner"
      autoplay="{{activities.length > 1}}"
      circular="{{activities.length > 1}}"
      interval="5000"
      duration="350"
      indicator-dots="{{activities.length > 1}}"
      indicator-color="rgba(255,255,255,0.45)"
      indicator-active-color="#ffffff"
      bindchange="onBannerChange"
    >
      <swiper-item wx:for="{{activities}}" wx:key="id">
        <view class="home__banner-item" data-id="{{item.id}}" bindtap="goActivity">
          <image
            wx:if="{{item.imageUrl}}"
            class="home__banner-img"
            src="{{item.imageUrl}}"
            mode="aspectFill"
            data-index="{{index}}"
            bindload="onBannerImageLoad"
          />
          <view wx:if="{{!item.imageUrl || !item.imageLoaded}}" class="home__banner-loading">
            <ic-loading theme="dark" fullscreen="{{false}}" />
          </view>
        </view>
      </swiper-item>
    </swiper>
    <view wx:else class="home__banner home__banner-empty">
      <view class="home__banner-loading">
        <ic-loading theme="dark" fullscreen="{{false}}" />
      </view>
    </view>
    <view class="home__banner-info">
      <view class="home__banner-info-head">
        <view
          class="home__banner-all"
          aria-label="查看全部活动"
          aria-role="button"
          hover-class="home__banner-all--hover"
          bindtap="goActivityList"
        >
          <text>全部活动</text>
          <view class="ic-arrow home__banner-all-arrow"></view>
        </view>
      </view>
    </view>
  </view>

  <view class="home__glass-zone">
    <view class="home__feature-wall">
      <image
        class="home__feature-gif"
        src="https://assets.inwardclub.com/public/images/inward-logo-optimized.gif"
        mode="aspectFill"
      />

    <!-- Flat member information: identity stays quiet so the activity hero remains primary. -->
    <view class="home__card">
      <view class="home__card-top {{loggedIn ? '' : 'home__card-top--guest'}}">
        <view class="home__avatar {{loggedIn ? '' : 'home__avatar--guest'}}">
          <image wx:if="{{loggedIn && me.avatarUrl}}" class="home__avatar-img" src="{{me.avatarUrl}}" mode="aspectFill" />
          <image wx:else class="home__avatar-logo" src="https://assets.inwardclub.com/public/images/inward-logo-optimized.gif?imageMogr2/format/png" mode="aspectFit" />
        </view>

        <!-- Logged-in: identity and tier are one branch; the guest branch is mutually exclusive. -->
        <block wx:if="{{loggedIn}}">
          <view class="home__ident">
            <view class="home__member-name-line">
              <text class="home__member-greeting">Hi,</text>
              <text class="home__member-name ic-ellipsis">{{me.nickname || '会员'}}</text>
            </view>
            <!-- <text wx:if="{{me.memberNo}}" class="home__no">NO.{{me.memberNo}}</text> -->
          </view>
          <view class="home__vip">
            <text class="home__vip-mark">◇</text>
            <text class="home__vip-name ic-ellipsis">{{me.tierName || '普卡'}}</text>
            <view class="ic-arrow home__vip-arrow"></view>
          </view>
        </block>

        <!-- Guest: no fake data, offer a login entry -->
        <view wx:else class="home__ident home__ident--guest">
          <view class="home__guest-text">
            <text class="home__hello">欢迎来到</text>
            <text class="home__name">Inward Club</text>
          </view>
          <view class="home__login" hover-class="home__login--hover" bindtap="onLogin">登录</view>
        </view>
      </view>
    </view>

    <view
      class="home__franchise"
      aria-label="了解城市合伙人招募详情"
      aria-role="button"
      hover-class="home__franchise--hover"
      bindtap="goFranchiseInquiry"
    >
      <text class="home__franchise-title">城市合伙人招募中</text>
      <text class="home__franchise-action">了解详情</text>
    </view>

    <!-- Current store: real store name, address and location-derived distance. -->
    <view wx:if="{{store}}" class="home__store-section">
      <view
        class="home__store-panel"
        aria-label="当前门店 {{store.name}}，{{store.address || '暂未填写地址'}}，距离 {{storeDistanceText}}，点击打开地图导航"
        aria-role="button"
        hover-class="home__store-panel--hover"
        bindtap="navigateStore"
      >
        <image class="home__store-panel-map" src="/assets/illustrations/store-map-lines.svg" mode="aspectFill" />
        <view class="home__store-panel-copy">
          <text class="home__store-panel-name ic-ellipsis">{{store.name}}</text>
          <text class="home__store-panel-address ic-ellipsis">{{store.address || '门店暂未填写地址'}}</text>
        </view>
        <view class="home__store-panel-location">
          <image class="home__store-panel-icon" src="/assets/icons/location.svg" mode="aspectFit" />
          <text class="home__store-panel-distance">{{storeDistanceText || '距离未知'}}</text>
        </view>
      </view>
    </view>
    </view>
  </view>
  </view>
  </scroll-view>

</view>
