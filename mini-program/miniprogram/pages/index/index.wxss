.home {
  background: var(--ic-white);
}

/* ---- custom navigation ---- */
.home__nav {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  z-index: 20;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0.36) 0%, rgba(0, 0, 0, 0) 100%);
}
/* Logo remains optically centered while the current store occupies the left safe area. */
.home__nav-bar { position: relative; display: flex; align-items: center; justify-content: center; box-sizing: border-box; }
.home__nav-store {
  position: absolute;
  left: 24rpx;
  top: 50%;
  max-width: 250rpx;
  min-height: 60rpx;
  padding: 0 14rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  transform: translateY(-50%);
  color: var(--ic-white);
  background: rgba(9, 9, 10, 0.66);
  border-radius: 10rpx;
  box-sizing: border-box;
}
.home__nav-store--hover { opacity: 0.68; }
.home__nav-store-copy { display: flex; align-items: center; gap: 8rpx; min-width: 0; white-space: nowrap; }
.home__nav-store-name { display: block; min-width: 0; max-width: 136rpx; font-size: 24rpx; font-weight: 650; line-height: 1.2; }
.home__nav-store-distance { display: block; flex: none; font-size: 20rpx; font-weight: 500; line-height: 1.2; color: rgba(255, 255, 255, 0.9); }
.home__nav-store-arrow { flex: none; width: 9rpx; height: 9rpx; margin-left: 0; border-color: currentColor; transform: rotate(45deg); }
.home__nav-logo {
  height: 52rpx;
  width: auto;
  display: block;
  filter: brightness(0) invert(1) drop-shadow(0 2rpx 6rpx rgba(0, 0, 0, 0.35));
  opacity: 0.96;
}

/* ---- banner ---- */
.home__banner {
  width: 100%;
  height: 820rpx;
  margin: 0;
  border-radius: 0 0 16rpx 16rpx;
  overflow: hidden;
  background: #17161a;
}
.home__banner-item { position: relative; width: 100%; height: 100%; }
.home__banner-img {
  width: 100%;
  height: 100%;
  display: block;
  object-position: center top;
}
.home__banner-ph {
  width: 100%; height: 100%;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  background: linear-gradient(155deg, #3a3630 0%, #17161a 60%, #0c0b0d 100%);
}
.home__banner-title { color: #f4efe6; font-size: 30rpx; font-weight: 700; letter-spacing: 6rpx; }
.home__banner-sub { margin-top: 16rpx; color: rgba(244, 239, 230, 0.55); font-size: 20rpx; letter-spacing: 6rpx; }
.home__banner-info {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  box-sizing: border-box;
  min-height: 176rpx;
  padding: 58rpx 32rpx 46rpx;
  background: linear-gradient(180deg, rgba(9, 9, 10, 0) 0%, rgba(9, 9, 10, 0.82) 58%, rgba(9, 9, 10, 0.94) 100%);
  color: var(--ic-white);
}
.home__banner-info-head {
  display: flex;
  align-items: center;
  gap: 24rpx;
  min-width: 0;
}
.home__banner-activity-title {
  display: block;
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.25;
  color: var(--ic-white);
}
.home__banner-all {
  flex: none;
  min-width: 132rpx;
  height: 56rpx;
  padding: 0 18rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.94);
  color: var(--ic-black);
  font-size: 20rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}
.home__banner-all--hover { opacity: 0.76; }
.home__banner-all-arrow {
  width: 10rpx;
  height: 10rpx;
  border-color: currentColor;
}
.home__banner-meta {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-width: 0;
  margin-top: 10rpx;
  padding-right: 120rpx;
  font-size: 20rpx;
  line-height: 1.4;
  color: rgba(255, 255, 255, 0.78);
}
.home__banner-store { flex: none; max-width: 190rpx; }
.home__banner-time { flex: 1; min-width: 0; }

/* ---- franchise and member information ---- */
.home__feature-wall {
  position: relative;
  overflow: hidden;
  padding-top: 40rpx;
  background: var(--ic-white);
}

/* ---- member card ---- */
.home__card { position: relative; z-index: 2; box-sizing: border-box; min-height: 142rpx; margin: 20rpx 24rpx 24rpx; padding: 22rpx 24rpx 28rpx; border-radius: 16rpx; background: rgba(255, 255, 255, 0.86); }
.home__card-top { position: relative; z-index: 1; display: flex; align-items: center; }
.home__card-top--guest { align-items: center; }
.home__avatar {
  width: 88rpx; height: 88rpx; border-radius: 50%; background: #111; flex: none;
  display: flex; align-items: center; justify-content: center; overflow: hidden;
  box-shadow: 0 0 0 1rpx var(--ic-line-strong);
}
.home__avatar--guest { width: 88rpx; height: 88rpx; }
.home__avatar-img { width: 100%; height: 100%; }
.home__avatar-logo { width: 100%; height: 100%; box-sizing: border-box; padding: 0 16rpx; background: #fff; }
.home__ident { flex: 1; min-width: 0; margin-left: 22rpx; }
.home__ident--guest { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.home__guest-text { min-width: 0; }
.home__member-name-line { display: flex; align-items: baseline; min-width: 0; }
.home__member-greeting { flex: none; font-size: 28rpx; font-weight: 700; line-height: 1.2; color: var(--ic-black); }
.home__member-name { min-width: 0; font-size: 28rpx; font-weight: 700; line-height: 1.2; color: var(--ic-black); }
.home__hello { display: block; font-size: 20rpx; color: var(--ic-text-3); }
.home__name { display: block; margin-top: 2rpx; font-size: 26rpx; font-weight: 700; line-height: 1.2; color: var(--ic-black); }
.home__no { display: block; margin-top: 6rpx; font-size: 20rpx; line-height: 1.2; color: var(--ic-text-3); white-space: nowrap; }
.home__vip { display: inline-flex; align-items: center; gap: 8rpx; min-width: 0; max-width: 180rpx; height: 52rpx; margin-left: 20rpx; padding: 0 18rpx; border-radius: 26rpx; background: var(--ic-black); color: var(--ic-white); box-sizing: border-box; }
.home__vip-mark { flex: none; font-size: 20rpx; line-height: 1; color: currentColor; }
.home__vip-name { min-width: 0; font-size: 20rpx; font-weight: 600; color: currentColor; }
.home__vip-arrow { width: 9rpx; height: 9rpx; border-color: currentColor; }
.home__login {
  display: inline-flex; align-items: center; justify-content: center;
  height: 52rpx; padding: 0 32rpx; border-radius: 26rpx;
  background: var(--ic-black); color: var(--ic-white); font-size: 22rpx; font-weight: 600;
}
.home__login--hover { opacity: 0.7; }

/* ---- current store address ---- */
.home__store-section {
  margin: 24rpx 24rpx 0;
}
.home__store-section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 40rpx;
  margin-bottom: 12rpx;
}
.home__store-section-title {
  font-size: 26rpx;
  font-weight: 400;
  line-height: 1.3;
  color: var(--ic-text-3);
}
.home__store-panel {
  position: relative;
  min-height: 148rpx;
  padding: 24rpx 26rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  overflow: hidden;
  background: #f2f3f4;
  color: var(--ic-black);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 28rpx;
}
.home__store-panel--hover { opacity: 0.86; }
.home__store-panel-map {
  position: absolute;
  top: 0;
  right: 0;
  width: 58%;
  height: 100%;
  opacity: 0.72;
}
.home__store-panel-copy {
  position: relative;
  z-index: 1;
  flex: 1;
  min-width: 0;
}
.home__store-panel-name {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.25;
  color: var(--ic-black);
}
.home__store-panel-address {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 1.45;
  color: var(--ic-text-2);
}
.home__store-panel-location {
  position: relative;
  z-index: 1;
  width: 140rpx;
  flex: none;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.home__store-panel-icon {
  width: 48rpx;
  height: 48rpx;
}
.home__store-panel-distance {
  display: block;
  max-width: 150rpx;
  margin-top: 6rpx;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.2;
  color: var(--ic-black);
  white-space: nowrap;
}

/* ---- global franchise inquiry ---- */
.home__franchise {
  position: relative;
  z-index: 2;
  min-height: 136rpx;
  margin: 0 24rpx;
  padding: 0 24rpx 0 32rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  border-radius: 16rpx;
  background: var(--ic-fill-2);
}
.home__franchise--hover { opacity: 0.72; }
.home__franchise-title {
  display: block;
  min-width: 0;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.25;
  color: var(--ic-black);
}
.home__franchise-action {
  flex: none;
  min-width: 140rpx;
  height: 56rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  border-radius: 28rpx;
  background: var(--ic-black);
  color: var(--ic-white);
  font-size: 20rpx;
  font-weight: 600;
  line-height: 56rpx;
  text-align: center;
}

/* ---- daily sign-in ---- */
.home__sign-in {
  position: fixed;
  right: 20rpx;
  top: 30%;
  z-index: 45;
  width: 72rpx;
  height: 72rpx;
  box-sizing: border-box;
  transform: translateY(-50%);
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.96);
  color: var(--ic-black);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.16);
}
.home__sign-in-icon {
  color: currentColor;
  transform: scale(0.92);
}
.home__sign-in-dot {
  position: absolute;
  top: 7rpx;
  right: 7rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--ic-black);
  box-shadow: 0 0 0 3rpx var(--ic-white);
}
.home__sign-in-badge {
  position: absolute;
  top: 4rpx;
  right: 4rpx;
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  background: var(--ic-black);
  color: var(--ic-white);
  font-size: 16rpx;
  font-weight: 600;
  line-height: 22rpx;
  text-align: center;
  box-shadow: 0 0 0 3rpx var(--ic-white);
}
.home__sign-in--loading { opacity: 0.62; }
.home__sign-in--hover { transform: translateY(-50%) scale(0.94); }

.home__sign-dialog {
  position: fixed;
  inset: 0;
  z-index: 80;
  box-sizing: border-box;
  padding: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.38);
  animation: home-sign-dialog-backdrop 0.2s ease-out both;
}
.home__sign-dialog-panel {
  width: 100%;
  max-width: 686rpx;
  box-sizing: border-box;
  padding: 28rpx 32rpx 32rpx;
  border-radius: 24rpx;
  background: var(--ic-white);
  color: var(--ic-text);
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.16);
  animation: home-sign-dialog-enter 0.28s cubic-bezier(0.22, 1, 0.36, 1) both;
}
.home__sign-dialog-head {
  height: 76rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid var(--ic-line);
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.home__sign-dialog-title {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ic-black);
}
.home__sign-dialog-title .ic-ic { color: currentColor; }
.home__sign-dialog-close {
  width: 72rpx;
  height: 72rpx;
  margin-right: -18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 300;
  line-height: 1;
  color: var(--ic-text-3);
}
.home__sign-dialog-close--hover { opacity: 0.55; }
.home__sign-rules {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 32rpx;
}
.home__sign-rule {
  width: calc((100% - 24rpx) / 3);
  height: 136rpx;
  box-sizing: border-box;
  border-radius: 14rpx;
  background: var(--ic-fill-2);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.home__sign-rule--earned { background: var(--ic-fill); }
.home__sign-rule--current {
  background: var(--ic-white);
  box-shadow: inset 0 0 0 2rpx var(--ic-black);
}
.home__sign-rule-day {
  font-size: 20rpx;
  line-height: 1.2;
  color: var(--ic-text-3);
  white-space: nowrap;
}
.home__sign-rule-points {
  margin-top: 12rpx;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1;
  color: var(--ic-text-2);
  font-variant-numeric: tabular-nums;
}
.home__sign-rule--earned .home__sign-rule-points,
.home__sign-rule--current .home__sign-rule-points { color: var(--ic-black); }
.home__sign-rule-unit { margin-top: 6rpx; font-size: 20rpx; line-height: 1; color: var(--ic-text-3); }
.home__sign-dialog-loading {
  display: block;
  padding: 90rpx 0;
  text-align: center;
  font-size: 22rpx;
  color: var(--ic-text-3);
}
.home__sign-dialog-note {
  display: block;
  margin-top: 24rpx;
  text-align: center;
  font-size: 20rpx;
  line-height: 1.5;
  color: var(--ic-text-3);
}
.home__sign-dialog-button {
  width: 100% !important;
  height: 88rpx;
  margin: 28rpx 0 0 !important;
  padding: 0;
  border-radius: 8rpx;
  background: var(--ic-black);
  color: var(--ic-white);
  font-size: 26rpx;
  font-weight: 700;
  line-height: 88rpx;
}
.home__sign-dialog-button::after { border: none; }
.home__sign-dialog-button--done {
  background: var(--ic-fill);
  color: var(--ic-text-3);
}
@keyframes home-sign-dialog-enter {
  from { opacity: 0; transform: translateY(20rpx) scale(0.97); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}
@keyframes home-sign-dialog-backdrop {
  from { opacity: 0; }
  to { opacity: 1; }
}

.home__reward {
  position: fixed;
  inset: 0;
  z-index: 90;
  pointer-events: none;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.16);
  animation: home-reward-backdrop 1.6s ease-out both;
}
.home__reward-panel {
  position: relative;
  z-index: 1;
  width: 300rpx;
  padding: 38rpx 28rpx 34rpx;
  box-sizing: border-box;
  border-radius: 20rpx;
  background: var(--ic-white);
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 20rpx 50rpx rgba(0, 0, 0, 0.22);
  animation: home-reward-rise 0.48s cubic-bezier(0.22, 1, 0.36, 1) both;
}
.home__reward-check {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--ic-black);
  color: var(--ic-white);
  font-size: 28rpx;
  line-height: 72rpx;
  text-align: center;
}
.home__reward-title { margin-top: 20rpx; font-size: 24rpx; font-weight: 600; color: var(--ic-black); }
.home__reward-points { margin-top: 4rpx; font-size: 30rpx; font-weight: 700; color: var(--ic-black); font-variant-numeric: tabular-nums; }
.home__reward-streak { margin-top: 8rpx; font-size: 20rpx; color: var(--ic-text-3); }
.home__reward-halo {
  position: absolute;
  width: 210rpx;
  height: 210rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 50%;
  animation: home-reward-halo 0.72s ease-out both;
}
@keyframes home-reward-rise {
  from { opacity: 0; transform: translateY(30rpx) scale(0.9); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}
@keyframes home-reward-halo {
  from { opacity: 0.85; transform: scale(0.6); }
  to { opacity: 0; transform: scale(2); }
}
@keyframes home-reward-backdrop {
  0% { opacity: 0; }
  15%, 78% { opacity: 1; }
  100% { opacity: 0; }
}
@media (prefers-reduced-motion: reduce) {
  .home__sign-dialog,
  .home__sign-dialog-panel,
  .home__reward,
  .home__reward-panel,
  .home__reward-halo { animation-duration: 0.01ms; }
}
