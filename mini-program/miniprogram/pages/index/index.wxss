.home {
  position: relative;
  background: #d8d7d5;
}
.home__scroll {
  position: relative;
  z-index: 1;
}
.home__scroll-content {
  min-height: 100%;
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.home__ambient {
  position: fixed;
  inset: 0;
  z-index: 0;
  overflow: hidden;
  background: #d8d7d5;
  pointer-events: none;
}
.home__ambient-image {
  position: absolute;
  top: -80rpx;
  right: -80rpx;
  bottom: -80rpx;
  left: -80rpx;
  width: calc(100% + 160rpx);
  height: calc(100% + 160rpx);
  opacity: 0.78;
  -webkit-filter: blur(64rpx) saturate(82%);
  filter: blur(64rpx) saturate(82%);
  transform: scale(1.04);
}
.home__ambient-wash {
  position: absolute;
  inset: 0;
  background: rgba(235, 235, 233, 0.38);
}

/* ---- custom navigation ---- */
.home__nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 20;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0.36) 0%, rgba(0, 0, 0, 0) 100%);
}
/* Logo remains optically centered while the current store occupies the left safe area. */
.home__nav-bar { position: relative; display: flex; align-items: center; justify-content: center; box-sizing: border-box; }
.home__nav-store {
  position: absolute;
  left: 24rpx;
  top: 50%;
  max-width: 250rpx;
  min-height: 60rpx;
  padding: 0 14rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  transform: translateY(-50%);
  color: var(--ic-white);
  background: rgba(9, 9, 10, 0.66);
  border-radius: 10rpx;
  box-sizing: border-box;
}
.home__nav-store--hover { opacity: 0.68; }
.home__nav-store-copy { display: flex; align-items: center; gap: 8rpx; min-width: 0; white-space: nowrap; }
.home__nav-store-name { display: block; min-width: 0; max-width: 136rpx; font-size: 24rpx; font-weight: 650; line-height: 1.2; }
.home__nav-store-distance { display: block; flex: none; font-size: 20rpx; font-weight: 500; line-height: 1.2; color: rgba(255, 255, 255, 0.9); }
.home__nav-store-arrow { flex: none; width: 9rpx; height: 9rpx; margin-left: 0; border-color: currentColor; transform: rotate(45deg); }
.home__nav-logo {
  height: 52rpx;
  width: auto;
  display: block;
  filter: brightness(0) invert(1) drop-shadow(0 2rpx 6rpx rgba(0, 0, 0, 0.35));
  opacity: 0.96;
}

/* ---- banner ---- */
.home__banner-stage {
  position: relative;
  z-index: 1;
  overflow: hidden;
  border-radius: 0 0 60rpx 60rpx;
}
.home__banner {
  position: relative;
  z-index: 1;
  width: 100%;
  height: 820rpx;
  margin: 0;
  border-radius: 0 0 60rpx 60rpx;
  overflow: hidden;
  background: #17161a;
}
.home__banner-item { position: relative; width: 100%; height: 100%; }
.home__banner-empty { position: relative; }
.home__banner-img {
  width: 100%;
  height: 100%;
  display: block;
  object-position: center top;
}
.home__banner-loading {
  position: absolute;
  inset: 0;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}
.home__banner-ph {
  width: 100%; height: 100%;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  background: linear-gradient(155deg, #3a3630 0%, #17161a 60%, #0c0b0d 100%);
}
.home__banner-title { color: #f4efe6; font-size: 30rpx; font-weight: 700; letter-spacing: 6rpx; }
.home__banner-item .home__banner-title { display: none; }
.home__banner-sub { margin-top: 16rpx; color: rgba(244, 239, 230, 0.55); font-size: 20rpx; letter-spacing: 6rpx; }
.home__banner-info {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  box-sizing: border-box;
  min-height: 176rpx;
  padding: 58rpx 32rpx 46rpx;
  background: linear-gradient(180deg, rgba(9, 9, 10, 0) 0%, rgba(9, 9, 10, 0.82) 58%, rgba(9, 9, 10, 0.94) 100%);
  color: var(--ic-white);
  z-index: 2;
}
.home__banner-info-head {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 24rpx;
  min-width: 0;
}
.home__banner-activity-title {
  display: none;
}
.home__banner-all {
  flex: none;
  min-width: 132rpx;
  height: 56rpx;
  padding: 0 18rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.94);
  color: var(--ic-white);
  font-size: 20rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}
.home__banner-all--hover { opacity: 0.76; }
.home__banner-all-arrow {
  width: 10rpx;
  height: 10rpx;
  border-color: currentColor;
}
.home__banner-meta {
  display: none;
}
.home__banner-store { flex: none; max-width: 190rpx; }
.home__banner-time { flex: 1; min-width: 0; }

/* ---- franchise and member information ---- */
.home__glass-zone {
  position: relative;
  z-index: 1;
  margin: 0;
  padding: 20rpx 12rpx 28rpx;
  box-sizing: border-box;
}
.home__feature-wall {
  position: relative;
  z-index: 1;
  overflow: hidden;
  margin: 0;
  padding: 16rpx 0 10rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  border-radius: 36rpx;
  box-sizing: border-box;
  margin-top: 30rpx;
  background: rgba(12, 15, 20, 0.5);
  -webkit-backdrop-filter: blur(40rpx) saturate(155%) brightness(0.78);
  backdrop-filter: blur(40rpx) saturate(155%) brightness(0.78);
  box-shadow:
    inset 0 5rpx 10rpx rgba(4, 7, 11, 0.28),
    inset 0 -2rpx 3rpx rgba(255, 255, 255, 0.13),
    inset 1rpx 0 2rpx rgba(0, 0, 0, 0.08),
    inset -1rpx 0 2rpx rgba(255, 255, 255, 0.05);
}
.home__feature-wall::before {
  content: "";
  position: absolute;
  top: 0;
  right: 22rpx;
  left: 22rpx;
  height: 48rpx;
  z-index: 1;
  border-radius: 36rpx 36rpx 40% 40%;
  background: linear-gradient(180deg, rgba(4, 7, 11, 0.24), rgba(4, 7, 11, 0));
  pointer-events: none;
}
.home__feature-gif {
  position: absolute;
  inset: 0;
  z-index: 0;
  width: 100%;
  height: 100%;
  opacity: 0.24;
  -webkit-filter: none;
  filter: none;
  pointer-events: none;
}
/* ---- member card ---- */
.home__card { position: relative; z-index: 2; box-sizing: border-box; min-height: 142rpx; margin: 18rpx 24rpx 16rpx; padding: 20rpx 22rpx 24rpx; }
.home__card-top { position: relative; z-index: 1; display: flex; align-items: center; }
.home__card-top--guest { align-items: center; }
.home__avatar {
  width: 88rpx; height: 88rpx; border-radius: 50%; background: #111; flex: none;
  display: flex; align-items: center; justify-content: center; overflow: hidden;
  box-shadow: 0 0 0 1rpx rgba(255, 255, 255, 0.22);
}
.home__avatar--guest { width: 88rpx; height: 88rpx; }
.home__avatar-img { width: 100%; height: 100%; }
.home__avatar-logo { width: 100%; height: 100%; box-sizing: border-box; padding: 0 16rpx; background: #fff; }
.home__ident { flex: 1; min-width: 0; margin-left: 22rpx; }
.home__ident--guest { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.home__guest-text { min-width: 0; }
.home__member-name-line { display: flex; align-items: baseline; min-width: 0; }
.home__member-greeting { flex: none; font-size: 28rpx; font-weight: 500; line-height: 1.2; color: rgba(255, 255, 255, 0.96); }
.home__member-name { min-width: 0; font-size: 28rpx; font-weight: 500; line-height: 1.2; color: rgba(255, 255, 255, 0.96); }
.home__hello { display: block; font-size: 20rpx; color: rgba(255, 255, 255, 0.56); }
.home__name { display: block; margin-top: 2rpx; font-size: 26rpx; font-weight: 700; line-height: 1.2; color: rgba(255, 255, 255, 0.95); }
.home__no { display: block; margin-top: 6rpx; font-size: 20rpx; line-height: 1.2; color: rgba(255, 255, 255, 0.52); white-space: nowrap; }
.home__vip { display: inline-flex; align-items: center; gap: 8rpx; min-width: 0; max-width: 180rpx; height: 52rpx; margin-left: 20rpx; padding: 0 18rpx; border-radius: 26rpx; color: rgba(255, 255, 255, 0.9); box-sizing: border-box; }
.home__vip-mark { flex: none; font-size: 20rpx; line-height: 1; color: currentColor; }
.home__vip-name { min-width: 0; font-size: 20rpx; font-weight: 600; color: currentColor; }
.home__vip-arrow { width: 9rpx; height: 9rpx; border-color: currentColor; }
.home__login {
  display: inline-flex; align-items: center; justify-content: center;
  height: 52rpx; padding: 0 32rpx; border-radius: 26rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  background: rgba(255, 255, 255, 0.1); color: rgba(255, 255, 255, 0.94); font-size: 22rpx; font-weight: 600;
}
.home__login--hover { opacity: 0.7; }

/* ---- current store address ---- */
.home__store-section {
  position: relative;
  z-index: 2;
  margin: 0 24rpx 16rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.11);
}
.home__store-panel {
  position: relative;
  min-height: 148rpx;
  padding: 24rpx 26rpx;
  box-sizing: border-box;
  overflow: hidden;
  color: rgba(255, 255, 255, 0.94);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 28rpx;
}
.home__store-panel--hover { opacity: 0.86; }
.home__store-panel-map {
  position: absolute;
  top: 0;
  right: 0;
  z-index: 0;
  width: 58%;
  height: 100%;
  opacity: 0.24;
  -webkit-filter: grayscale(1) brightness(1.8) contrast(0.9);
  filter: grayscale(1) brightness(1.8) contrast(0.9);
}
.home__store-panel-copy {
  position: relative;
  z-index: 2;
  flex: 1;
  min-width: 0;
}
.home__store-panel-name {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1.25;
  color: rgba(255, 255, 255, 0.94);
}
.home__store-panel-address {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 1.45;
  color: rgba(255, 255, 255, 0.58);
}
.home__store-panel-location {
  position: relative;
  z-index: 2;
  width: 140rpx;
  flex: none;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.home__store-panel-icon {
  width: 48rpx;
  height: 48rpx;
  filter: brightness(0) invert(1);
  opacity: 0.82;
}
.home__store-panel-distance {
  display: block;
  max-width: 150rpx;
  margin-top: 6rpx;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.2;
  color: rgba(255, 255, 255, 0.9);
  white-space: nowrap;
}

/* ---- global franchise inquiry ---- */
.home__franchise {
  position: relative;
  z-index: 2;
  min-height: 136rpx;
  margin: 0 24rpx;
  padding: 0 24rpx 0 32rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.11);
}
.home__franchise--hover { opacity: 0.72; }
.home__franchise-title {
  min-width: 0;
  font-size: 32rpx;
  font-weight: 500;
  line-height: 1.25;
  color: rgba(255, 255, 255, 0.95);
}
.home__franchise-action {
  flex: none;
  min-width: 140rpx;
  height: 56rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  border-radius: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  font-size: 20rpx;
  font-weight: 400;
  line-height: 56rpx;
  text-align: center;
}
.home__banner-all {
  border: 1rpx solid rgba(255, 255, 255, 0.76);
  background: transparent;
  -webkit-backdrop-filter: blur(18rpx) saturate(116%) brightness(1.06);
  backdrop-filter: blur(18rpx) saturate(116%) brightness(1.06);
  box-shadow: inset 0 2rpx 0 rgba(255, 255, 255, 0.54);
}
.home__vip,
.home__franchise-action {
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  background: rgba(255, 255, 255, 0.08);
  -webkit-backdrop-filter: blur(24rpx) saturate(145%) brightness(0.98);
  backdrop-filter: blur(24rpx) saturate(145%) brightness(0.98);
  box-shadow:
    inset 0 3rpx 6rpx rgba(4, 7, 11, 0.22),
    inset 0 -1rpx 2rpx rgba(255, 255, 255, 0.13);
}
