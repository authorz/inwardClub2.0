<ic-app-background />
<view class="ic-scroll-shell">
<ic-page-nav title="咨询客服" />
<scroll-view class="ic-scroll-view" scroll-y enhanced show-scrollbar="{{false}}" bounces="{{false}}">
<ic-loading wx:if="{{loading}}" show text="正在匹配最近门店" />

<view wx:elif="{{store}}" class="cs">
  <view class="cs__intro">
    <image class="cs__intro-logo" src="https://assets.inwardclub.com/public/images/inward-logo-optimized.gif?imageMogr2/format/png" mode="widthFix" />
    <text class="cs__title">咨询客服</text>
    <text class="cs__subtitle">当前门店客服将为你提供帮助</text>
  </view>

  <view class="cs__store ic-glass-recessed">
    <view class="cs__store-logo-wrap">
      <image
        class="cs__store-logo"
        src="{{store.logoUrl || 'https://assets.inwardclub.com/public/images/inward-logo-optimized.gif?imageMogr2/format/png'}}"
        mode="aspectFit"
      />
    </view>
    <view class="cs__store-main">
      <text class="cs__store-name">{{store.name}}</text>
      <text class="cs__store-address">{{store.address || '门店地址待完善'}}</text>
    </view>
    <text wx:if="{{distanceText}}" class="cs__distance">距您 {{distanceText}}</text>
  </view>

  <view class="cs__section cs__qr-section ic-glass-recessed">
    <text class="cs__section-title">客服微信</text>
    <text class="cs__section-desc">点击二维码可放大查看，长按可识别或保存</text>
    <view wx:if="{{store.customerServiceQrUrl}}" class="cs__qr-wrap" bindtap="onPreviewQR">
      <image
        class="cs__qr"
        src="{{store.customerServiceQrUrl}}"
        mode="aspectFit"
        show-menu-by-longpress
      />
    </view>
    <view wx:else class="cs__missing">
      <image class="cs__missing-icon" src="/assets/mine-menu/customer-service.png" mode="aspectFit" />
      <text>该门店暂未上传客服微信二维码</text>
    </view>
  </view>

  <view class="cs__section cs__phone-section ic-glass-recessed">
    <text class="cs__section-title">电话联系</text>
    <view class="cs__phone-row" bindtap="onCopyPhone">
      <view class="ic-ic ic-ic-phone cs__phone-icon"></view>
      <view class="cs__phone-main">
        <text class="cs__phone-label">门店客服电话</text>
        <text class="cs__phone">{{store.phone || '暂未设置'}}</text>
      </view>
      <text wx:if="{{store.phone}}" class="cs__copy">点击复制</text>
    </view>
    <button
      class="ic-btn ic-btn-primary ic-btn-block ic-glass-recessed cs__call"
      disabled="{{!store.phone}}"
      bindtap="onCall"
    >
      拨打电话
    </button>
  </view>
</view>

<view wx:else class="cs cs--empty">
  <ic-empty text="暂未找到可联系的门店" hint="请稍后重试">
    <button class="ic-btn ic-btn-ghost cs__retry" bindtap="loadContactStore">重新加载</button>
  </ic-empty>
</view>
</scroll-view>
</view>
