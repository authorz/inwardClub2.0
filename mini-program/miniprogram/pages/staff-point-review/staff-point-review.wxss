.spr__scroll { background: var(--ic-bg); }
.spr { min-height: 0; background: var(--ic-bg); padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
.spr__search { height: 84rpx; display: flex; align-items: center; gap: 18rpx; border: 1rpx solid var(--ic-line-strong); border-radius: 12rpx; padding: 0 22rpx; margin-bottom: 24rpx; background: var(--ic-white); box-sizing: border-box; }
.spr__search-input { flex: 1; min-width: 0; height: 82rpx; font-size: 24rpx; color: var(--ic-black); }
.spr__search-ph { color: var(--ic-text-4); }
.spr__search-clear { padding: 20rpx 0; font-size: 21rpx; color: var(--ic-text-3); }
.spr__search-button { padding: 20rpx 0 20rpx 8rpx; font-size: 22rpx; font-weight: 600; color: var(--ic-black); }
.spr__list { border-top: 1rpx solid var(--ic-line); }
.spr__row { padding: 30rpx 0; border-bottom: 1rpx solid var(--ic-line); }
.spr__content--hover { opacity: 0.72; }
.spr__top { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.spr__identity { flex: 1; min-width: 0; display: flex; align-items: center; gap: 18rpx; }
.spr__avatar {
  width: 76rpx;
  height: 76rpx;
  flex: none;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid var(--ic-line-strong);
  border-radius: 50%;
  background: var(--ic-fill);
  box-sizing: border-box;
}
.spr__avatar-image { width: 100%; height: 100%; }
.spr__avatar-text { font-size: 24rpx; font-weight: 600; color: var(--ic-text-2); }
.spr__head { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 8rpx; }
.spr__member { max-width: 300rpx; font-size: 26rpx; font-weight: 700; color: var(--ic-black); }
.spr__phone { font-size: 21rpx; color: var(--ic-text-2); }
.spr__points { flex: none; display: flex; flex-direction: column; align-items: flex-end; gap: 4rpx; }
.spr__points-value { font-size: 28rpx; font-weight: 700; line-height: 1.2; color: var(--ic-black); font-variant-numeric: tabular-nums; }
.spr__points-label { font-size: 20rpx; line-height: 1.3; color: var(--ic-text-2); }
.spr__meta { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-top: 14rpx; }
.spr__store { flex: 1; min-width: 0; display: flex; align-items: center; gap: 8rpx; }
.spr__store-icon { width: 28rpx; height: 28rpx; flex: none; }
.spr__store-name { min-width: 0; font-size: 22rpx; color: var(--ic-text-2); }
.spr__time { font-size: 21rpx; color: var(--ic-text-2); flex: none; }
.spr__actions { display: flex; justify-content: flex-end; gap: 16rpx; margin-top: 22rpx; }
.spr__done { margin-top: 20rpx; text-align: right; font-size: 22rpx; color: var(--ic-text-3); }
