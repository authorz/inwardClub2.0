.spr__scroll { background: var(--ic-bg); }
.spr { min-height: 0; background: var(--ic-bg); padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
.spr__search { height: 84rpx; display: flex; align-items: center; gap: 18rpx; border: 1rpx solid var(--ic-line-strong); border-radius: 12rpx; padding: 0 22rpx; margin-bottom: 24rpx; background: var(--ic-white); box-sizing: border-box; }
.spr__search-input { flex: 1; min-width: 0; height: 82rpx; font-size: 24rpx; color: var(--ic-black); }
.spr__search-ph { color: var(--ic-text-2); }
.spr__search-clear { padding: 20rpx 0; font-size: 21rpx; color: var(--ic-text-2); }
.spr__search-button { padding: 20rpx 0 20rpx 8rpx; font-size: 22rpx; font-weight: 600; color: var(--ic-black); }
.spr__list { border-top: 1rpx solid var(--ic-line); }
.spr__row { padding: 28rpx 0; border-bottom: 1rpx solid var(--ic-line); }
.spr__content { display: flex; align-items: flex-start; gap: 18rpx; }
.spr__content--hover { opacity: 0.72; }
.spr__avatar {
  width: 76rpx;
  height: 76rpx;
  flex: none;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid var(--ic-line-strong);
  border-radius: 50%;
  background: var(--ic-fill);
  box-sizing: border-box;
}
.spr__avatar-image { width: 100%; height: 100%; }
.spr__avatar-text { font-size: 24rpx; font-weight: 600; color: var(--ic-text-2); }
.spr__body { flex: 1; min-width: 0; }
.spr__name-line { display: flex; align-items: center; gap: 10rpx; min-width: 0; }
.spr__member { min-width: 0; font-size: 26rpx; font-weight: 700; line-height: 1.3; color: var(--ic-black); }
.spr__status {
  height: 36rpx;
  padding: 0 12rpx;
  flex: none;
  display: inline-flex;
  align-items: center;
  border-radius: 999rpx;
  background: var(--ic-fill);
  font-size: 20rpx;
  line-height: 1;
  color: var(--ic-text-2);
}
.spr__phone { display: block; margin-top: 6rpx; font-size: 21rpx; line-height: 1.35; color: var(--ic-text-2); }
.spr__meta { min-width: 0; margin-top: 12rpx; display: flex; align-items: center; gap: 7rpx; }
.spr__store-icon { width: 26rpx; height: 26rpx; flex: none; }
.spr__store-name { min-width: 0; font-size: 21rpx; color: var(--ic-text-2); }
.spr__meta-separator { flex: none; font-size: 20rpx; color: var(--ic-text-3); }
.spr__time { flex: none; font-size: 20rpx; color: var(--ic-text-2); }
.spr__points { min-width: 112rpx; margin-left: 2rpx; flex: none; display: flex; flex-direction: column; align-items: flex-end; gap: 4rpx; }
.spr__points-value { font-size: 28rpx; font-weight: 700; line-height: 1.2; color: var(--ic-black); font-variant-numeric: tabular-nums; }
.spr__points-label { font-size: 20rpx; line-height: 1.3; color: var(--ic-text-2); }
.spr__actions { margin: 20rpx 0 0 94rpx; display: flex; justify-content: flex-end; gap: 12rpx; }
.spr__actions .ic-btn { min-width: 120rpx; margin: 0; }
.spr__state { padding: 100rpx 0; display: flex; flex-direction: column; align-items: center; gap: 22rpx; }
.spr__state-text, .spr__footer { font-size: 21rpx; color: var(--ic-text-3); text-align: center; }
.spr__retry { min-width: 168rpx; height: 64rpx; margin: 0; padding: 0 28rpx; border: 1rpx solid var(--ic-line-strong); border-radius: 999rpx; background: transparent; font-size: 22rpx; line-height: 62rpx; color: var(--ic-black); }
.spr__retry::after { border: none; }
.spr__footer { padding: 28rpx 0 12rpx; }
