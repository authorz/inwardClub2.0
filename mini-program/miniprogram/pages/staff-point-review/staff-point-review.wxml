<view class="ic-scroll-shell">
<scroll-view class="ic-scroll-view spr__scroll" scroll-y enhanced show-scrollbar="{{false}}" bounces="{{false}}">
<view class="spr">
  <view class="spr__search">
    <input class="spr__search-input" maxlength="50" value="{{keyword}}" placeholder="搜索昵称或手机号" placeholder-class="spr__search-ph" bindinput="onSearch" />
  </view>
  <ic-loading wx:if="{{loading}}" />
  <ic-empty wx:elif="{{!list.length}}" text="暂无积分审核申请" />

  <view wx:else class="spr__list">
    <view class="spr__card" wx:for="{{list}}" wx:key="id">
      <view class="spr__top" data-id="{{item.id}}" bindtap="goDetail">
        <view class="spr__head">
          <text class="spr__member">{{item.memberName}}</text>
          <text class="spr__dir">{{item.directionLabel}}</text>
        </view>
        <text class="spr__points">{{item.points}} 积分</text>
      </view>
      <view class="spr__meta" data-id="{{item.id}}" bindtap="goDetail">
        <text class="spr__store ic-ellipsis">{{item.storeName}}</text>
        <text class="spr__time">{{item.timeText}}</text>
      </view>
      <view wx:if="{{item.pending}}" class="spr__actions">
        <button class="ic-btn ic-btn-ghost ic-btn-sm" data-id="{{item.id}}" data-decision="reject" catchtap="review">驳回</button>
        <button class="ic-btn ic-btn-primary ic-btn-sm" data-id="{{item.id}}" data-decision="approve" catchtap="review">通过</button>
      </view>
      <view wx:else class="spr__done">{{item.statusLabel}}</view>
    </view>
  </view>
</view>
</scroll-view>
</view>
