<ic-app-background />
<view class="ic-scroll-shell">
<scroll-view class="ic-scroll-view spr__scroll" scroll-y enhanced show-scrollbar="{{false}}" bounces="{{false}}">
<view class="spr">
  <view class="spr__search">
    <input class="spr__search-input" type="number" maxlength="11" value="{{keyword}}" placeholder="输入手机号任意数字，常用后四位" placeholder-class="spr__search-ph" confirm-type="search" bindinput="onSearch" bindconfirm="search" />
    <text wx:if="{{keyword}}" class="spr__search-clear" bindtap="clearSearch">清除</text>
    <text class="spr__search-button" bindtap="search">搜索</text>
  </view>
  <ic-loading wx:if="{{loading}}" />
  <ic-empty wx:elif="{{!list.length}}" text="{{keyword ? '未找到匹配手机号的待审核申请' : '当前门店暂无待审核积分存入'}}" />

  <view wx:else class="spr__list">
    <view class="spr__row" wx:for="{{list}}" wx:key="id">
      <view class="spr__content" data-id="{{item.id}}" bindtap="goDetail" hover-class="spr__content--hover" aria-role="button" aria-label="{{item.memberName}}，{{item.phoneText}}，存入 {{item.pointsText}} 积分，{{item.timeText}}">
        <view class="spr__avatar">
          <image wx:if="{{item.memberAvatarUrl}}" class="spr__avatar-image" src="{{item.memberAvatarUrl}}" mode="aspectFill" />
          <text wx:else class="spr__avatar-text">{{item.memberAvatarText}}</text>
        </view>
        <view class="spr__body">
          <view class="spr__name-line">
            <text class="spr__member ic-ellipsis">{{item.memberName}}</text>
            <text wx:if="{{!item.pending}}" class="spr__status">{{item.statusLabel}}</text>
          </view>
          <text class="spr__phone">{{item.phoneText}}</text>
          <view class="spr__meta">
            <image class="spr__store-icon" src="/assets/icons/location-address.svg" mode="aspectFit" />
            <text class="spr__store-name ic-ellipsis">{{item.storeName}}</text>
            <text class="spr__meta-separator">·</text>
            <text class="spr__time">{{item.timeText}}</text>
          </view>
        </view>
        <view class="spr__points">
          <text class="spr__points-value">+{{item.pointsText}}</text>
          <text class="spr__points-label">存入积分</text>
        </view>
      </view>
      <view wx:if="{{item.pending}}" class="spr__actions">
        <button class="ic-btn ic-btn-ghost ic-btn-sm" data-id="{{item.id}}" data-decision="reject" catchtap="review">驳回</button>
        <button class="ic-btn ic-btn-primary ic-btn-sm" data-id="{{item.id}}" data-decision="approve" catchtap="review">通过</button>
      </view>
    </view>
  </view>
</view>
</scroll-view>
</view>
