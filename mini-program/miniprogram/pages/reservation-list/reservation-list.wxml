<ic-app-background />
<view class="rl">
  <ic-loading wx:if="{{loading}}" />
  <ic-empty wx:elif="{{!list.length}}" text="暂无预约记录" />

  <view wx:else class="rl__list">
    <view class="rl__card" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" bindtap="goDetail" hover-class="rl__card--hover">
      <view class="rl__top">
        <text class="rl__title">{{item.tableName}} · {{item.seatNo}}号座位</text>
        <ic-status-badge status="{{item.status}}" map="reservation" />
      </view>
      <view class="rl__meta">
        <view class="ic-ic ic-ic-pin ic-ic--sm"></view>
        <text class="rl__store ic-ellipsis">{{item.storeName}}</text>
      </view>
      <view class="rl__meta">
        <view class="ic-ic ic-ic-clock ic-ic--sm"></view>
        <text class="rl__time">{{item.timeText}}</text>
      </view>
    </view>
  </view>
</view>
