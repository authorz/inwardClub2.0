<view class="ord">
  <ic-page-nav title="点餐" back="{{false}}" left-text="{{store.name || '选择门店'}}" bind:lefttap="openStoreSheet" />

  <view wx:if="{{selectedCoupon}}" class="ord__coupon-tip ic-glass-recessed">
    <view class="ord__coupon-main">
      <text class="ord__coupon-name">{{selectedCoupon.name}}</text>
      <text class="ord__coupon-desc">{{selectedCoupon.desc}}</text>
    </view>
    <view class="ord__coupon-clear" bindtap="clearSelectedCoupon">移除</view>
  </view>

  <ic-loading wx:if="{{loading}}" />
  <ic-empty wx:elif="{{!groups.length}}" text="当前门店暂无菜单" />

  <view wx:else class="ord__body">
    <!-- left category rail -->
    <scroll-view class="ord__cats" scroll-y>
      <view
        class="ord__cat {{activeCat === item.id ? 'is-active' : ''}}"
        wx:for="{{groups}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onPickCat"
      >
        <image wx:if="{{item.iconUrl}}" class="ord__cat-icon" src="{{item.iconUrl}}" mode="aspectFit" />
        <text class="ord__cat-name">{{item.name}}</text>
      </view>
    </scroll-view>

    <!-- right item grid: load the active category only -->
    <scroll-view class="ord__items" scroll-y>
      <ic-loading wx:if="{{itemsLoading}}" text="加载餐品" />
      <ic-empty wx:elif="{{!items.length}}" text="当前分类暂无餐品" compact="{{true}}" />
      <block wx:else>
        <view class="ord__group-title">{{activeCatName}}</view>
        <view class="ord__grid">
          <view class="ord__item ic-glass-recessed" wx:for="{{items}}" wx:key="id" wx:for-item="it">
            <view class="ord__item-img">
              <image wx:if="{{it.imageUrl}}" class="ord__item-pic" src="{{it.imageUrl}}" mode="aspectFill" />
              <view wx:else class="ord__item-ph"><text>{{it.name}}</text></view>
              <view wx:if="{{it.soldOut}}" class="ord__soldout">已售罄</view>
            </view>
            <text class="ord__item-name ic-ellipsis">{{it.name}}</text>
            <view class="ord__item-foot">
              <view class="ord__item-row">
                <text class="ord__item-yuan {{it.priceCompact ? 'ord__item-yuan--compact' : ''}}">¥{{it.priceText}}</text>
                <view wx:if="{{!it.soldOut}}" class="ord__item-stepper">
                  <ic-stepper
                    value="{{it.qty}}"
                    min="{{0}}"
                    max="{{it.stock}}"
                    size="sm"
                    theme="dark"
                    hide-zero="{{true}}"
                    data-id="{{it.id}}"
                    bind:change="onQtyChange"
                  />
                </view>
              </view>
              <text class="ord__item-pay">微信 / 金币可用</text>
            </view>
          </view>
        </view>
        <view class="ord__grid-gap"></view>
      </block>
    </scroll-view>
  </view>

  <!-- bottom cart bar -->
  <view class="ord__cart ic-glass-recessed">
    <view class="ord__cart-summary" bindtap="openCartSheet" hover-class="ord__cart-summary--hover">
      <view class="ord__cart-icon {{cartCount ? 'is-full' : ''}}">
        <view class="ic-ic ic-ic-bag"></view>
        <view wx:if="{{cartCount}}" class="ord__cart-badge">{{cartCount}}</view>
      </view>
      <view class="ord__cart-meta">
        <text class="ord__cart-count">已选 {{cartCount}} 件</text>
        <text class="ord__cart-hint">点击查看购物车</text>
      </view>
    </view>
    <text class="ord__cart-total">¥{{totalText}}</text>
    <button class="ic-btn ic-btn-primary ord__cart-btn {{cartCount ? '' : 'ic-disabled'}}" bindtap="onCheckout">去结算</button>
  </view>
</view>

<ic-bottom-sheet show="{{showStoreSheet}}" title="选择门店" max-height="82vh" bind:close="closeStoreSheet">
  <view class="ord-store-list">
    <view
      class="ord-store {{store.id === item.id ? 'is-active' : ''}}"
      wx:for="{{stores}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onSelectStore"
    >
      <view class="ord-store__main">
        <text class="ord-store__name">{{item.name}}</text>
        <text class="ord-store__addr ic-ellipsis">{{item.address}}{{item.addressDetail ? ' · ' + item.addressDetail : ''}}</text>
      </view>
      <text wx:if="{{store.id === item.id}}" class="ord-store__current">当前</text>
    </view>
  </view>
</ic-bottom-sheet>

<ic-bottom-sheet show="{{showCartSheet}}" title="购物车" max-height="72vh" bind:close="closeCartSheet">
  <view class="ord-cart-sheet__bar">
    <text class="ord-cart-sheet__count">已选 {{cartCount}} 件餐品</text>
    <text class="ord-cart-sheet__clear" bindtap="onClearCart">清空</text>
  </view>
  <view class="ord-cart-sheet__list">
    <view class="ord-cart-sheet__item" wx:for="{{cartItems}}" wx:key="id" wx:for-item="cartItem">
      <image wx:if="{{cartItem.imageUrl}}" class="ord-cart-sheet__image" src="{{cartItem.imageUrl}}" mode="aspectFill" />
      <view wx:else class="ord-cart-sheet__image ord-cart-sheet__image--empty">{{cartItem.initial}}</view>
      <view class="ord-cart-sheet__info">
        <text class="ord-cart-sheet__name ic-ellipsis">{{cartItem.name}}</text>
        <text class="ord-cart-sheet__price">¥{{cartItem.priceText}}</text>
      </view>
      <view class="ord-cart-sheet__action">
        <text class="ord-cart-sheet__subtotal">¥{{cartItem.lineTotalText}}</text>
        <ic-stepper
          value="{{cartItem.qty}}"
          min="{{0}}"
          max="{{cartItem.stock}}"
          size="sm"
          theme="dark"
          data-id="{{cartItem.id}}"
          bind:change="onQtyChange"
        />
      </view>
    </view>
  </view>
  <button slot="footer" class="ic-btn ic-btn-primary ord-cart-sheet__checkout" bindtap="onCheckout">去结算 · ¥{{totalText}}</button>
</ic-bottom-sheet>
