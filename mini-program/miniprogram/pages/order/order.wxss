.ord { position: relative; z-index: 1; height: 100vh; display: flex; flex-direction: column; box-sizing: border-box; background: transparent; }
.ord__page-background {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
}

.ord__nav {
  flex: none;
  background: var(--ic-white);
  border-bottom: 1rpx solid var(--ic-line);
}
.ord__nav-bar {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}
.ord__nav-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ic-black);
}
.ord__nav-store {
  position: absolute;
  left: 24rpx;
  top: 0;
  bottom: 0;
  width: 300rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.ord__nav-loc {
  width: 30rpx;
  height: 30rpx;
  flex: none;
}
.ord__nav-name {
  display: block;
  min-width: 0;
  flex: 1;
  font-size: 22rpx;
  font-weight: 400;
  color: var(--ic-black);
}
.ord__coupon-tip {
  flex: none;
  margin: 16rpx 24rpx 0;
  min-height: 72rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: var(--ic-fill-2);
  display: flex;
  align-items: center;
  gap: 18rpx;
}
.ord__coupon-main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4rpx; }
.ord__coupon-name { font-size: 24rpx; font-weight: 700; color: var(--ic-black); }
.ord__coupon-desc { font-size: 20rpx; color: var(--ic-text-3); }
.ord__coupon-clear { flex: none; font-size: 22rpx; color: var(--ic-text-3); }

.ord__body { flex: 1; display: flex; min-height: 0; }

/* ---- left category rail ---- */
.ord__cats {
  width: 184rpx;
  flex: none;
  height: 100%;
  box-sizing: border-box;
  border-right: 1rpx solid rgba(255, 255, 255, 0.3);
  background: rgba(18, 22, 28, 0.34);
  -webkit-backdrop-filter: blur(42rpx) saturate(145%) brightness(0.96);
  backdrop-filter: blur(42rpx) saturate(145%) brightness(0.96);
  box-shadow: inset -1rpx 0 0 rgba(255, 255, 255, 0.2);
}
.ord__cat {
  height: 132rpx;
  padding: 16rpx 12rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  font-size: 24rpx;
  line-height: 1.35;
  color: rgba(255, 255, 255, 0.74);
  text-align: center;
  position: relative;
}
.ord__cat-icon { width: 40rpx; height: 40rpx; flex: none; }
.ord__cat-name { display: block; width: 100%; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.ord__cat.is-active { background: rgba(255, 255, 255, 0.18); color: var(--ic-white); font-weight: 700; }
.ord__cat.is-active::before {
  content: "";
  position: absolute;
  left: 0;
  top: 40rpx;
  bottom: 40rpx;
  width: 5rpx;
  border-radius: 5rpx;
  background: rgba(255, 255, 255, 0.88);
}

/* ---- right item grid ---- */
.ord__items { flex: 1; height: 100%; box-sizing: border-box; padding: 0 18rpx; padding-bottom: calc(260rpx + env(safe-area-inset-bottom)); }
.ord__group-title { padding: 26rpx 8rpx 12rpx; font-size: 22rpx; font-weight: 500; color: rgba(255, 255, 255, 0.78); }
.ord__grid { display: flex; flex-wrap: wrap; justify-content: space-between; }
.ord__item {
  width: 48%;
  margin-bottom: 24rpx;
  padding: 12rpx 12rpx 16rpx;
  box-sizing: border-box;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.58);
  border-radius: 24rpx;
  background: rgba(232, 237, 244, 0.46);
  -webkit-backdrop-filter: blur(42rpx) saturate(145%) brightness(1.04);
  backdrop-filter: blur(42rpx) saturate(145%) brightness(1.04);
  box-shadow:
    inset 0 2rpx 0 rgba(255, 255, 255, 0.78),
    inset 2rpx 0 0 rgba(255, 255, 255, 0.14),
    inset 0 -2rpx 0 rgba(0, 0, 0, 0.18);
}
.ord__item-img { position: relative; width: 100%; height: 240rpx; border-radius: 16rpx; overflow: hidden; background: #111; }
.ord__item-pic { width: 100%; height: 100%; display: block; }
.ord__item-ph { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; padding: 20rpx; box-sizing: border-box; text-align: center; color: rgba(255,255,255,0.82); font-size: 22rpx; background: linear-gradient(160deg, #2a2622, #0e0d0c); }
.ord__soldout { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; background: rgba(0,0,0,0.5); color: #fff; font-size: 22rpx; }
.ord__item-name { display: block; margin-top: 14rpx; font-size: 24rpx; font-weight: 600; color: var(--ic-black); }
.ord__item-foot { margin-top: 8rpx; min-height: 82rpx; }
.ord__item-row {
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
}
.ord__item-yuan {
  min-width: 0;
  height: 48rpx;
  display: flex;
  align-items: center;
  font-size: 26rpx;
  line-height: 48rpx;
  font-weight: 700;
  color: var(--ic-black);
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
}
.ord__item-yuan--compact { font-size: 22rpx; }
.ord__item-stepper {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  min-width: 44rpx;
}
.ord__item-pay {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  line-height: 1.25;
  color: var(--ic-text-2);
  white-space: nowrap;
}
.ord__grid-gap { height: 20rpx; }

/* ---- bottom cart bar ---- */
.ord__cart {
  position: fixed; left: 0; right: 0; bottom: calc(100rpx + env(safe-area-inset-bottom));
  z-index: 50; display: flex; align-items: center; gap: 16rpx;
  height: 112rpx; padding: 0 20rpx 0 28rpx;
  background: var(--ic-white); border-top: 1rpx solid var(--ic-line);
  box-shadow: 0 -6rpx 24rpx rgba(0,0,0,0.05);
}
.ord__cart-summary { display: flex; align-items: center; gap: 16rpx; flex: none; }
.ord__cart-summary--hover { opacity: 0.72; }
.ord__cart-icon { position: relative; width: 72rpx; height: 72rpx; border-radius: 50%; background: var(--ic-fill); display: flex; align-items: center; justify-content: center; }
.ord__cart-icon.is-full { background: var(--ic-black); }
.ord__cart-icon.is-full .ic-ic { color: #fff; }
.ord__cart-badge { position: absolute; top: -6rpx; right: -6rpx; min-width: 30rpx; height: 30rpx; padding: 0 6rpx; box-sizing: border-box; border-radius: 999rpx; background: var(--ic-danger); color: #fff; font-size: 20rpx; line-height: 30rpx; text-align: center; }
.ord__cart-meta { display: flex; flex: none; width: 154rpx; flex-direction: column; }
.ord__cart-count { font-size: 24rpx; font-weight: 600; color: var(--ic-black); }
.ord__cart-hint { font-size: 20rpx; color: var(--ic-text-3); margin-top: 2rpx; white-space: nowrap; }
.ord__cart-total { flex: 1; min-width: 0; text-align: right; font-size: 28rpx; font-weight: 700; color: var(--ic-black); font-variant-numeric: tabular-nums; }
.ord__cart-btn {
  flex: none;
  width: 220rpx !important;
  min-width: 220rpx;
  max-width: 220rpx;
  height: 80rpx;
  margin-left: 0 !important;
  margin-right: 0 !important;
  padding: 0;
}

/* ---- store picker sheet ---- */
.ord-store-list { padding-bottom: 24rpx; }
.ord-store {
  min-height: 112rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--ic-line);
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.ord-store:last-child { border-bottom: none; }
.ord-store__main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 8rpx; }
.ord-store__name { font-size: 26rpx; font-weight: 700; color: var(--ic-black); }
.ord-store__addr { font-size: 22rpx; color: var(--ic-text-3); }
.ord-store__current {
  flex: none;
  height: 44rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: var(--ic-black);
  color: #fff;
  font-size: 20rpx;
  line-height: 44rpx;
}

/* ---- selected items sheet ---- */
.ord-cart-sheet__bar { height: 54rpx; display: flex; align-items: center; justify-content: space-between; border-bottom: 1rpx solid var(--ic-line); }
.ord-cart-sheet__count { font-size: 22rpx; color: var(--ic-text-3); }
.ord-cart-sheet__clear { padding: 10rpx 0 10rpx 24rpx; font-size: 22rpx; color: var(--ic-text-2); }
.ord-cart-sheet__list { padding-bottom: 8rpx; }
.ord-cart-sheet__item { min-height: 128rpx; padding: 20rpx 0; border-bottom: 1rpx solid var(--ic-line); display: flex; align-items: center; gap: 18rpx; box-sizing: border-box; }
.ord-cart-sheet__item:last-child { border-bottom: none; }
.ord-cart-sheet__image { width: 88rpx; height: 88rpx; flex: none; border-radius: 10rpx; background: var(--ic-fill); }
.ord-cart-sheet__image--empty { display: flex; align-items: center; justify-content: center; color: var(--ic-text-3); font-size: 24rpx; }
.ord-cart-sheet__info { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 10rpx; }
.ord-cart-sheet__name { display: block; font-size: 24rpx; font-weight: 600; color: var(--ic-black); }
.ord-cart-sheet__price { font-size: 20rpx; color: var(--ic-text-3); }
.ord-cart-sheet__action { flex: none; display: flex; flex-direction: column; align-items: flex-end; gap: 14rpx; }
.ord-cart-sheet__subtotal { font-size: 24rpx; font-weight: 600; color: var(--ic-black); font-variant-numeric: tabular-nums; }
.ord-cart-sheet__checkout { width: 100% !important; margin: 0 !important; }
