.franchise {
  min-height: 100vh;
  padding: 0 40rpx calc(56rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: var(--ic-white);
}

.franchise__hotline {
  min-height: 128rpx;
  padding: 20rpx 0;
  box-sizing: border-box;
  border-bottom: 1rpx solid var(--ic-line);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}
.franchise__hotline-label {
  flex: none;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--ic-black);
}
.franchise__hotline-value {
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  justify-content: flex-end;
  gap: 9rpx;
  font-size: 24rpx;
  color: var(--ic-black);
  font-variant-numeric: tabular-nums;
}
.franchise__hotline-number {
  font-size: 24rpx;
  line-height: 1.2;
  color: var(--ic-black);
}
.franchise__hotline-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 12rpx;
}
.franchise__hotline-action {
  font-size: 20rpx;
  line-height: 1.5;
  color: var(--ic-text-3);
}
.franchise__hotline-action--hover { color: var(--ic-black); }
.franchise__hotline-divider {
  width: 1rpx;
  height: 20rpx;
  background: var(--ic-line-strong);
}

.franchise__form {
  padding: 54rpx 0 0;
}
.franchise__title {
  display: block;
  margin-bottom: 42rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 750;
  line-height: 1.2;
  color: var(--ic-black);
}
.franchise__field { margin-top: 30rpx; }
.franchise__field:first-of-type { margin-top: 0; }
.franchise__field--source { margin-top: 36rpx; }
.franchise__label {
  display: block;
  margin-bottom: 16rpx;
  font-size: 24rpx;
  font-weight: 650;
  color: var(--ic-text-2);
}
.franchise__input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  border-radius: 12rpx;
  background: var(--ic-fill-2);
  font-size: 24rpx;
  color: var(--ic-black);
}
.franchise__input--error {
  box-shadow: inset 0 0 0 1rpx #d93025;
}
.franchise__error {
  display: block;
  margin-top: 10rpx;
  font-size: 20rpx;
  line-height: 1.4;
  color: #d93025;
}
.franchise__sources {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.franchise__source {
  min-width: 116rpx;
  height: 68rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  border: 1rpx solid transparent;
  border-radius: 10rpx;
  background: var(--ic-fill-2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: var(--ic-text-2);
}
.franchise__source--hover { opacity: 0.58; }
.franchise__source--active {
  border-color: var(--ic-black);
  background: var(--ic-black);
  color: var(--ic-white);
  font-weight: 650;
}
.franchise__source-empty {
  display: block;
  padding: 24rpx 0;
  font-size: 22rpx;
  color: var(--ic-text-3);
}
.franchise__submit {
  width: 100% !important;
  height: 88rpx;
  margin: 52rpx 0 0 !important;
  padding: 0;
  border-radius: 8rpx;
  background: var(--ic-black);
  color: var(--ic-white);
  font-size: 26rpx;
  font-weight: 700;
  line-height: 88rpx;
}
.franchise__submit::after { border: none; }
.franchise__submit[disabled] { background: var(--ic-fill); color: var(--ic-text-3); }
.franchise__privacy {
  display: block;
  margin-top: 18rpx;
  text-align: center;
  font-size: 20rpx;
  color: var(--ic-text-3);
}
