<view class="ic-scroll-shell">
<ic-page-nav title="个人资料" />
<scroll-view class="ic-scroll-view" scroll-y enhanced show-scrollbar="{{false}}" bounces="{{false}}">
<view class="pf">
  <view class="pf__section ic-glass-recessed">
    <view class="pf__row pf__row--avatar" hover-class="pf__row--hover" bindtap="chooseAvatar">
      <text class="pf__label">头像</text>
      <view class="pf__avatar">
        <image wx:if="{{me.avatarUrl}}" class="pf__avatar-img" src="{{me.avatarUrl}}" mode="aspectFill" />
        <view wx:else class="pf__avatar-ph"></view>
      </view>
      <text class="pf__hint">更换头像</text>
      <view class="ic-arrow"></view>
    </view>

    <view class="pf__row">
      <text class="pf__label">昵称</text>
      <input class="pf__input" maxlength="30" value="{{me.nickname}}" placeholder="设置昵称" placeholder-class="pf__ph" bindinput="onNickname" />
    </view>

    <view class="pf__row">
      <text class="pf__label">手机号</text>
      <text class="pf__value pf__phone-number">{{phoneMasked || '未绑定'}}</text>
      <button
        class="pf__phone-button {{phoneBinding ? 'pf__phone-button--loading' : ''}}"
        hover-class="pf__phone-button--hover"
        open-type="getPhoneNumber"
        disabled="{{phoneBinding}}"
        bindgetphonenumber="onGetPhoneNumber"
      >{{phoneBinding ? '获取中…' : (phoneMasked ? '更换' : '绑定')}}</button>
    </view>

    <view class="pf__row">
      <text class="pf__label">性别</text>
      <picker class="pf__picker" mode="selector" range="{{genderOptions}}" range-key="label" value="{{genderIndex}}" bindchange="onGenderChange">
        <view class="pf__picker-value">
          <image wx:if="{{genderIcon}}" class="pf__gender-icon" src="{{genderIcon}}" mode="aspectFit" />
          <text class="pf__value">{{genderLabel || '请选择'}}</text>
          <view class="ic-arrow"></view>
        </view>
      </picker>
    </view>

    <view class="pf__row">
      <text class="pf__label">会员等级</text>
      <text class="pf__value">{{me.tierName || 'VIP1'}}</text>
    </view>

    <view class="pf__row" hover-class="pf__row--hover" bindtap="copyInvite">
      <text class="pf__label">邀请码</text>
      <text class="pf__value">{{me.inviteCode || '--'}}</text>
      <view class="ic-ic ic-ic-copy ic-ic--sm"></view>
    </view>

    <view class="pf__row pf__row--last" hover-class="pf__row--hover" bindtap="bindInviter">
      <text class="pf__label">绑定邀请人</text>
      <text class="pf__value">{{me.inviterBound ? '已绑定' : '未绑定'}}</text>
      <view wx:if="{{!me.inviterBound}}" class="ic-arrow"></view>
    </view>
  </view>

  <text class="pf__note">资料仅用于会员权益和订单通知</text>

  <view class="pf__save">
    <button class="ic-btn ic-btn-primary ic-btn-block pf__save-btn" loading="{{saving}}" bindtap="save">保存</button>
  </view>
</view>
</scroll-view>
</view>
