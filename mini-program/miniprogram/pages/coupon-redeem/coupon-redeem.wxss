.cr { height: 100vh; display: flex; flex-direction: column; box-sizing: border-box; background: var(--ic-bg); }

.cr__nav {
  flex: none;
  background: var(--ic-white);
  border-bottom: 1rpx solid var(--ic-line);
}
.cr__nav-bar {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}
.cr__nav-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--ic-black);
}
.cr__nav-store {
  position: absolute;
  left: 24rpx;
  top: 0;
  bottom: 0;
  width: 300rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.cr__nav-loc {
  width: 30rpx;
  height: 30rpx;
  flex: none;
}
.cr__nav-name {
  display: block;
  min-width: 0;
  flex: 1;
  font-size: 24rpx;
  font-weight: 400;
  color: var(--ic-black);
}

.cr__body { flex: 1; display: flex; min-height: 0; }

/* ---- left category rail ---- */
.cr__cats { width: 150rpx; flex: none; background: #f7f7f7; height: 100%; box-sizing: border-box; border-right: 1rpx solid var(--ic-line); }
.cr__cat {
  height: 104rpx;
  padding: 0 22rpx 0 28rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #777777;
  position: relative;
}
.cr__cat.is-active { background: var(--ic-white); color: var(--ic-black); font-weight: 700; }
.cr__cat.is-active::before {
  content: "";
  position: absolute;
  left: 0;
  top: 28rpx;
  bottom: 28rpx;
  width: 5rpx;
  border-radius: 5rpx;
  background: var(--ic-black);
}

/* ---- right item grid ---- */
.cr__items { flex: 1; height: 100%; box-sizing: border-box; padding: 0 18rpx; padding-bottom: calc(260rpx + env(safe-area-inset-bottom)); }
.cr__group-title { padding: 26rpx 8rpx 12rpx; font-size: 28rpx; font-weight: 700; color: var(--ic-text-2); }
.cr__grid { display: flex; flex-wrap: wrap; justify-content: space-between; }
.cr__item { width: 48%; margin-bottom: 34rpx; box-sizing: border-box; }
.cr__item-img { position: relative; width: 100%; height: 240rpx; border-radius: 16rpx; overflow: hidden; background: #111; }
.cr__item-pic { width: 100%; height: 100%; display: block; }
.cr__item-ph { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; padding: 20rpx; box-sizing: border-box; text-align: center; color: rgba(255,255,255,0.82); font-size: 24rpx; background: linear-gradient(160deg, #2a2622, #0e0d0c); }
.cr__soldout { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; background: rgba(0,0,0,0.5); color: #fff; font-size: 24rpx; }
.cr__item-name { display: block; margin-top: 14rpx; font-size: 28rpx; font-weight: 600; color: var(--ic-black); }
.cr__item-foot { margin-top: 8rpx; min-height: 56rpx; }
.cr__item-row {
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
}
.cr__item-yuan {
  min-width: 0;
  height: 48rpx;
  display: flex;
  align-items: center;
  font-size: 30rpx;
  line-height: 48rpx;
  font-weight: 700;
  color: var(--ic-black);
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
}
.cr__item-yuan--compact { font-size: 24rpx; }
.cr__item-stepper {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  min-width: 44rpx;
}
.cr__grid-gap { height: 20rpx; }

/* ---- bottom redeem bar ---- */
.cr__bar {
  position: fixed; left: 0; right: 0; bottom: 0;
  z-index: 50; display: flex; align-items: center; gap: 20rpx;
  height: 112rpx; padding: 0 24rpx calc(env(safe-area-inset-bottom)) 32rpx;
  box-sizing: content-box;
  background: var(--ic-white); border-top: 1rpx solid var(--ic-line);
  box-shadow: 0 -6rpx 24rpx rgba(0,0,0,0.05);
}
.cr__bar-meta { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4rpx; }
.cr__bar-line { display: flex; align-items: baseline; gap: 10rpx; }
.cr__bar-label { font-size: 24rpx; color: var(--ic-text-3); }
.cr__bar-total { font-size: 40rpx; font-weight: 700; color: var(--ic-black); font-variant-numeric: tabular-nums; }
.cr__bar-sub { font-size: 22rpx; color: var(--ic-text-4); }
.cr__bar-remain { font-size: 22rpx; color: var(--ic-text-3); }
.cr__bar-over { font-size: 22rpx; font-weight: 600; color: var(--ic-danger); }
.cr__bar-btn { flex: none; height: 80rpx; padding: 0 40rpx; }
