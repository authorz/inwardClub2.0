.cr { position: relative; z-index: 1; height: 100vh; display: flex; flex-direction: column; box-sizing: border-box; background: transparent; color: #fff; }

.cr__coupon { flex: none; min-height: 104rpx; margin: 16rpx 24rpx 4rpx; padding: 20rpx 24rpx; border-radius: 20rpx; display: flex; align-items: center; gap: 20rpx; box-sizing: border-box; }
.cr__coupon-main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 8rpx; }
.cr__coupon-head { display: flex; align-items: center; gap: 12rpx; min-width: 0; }
.cr__coupon-type { flex: none; padding: 5rpx 12rpx; border: 1rpx solid rgba(255,255,255,.3); border-radius: 999rpx; font-size: 18rpx; line-height: 1.2; color: rgba(255,255,255,.82); }
.cr__coupon-name { min-width: 0; font-size: 24rpx; font-weight: 700; color: rgba(255,255,255,.96); }
.cr__coupon-valid { font-size: 19rpx; color: rgba(255,255,255,.52); }
.cr__coupon-value { flex: none; display: flex; align-items: baseline; color: rgba(255,255,255,.98); }
.cr__coupon-symbol { font-size: 22rpx; font-weight: 700; }
.cr__coupon-amount { font-size: 36rpx; line-height: 1; font-weight: 800; font-variant-numeric: tabular-nums; }

.cr__items { flex: 1; min-height: 0; height: 100%; box-sizing: border-box; padding: 0 24rpx; padding-bottom: calc(188rpx + env(safe-area-inset-bottom)); }
.cr__group-title { padding: 26rpx 4rpx 16rpx; font-size: 22rpx; font-weight: 600; color: rgba(255,255,255,.72); }
.cr__grid { display: flex; flex-wrap: wrap; justify-content: space-between; }
.cr__item { width: 48.4%; margin-bottom: 20rpx; padding: 10rpx 10rpx 16rpx; box-sizing: border-box; overflow: hidden; }
.cr__item.ic-glass-recessed { border-color: rgba(255,255,255,.22); border-radius: 24rpx; background: rgba(188,199,213,.22); -webkit-backdrop-filter: blur(38rpx) saturate(150%) brightness(1.06); backdrop-filter: blur(38rpx) saturate(150%) brightness(1.06); box-shadow: inset 0 5rpx 9rpx rgba(4,7,11,.25), inset 0 -2rpx 3rpx rgba(255,255,255,.17), inset 1rpx 0 2rpx rgba(0,0,0,.07), inset -1rpx 0 2rpx rgba(255,255,255,.06); }
.cr__item.ic-glass-recessed::before { right: 14rpx; left: 14rpx; height: 38rpx; border-radius: 24rpx 24rpx 40% 40%; }
.cr__item-img { position: relative; width: 100%; height: 276rpx; border: 1rpx solid rgba(255,255,255,.12); border-radius: 16rpx; overflow: hidden; background: #111; box-sizing: border-box; }
.cr__item-pic { width: 100%; height: 100%; display: block; }
.cr__item-ph { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; padding: 20rpx; box-sizing: border-box; text-align: center; color: rgba(255,255,255,.82); font-size: 22rpx; background: linear-gradient(160deg,#2a2622,#0e0d0c); }
.cr__soldout { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; background: rgba(0,0,0,.56); color: #fff; font-size: 22rpx; }
.cr__item-name { display: block; margin-top: 14rpx; padding: 0 4rpx; font-size: 24rpx; font-weight: 650; color: rgba(255,255,255,.96); }
.cr__item-foot { margin-top: 8rpx; min-height: 82rpx; padding: 0 4rpx; }
.cr__item-row { height: 48rpx; display: flex; align-items: center; justify-content: space-between; gap: 8rpx; }
.cr__item-yuan { min-width: 0; height: 48rpx; display: flex; align-items: center; font-size: 26rpx; line-height: 48rpx; font-weight: 700; color: rgba(255,255,255,.94); font-variant-numeric: tabular-nums; white-space: nowrap; }
.cr__item-yuan--compact { font-size: 22rpx; }
.cr__item-stepper { flex: none; display: flex; align-items: center; justify-content: flex-end; min-width: 44rpx; }
.cr__item-hint { display: block; margin-top: 4rpx; font-size: 20rpx; line-height: 1.25; color: rgba(255,255,255,.5); white-space: nowrap; }
.cr__grid-gap { height: 24rpx; }

.cr__bar { position: fixed; left: 20rpx; right: 20rpx; bottom: calc(20rpx + env(safe-area-inset-bottom)); z-index: 50; display: flex; align-items: center; gap: 14rpx; height: 112rpx; padding: 0 18rpx 0 24rpx; box-sizing: border-box; }
.cr__summary { display: flex; align-items: center; gap: 14rpx; flex: none; }
.cr__summary--hover { opacity: .72; }
.cr__bag { position: relative; width: 68rpx; height: 68rpx; border-radius: 50%; background: rgba(255,255,255,.1); color: rgba(255,255,255,.8); display: flex; align-items: center; justify-content: center; }
.cr__bag.is-full { background: var(--ic-black); }
.cr__badge { position: absolute; top: -6rpx; right: -6rpx; min-width: 30rpx; height: 30rpx; padding: 0 6rpx; box-sizing: border-box; border-radius: 999rpx; background: var(--ic-danger); color: #fff; font-size: 20rpx; line-height: 30rpx; text-align: center; }
.cr__meta { display: flex; width: 126rpx; flex-direction: column; }
.cr__count { font-size: 22rpx; font-weight: 600; color: rgba(255,255,255,.94); white-space: nowrap; }
.cr__remain { margin-top: 2rpx; font-size: 18rpx; color: rgba(255,255,255,.5); white-space: nowrap; }
.cr__total { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: flex-end; }
.cr__total-label { font-size: 18rpx; color: rgba(255,255,255,.5); }
.cr__total-value { font-size: 26rpx; font-weight: 700; color: rgba(255,255,255,.96); font-variant-numeric: tabular-nums; white-space: nowrap; }
.cr__bar-btn { flex: none; width: 190rpx !important; min-width: 190rpx; height: 80rpx; margin: 0 !important; padding: 0; }

.cr-store-list { padding-bottom: 24rpx; }
.cr-store { min-height: 112rpx; padding: 24rpx 0; border-bottom: 1rpx solid var(--ic-line); display: flex; align-items: center; gap: 20rpx; }
.cr-store:last-child { border-bottom: none; }
.cr-store__main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 8rpx; }
.cr-store__name { font-size: 26rpx; font-weight: 700; color: var(--ic-black); }
.cr-store__addr { font-size: 22rpx; color: var(--ic-text-3); }
.cr-store__current { flex: none; height: 44rpx; padding: 0 18rpx; border-radius: 999rpx; background: var(--ic-black); color: #fff; font-size: 20rpx; line-height: 44rpx; }

.cr-sheet__bar { height: 54rpx; display: flex; align-items: center; justify-content: space-between; border-bottom: 1rpx solid var(--ic-line); }
.cr-sheet__count { font-size: 22rpx; color: var(--ic-text-3); }
.cr-sheet__clear { padding: 10rpx 0 10rpx 24rpx; font-size: 22rpx; color: var(--ic-text-2); }
.cr-sheet__list { padding-bottom: 8rpx; }
.cr-sheet__item { min-height: 128rpx; padding: 20rpx 0; border-bottom: 1rpx solid var(--ic-line); display: flex; align-items: center; gap: 18rpx; box-sizing: border-box; }
.cr-sheet__item:last-child { border-bottom: none; }
.cr-sheet__image { width: 88rpx; height: 88rpx; flex: none; border-radius: 10rpx; background: var(--ic-fill); }
.cr-sheet__image--empty { display: flex; align-items: center; justify-content: center; color: var(--ic-text-3); font-size: 24rpx; }
.cr-sheet__info { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 10rpx; }
.cr-sheet__name { display: block; font-size: 24rpx; font-weight: 600; color: var(--ic-black); }
.cr-sheet__price { font-size: 20rpx; color: var(--ic-text-3); }
.cr-sheet__action { flex: none; display: flex; flex-direction: column; align-items: flex-end; gap: 14rpx; }
.cr-sheet__subtotal { font-size: 24rpx; font-weight: 600; color: var(--ic-black); font-variant-numeric: tabular-nums; }
.cr-sheet__confirm { width: 100% !important; margin: 0 !important; }

.cr-modal { position: fixed; inset: 0; z-index: 120; display: flex; align-items: center; justify-content: center; padding: 48rpx; box-sizing: border-box; background: rgba(0,0,0,.58); }
.cr-modal__panel { width: 100%; max-width: 620rpx; padding: 38rpx 34rpx 30rpx; border-radius: 30rpx; box-sizing: border-box; display: flex; flex-direction: column; background: rgba(20,24,30,.84); -webkit-backdrop-filter: blur(44rpx) saturate(145%); backdrop-filter: blur(44rpx) saturate(145%); }
.cr-modal__title { font-size: 30rpx; font-weight: 750; color: #fff; text-align: center; }
.cr-modal__warning { margin-top: 28rpx; font-size: 26rpx; line-height: 1.55; font-weight: 800; color: #fff; text-align: center; }
.cr-modal__message { margin-top: 16rpx; font-size: 23rpx; line-height: 1.65; color: rgba(255,255,255,.7); text-align: center; }
.cr-modal__actions { margin-top: 34rpx; display: flex; gap: 16rpx; }
.cr-modal__button { flex: 1; height: 78rpx; margin: 0; padding: 0; border-radius: 999rpx; font-size: 24rpx; font-weight: 700; line-height: 78rpx; border: 1rpx solid rgba(255,255,255,.18); }
.cr-modal__button::after { border: none; }
.cr-modal__button--secondary { background: rgba(255,255,255,.1); color: rgba(255,255,255,.82); }
.cr-modal__button--primary { background: #fff; color: #111; }
