.oce { min-height: 0; padding: 28rpx 24rpx calc(48rpx + env(safe-area-inset-bottom)); background: transparent; box-sizing: border-box; }
.oce__filters { padding: 12rpx 18rpx 18rpx; }
.oce__types { padding: 0 6rpx; }
.oce__status { padding: 8rpx 0 0; }
.oce__list { margin-top: 24rpx; }
.oce__item { margin-bottom: 20rpx; }
.oce__item:last-child { margin-bottom: 0; }
