.svl__scroll { background: var(--ic-bg); }
.svl { min-height: 0; background: var(--ic-bg); padding: 24rpx 24rpx calc(24rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
.svl__list { padding: 0 32rpx; }
.svl__row { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; padding: 28rpx 0; border-bottom: 1rpx solid var(--ic-line); }
.svl__row:last-child { border-bottom: none; }
.svl__main { display: flex; flex-direction: column; gap: 8rpx; min-width: 0; }
.svl__activity { font-size: 24rpx; color: var(--ic-black); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.svl__code { font-size: 22rpx; color: var(--ic-text-2); letter-spacing: 1rpx; }
.svl__time { font-size: 20rpx; color: var(--ic-text-3); }
.svl__result { font-size: 22rpx; flex: none; }
.svl__result.is-ok { color: var(--ic-black); }
.svl__result.is-fail { color: var(--ic-text-3); }
.svl__state { padding: 100rpx 0; display: flex; flex-direction: column; align-items: center; gap: 22rpx; }
.svl__state-text, .svl__footer { font-size: 21rpx; color: var(--ic-text-3); text-align: center; }
.svl__retry { min-width: 168rpx; height: 64rpx; margin: 0; padding: 0 28rpx; border: 1rpx solid var(--ic-line-strong); border-radius: 999rpx; background: transparent; font-size: 22rpx; line-height: 62rpx; color: var(--ic-black); }
.svl__retry::after { border: none; }
.svl__footer { padding: 28rpx 0 12rpx; }
