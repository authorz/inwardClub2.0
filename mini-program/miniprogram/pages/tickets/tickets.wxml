<page-meta page-style="{{showCodeModal ? 'overflow: hidden;' : ''}}" />
<view class="tk">
  <view class="tk__seg">
    <ic-segmented options="{{statusOptions}}" value="{{bucket}}" variant="line" bind:change="onStatusChange" />
  </view>

  <ic-loading wx:if="{{loading}}" theme="dark" />
  <view wx:elif="{{!list.length}}" class="tk__empty">
    <image
      class="tk__empty-image"
      src="https://assets.inwardclub.com/public/images/activity-empty.png"
      mode="aspectFit"
    />
    <text class="tk__empty-text">这里还是空空的</text>
    <navigator
      class="tk__empty-action"
      url="/pages/activity-list/activity-list"
      hover-class="tk__empty-action--hover"
    >去探索</navigator>
  </view>

  <view wx:else class="tk__list">
    <view class="tk__card {{item.usable ? '' : 'is-dim'}}" wx:for="{{list}}" wx:key="id">
      <view class="tk__poster" data-id="{{item.id}}" bindtap="goDetail">
        <image wx:if="{{item.imageUrl}}" class="tk__poster-img" src="{{item.imageUrl}}" mode="aspectFit" />
        <view wx:else class="tk__poster-ph tk__poster-ph--{{item.tone}}">
          <text class="tk__poster-sub">INWARD CLUB</text>
          <text class="tk__poster-title">{{item.title}}</text>
        </view>
      </view>
      <view class="tk__main">
        <text class="tk__title">{{item.title}}</text>
        <view class="tk__meta">
          <image class="tk__meta-icon" src="/assets/icons/ticket-time.svg" mode="aspectFit" />
          <text class="tk__time">{{item.timeText}}</text>
        </view>
        <view class="tk__meta">
          <image class="tk__meta-icon" src="/assets/icons/location.svg" mode="aspectFit" />
          <text class="tk__store ic-ellipsis">{{item.storeName}}</text>
        </view>
        <text class="tk__ticket">{{item.ticketName}} x{{item.qty}}</text>
      </view>
      <view class="tk__action">
        <view class="tk__status tk__status--{{item.bucket}}">
          <view class="tk__status-dot"></view>
          <text class="tk__status-text">{{item.statusLabel}}</text>
        </view>
        <view
          wx:if="{{item.usable}}"
          class="tk__codebtn"
          data-id="{{item.id}}"
          bindtap="showCode"
          hover-class="tk__codebtn--hover"
        >
          <image class="tk__qricon" src="/assets/icons/ticket-qr.svg" mode="aspectFit" />
          <text class="tk__codehint">出示二维码</text>
        </view>
        <text wx:else class="tk__view" data-id="{{item.id}}" bindtap="goDetail">查看详情</text>
      </view>
    </view>
  </view>
</view>

<view wx:if="{{showCodeModal}}" class="tc-modal">
  <view class="tc-modal__mask"></view>
  <scroll-view class="tc-modal__scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="tc-modal__chrome">
      <text class="tc-modal__label">出示二维码</text>
      <view class="tc-modal__close" bindtap="closeCode" hover-class="tc-modal__close--hover" aria-label="关闭二维码弹窗">
        <view class="tc-modal__x"></view>
      </view>
    </view>

    <view class="tc tc--modal">
      <view class="tc__ticket" catchtap="noop">
        <view class="tc__head">
          <view class="tc__head-main">
            <text class="tc__title">{{codeTicket.title}}</text>
            <text class="tc__type">{{codeTicket.ticketName}} · {{codeTicket.qty}} 张</text>
            <view class="tc__facts">
              <view class="tc__fact">
                <text class="tc__fact-label">日期</text>
                <text class="tc__fact-value">{{codeTicket.dateText}}</text>
              </view>
              <view class="tc__fact tc__fact--wide">
                <text class="tc__fact-label">活动时间</text>
                <text class="tc__fact-value">{{codeTicket.clockText || '待定'}}</text>
              </view>
              <view class="tc__fact tc__fact--location">
                <text class="tc__fact-label">活动地点</text>
                <text class="tc__fact-value ic-ellipsis">{{codeTicket.storeName}}</text>
              </view>
            </view>
          </view>
          <view class="tc__poster">
            <image wx:if="{{codeTicket.imageUrl}}" class="tc__poster-image" src="{{codeTicket.imageUrl}}" mode="aspectFill" />
            <view wx:else class="tc__poster-placeholder tc__poster-placeholder--{{codeTicket.tone}}">
              <text>INWARD</text>
            </view>
          </view>
        </view>

        <view class="tc__cut">
          <view class="tc__cut-line"></view>
        </view>

        <view class="tc__body">
          <view class="tc__body-head">
            <text class="tc__body-title">扫码入场</text>
            <text class="tc__status">{{codeTicket.statusLabel}}</text>
          </view>

          <view class="tc__qr {{codeTicket.usable ? '' : 'is-disabled'}}">
            <view class="ic-qr">
              <view class="ic-qr__row" wx:for="{{qr}}" wx:for-item="row" wx:key="id">
                <view class="ic-qr__cell {{cell.on ? 'ic-qr__cell--on' : ''}}" wx:for="{{row.cells}}" wx:for-item="cell" wx:key="id"></view>
              </view>
            </view>
            <view wx:if="{{!codeTicket.usable}}" class="tc__stamp">{{codeTicket.statusLabel}}</view>
          </view>

          <view class="tc__code" bindtap="copyCode" hover-class="tc__code--hover">
            <text class="tc__code-label">核销码</text>
            <text class="tc__code-num">{{codeTicket.code}}</text>
            <view class="ic-ic ic-ic-copy ic-ic--sm"></view>
          </view>
          <text class="tc__hint">请向工作人员出示此页面，核销前请勿关闭</text>
        </view>
      </view>
    </view>
  </scroll-view>
</view>
