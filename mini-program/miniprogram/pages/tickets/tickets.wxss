.tk {
  --ic-black: #e8e8e8;
  --ic-ink: #dedede;
  --ic-text: #d2d2d2;
  --ic-text-2: #b8b8b8;
  --ic-text-3: #929292;
  --ic-text-4: #929292;
  --ic-line: #242424;
  --ic-line-strong: #353535;
  --ic-bg: #000000;
  --ic-bg-soft: #0a0a0a;
  --ic-bg-2: #111111;
  --ic-fill: #151515;
  --ic-fill-2: #1b1b1b;
  --ic-white: #000000;
  min-height: 100vh;
  background: #000000;
  color: #d2d2d2;
}
.tk__seg { padding: 0 24rpx; background: #000000; border-bottom: 1rpx solid #242424; }
.tk__list { padding: 0 32rpx; background: #000000; }
.tk__empty {
  min-height: 760rpx;
  padding: 248rpx 48rpx 160rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}
.tk__empty-image { width: 400rpx; height: 400rpx; display: block; opacity: 0.72; }
.tk__empty-text { margin-top: 48rpx; font-size: 26rpx; line-height: 1.5; font-weight: 600; color: #a6a6a6; }
.tk__empty-action {
  min-width: 176rpx;
  height: 72rpx;
  margin-top: 36rpx;
  padding: 0 36rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: #2d2d2d;
  color: #dedede;
  font-size: 26rpx;
  line-height: 72rpx;
}
.tk__empty-action--hover { background: #3a3a3a; }
.tk__card { display: flex; align-items: flex-start; gap: 24rpx; padding: 28rpx 0; border-bottom: 1rpx solid var(--ic-line); }
.tk__card:last-child { border-bottom: none; }
.tk__card.is-dim { opacity: 0.82; }
.tk__poster { width: 168rpx; height: 168rpx; flex: none; overflow: hidden; background: var(--ic-fill); border-radius: 8rpx; display: flex; align-items: center; justify-content: center; }
.tk__poster-img { width: 100%; height: 100%; display: block; }
.tk__poster-ph { width: 100%; height: 100%; box-sizing: border-box; padding: 16rpx 10rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; background: #111111; color: #e8e8e8; }
.tk__poster-ph--member { background: #d8d5cc; color: #171717; }
.tk__poster-sub { font-size: 16rpx; letter-spacing: 4rpx; opacity: 0.62; }
.tk__poster-title { max-width: 100%; margin-top: 12rpx; font-size: 24rpx; line-height: 1.18; font-weight: 700; overflow: hidden; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.tk__main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 11rpx; }
.tk__title { display: block; max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 26rpx; font-weight: 700; color: var(--ic-black); }
.tk__meta { display: flex; align-items: center; gap: 8rpx; min-width: 0; }
.tk__meta-icon { width: 26rpx; height: 26rpx; flex: none; display: block; filter: invert(1); opacity: 0.64; }
.tk__time { font-size: 22rpx; color: var(--ic-text-2); }
.tk__store { flex: 1; min-width: 0; font-size: 20rpx; color: var(--ic-text-3); }
.tk__ticket { margin-top: 4rpx; font-size: 22rpx; color: var(--ic-text); }
.tk__action { width: 136rpx; flex: none; display: flex; flex-direction: column; align-items: center; justify-content: flex-start; gap: 18rpx; align-self: stretch; padding-top: 0; }
.tk__status { display: flex; align-items: center; justify-content: center; gap: 8rpx; height: 34rpx; line-height: 34rpx; color: var(--ic-black); }
.tk__status--used { color: var(--ic-text-2); }
.tk__status--expired { color: var(--ic-text-4); }
.tk__status-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: currentColor; flex: none; }
.tk__status-text { font-size: 22rpx; color: currentColor; white-space: nowrap; }
.tk__view { font-size: 22rpx; color: var(--ic-text-3); }
.tk__codebtn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  width: 136rpx;
  color: var(--ic-black);
}
.tk__codebtn--hover { opacity: 0.72; }
.tk__qricon { width: 48rpx; height: 48rpx; display: block; filter: invert(1); opacity: 0.9; }
.tk__codehint { display: block; width: 120rpx; font-size: 20rpx; line-height: 1.25; color: var(--ic-text-3); text-align: center; }

/* 出示二维码弹窗：内部票券内容与原 ticket-code 页面保持一致。 */
.tc-modal { position: fixed; inset: 0; z-index: 1000; }
.tc-modal__mask { position: absolute; inset: 0; background: rgba(0, 0, 0, 0.92); }
.tc-modal__scroll { position: relative; z-index: 1; width: 100%; height: 100%; }
.tc-modal__chrome {
  height: 88rpx;
  padding: 0 28rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.tc-modal__label { font-size: 26rpx; font-weight: 600; color: #f2f2f2; }
.tc-modal__close {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #202020;
}
.tc-modal__close--hover { background: #303030; }
.tc-modal__x { position: relative; width: 26rpx; height: 26rpx; }
.tc-modal__x::before,
.tc-modal__x::after {
  content: "";
  position: absolute;
  top: 12rpx;
  left: 0;
  width: 26rpx;
  height: 2rpx;
  background: #f2f2f2;
}
.tc-modal__x::before { transform: rotate(45deg); }
.tc-modal__x::after { transform: rotate(-45deg); }

.tc {
  min-height: 100vh;
  padding: 32rpx 28rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #000000;
  color: #171717;
}
.tc--modal { min-height: auto; padding-top: 0; background: transparent; }
.tc__ticket {
  position: relative;
  width: 100%;
  max-width: 694rpx;
  margin: 0 auto;
  overflow: hidden;
  border-radius: 16rpx;
  background: #ffffff;
}
.tc__ticket::before {
  content: "";
  position: absolute;
  z-index: 1;
  top: -34rpx;
  left: 50%;
  width: 68rpx;
  height: 68rpx;
  margin-left: -34rpx;
  border-radius: 50%;
  background: #000000;
}

.tc__head {
  min-height: 330rpx;
  padding: 46rpx 40rpx 38rpx;
  box-sizing: border-box;
  display: flex;
  gap: 28rpx;
}
.tc__head-main { flex: 1; min-width: 0; }
.tc__title {
  display: block;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 36rpx;
  line-height: 1.25;
  font-weight: 700;
  color: #171717;
}
.tc__type { display: block; margin-top: 14rpx; font-size: 24rpx; color: #555555; }
.tc__facts { margin-top: 40rpx; display: flex; flex-wrap: wrap; row-gap: 26rpx; }
.tc__fact { width: 34%; min-width: 0; display: flex; flex-direction: column; gap: 5rpx; }
.tc__fact--wide { width: 66%; }
.tc__fact--location { width: 100%; }
.tc__fact-label { font-size: 19rpx; line-height: 1.4; color: #777777; }
.tc__fact-value { max-width: 100%; font-size: 26rpx; line-height: 1.35; font-weight: 600; color: #202020; }
.tc__poster {
  width: 124rpx;
  height: 160rpx;
  flex: none;
  overflow: hidden;
  border-radius: 8rpx;
  background: #eeeeee;
}
.tc__poster-image { width: 100%; height: 100%; display: block; }
.tc__poster-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #151515;
  color: #ffffff;
  font-size: 16rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}
.tc__poster-placeholder--member { background: #d8d5cc; color: #171717; }

.tc__cut { position: relative; height: 34rpx; background: #ffffff; }
.tc__cut::before,
.tc__cut::after {
  content: "";
  position: absolute;
  top: 0;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: #000000;
}
.tc__cut::before { left: -17rpx; }
.tc__cut::after { right: -17rpx; }
.tc__cut-line {
  position: absolute;
  left: 34rpx;
  right: 34rpx;
  top: 16rpx;
  border-top: 2rpx dashed #e6e6e6;
}

.tc__body { padding: 30rpx 40rpx 46rpx; display: flex; flex-direction: column; align-items: center; }
.tc__body-head { width: 100%; display: flex; align-items: center; justify-content: space-between; }
.tc__body-title { font-size: 30rpx; line-height: 1.4; font-weight: 700; color: #171717; }
.tc__status { font-size: 21rpx; color: #666666; }
.tc__qr { position: relative; margin-top: 40rpx; }
.tc__qr .ic-qr { padding: 64rpx; border: none; border-radius: 0; }
.tc__qr .ic-qr__cell { width: 16rpx; height: 16rpx; }
.tc__qr.is-disabled .ic-qr { opacity: 0.3; }
.tc__stamp {
  position: absolute;
  right: -10rpx;
  bottom: 16rpx;
  min-width: 126rpx;
  height: 70rpx;
  padding: 0 18rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid #d96b6b;
  border-radius: 50%;
  transform: rotate(-12deg);
  color: #c95050;
  font-size: 24rpx;
  font-weight: 700;
}
.tc__code {
  width: 100%;
  min-height: 96rpx;
  margin-top: 34rpx;
  padding: 0 26rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  border: 1rpx solid #e4e4e4;
  border-radius: 12rpx;
}
.tc__code--hover { background: #f5f5f5; }
.tc__code-label { font-size: 22rpx; color: #777777; }
.tc__code-num { font-size: 28rpx; font-weight: 700; color: #202020; letter-spacing: 3rpx; font-variant-numeric: tabular-nums; }
.tc__code .ic-ic { color: #777777; }
.tc__hint { margin-top: 22rpx; font-size: 21rpx; line-height: 1.5; color: #777777; text-align: center; }
