.tk {
  --ic-black: #e8e8e8;
  --ic-ink: #dedede;
  --ic-text: #d2d2d2;
  --ic-text-2: #b8b8b8;
  --ic-text-3: #929292;
  --ic-text-4: #929292;
  --ic-line: #242424;
  --ic-line-strong: #353535;
  --ic-bg: #000000;
  --ic-bg-soft: #0a0a0a;
  --ic-bg-2: #111111;
  --ic-fill: #151515;
  --ic-fill-2: #1b1b1b;
  --ic-white: #000000;
  min-height: 100vh;
  background: #000000;
  color: #d2d2d2;
}
.tk__seg { padding: 0 24rpx; background: #000000; border-bottom: 1rpx solid #242424; }
.tk__empty {
  min-height: 760rpx;
  padding: 248rpx 48rpx 160rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}
.tk__empty-image { width: 400rpx; height: 400rpx; display: block; opacity: 0.72; }
.tk__empty-text { margin-top: 48rpx; font-size: 26rpx; line-height: 1.5; font-weight: 600; color: #a6a6a6; }
.tk__empty-action {
  min-width: 176rpx;
  height: 72rpx;
  margin-top: 36rpx;
  padding: 0 36rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: #2d2d2d;
  color: #dedede;
  font-size: 26rpx;
  line-height: 72rpx;
}
.tk__empty-action--hover { background: #3a3a3a; }
.tk__wallet { padding: 38rpx 28rpx calc(56rpx + env(safe-area-inset-bottom)); }
.tk__wallet-head {
  padding: 0 4rpx 26rpx;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}
.tk__wallet-count { font-size: 25rpx; line-height: 1.4; font-weight: 600; color: #e8e8e8; }
.tk__wallet-nav { display: flex; align-items: baseline; gap: 14rpx; }
.tk__wallet-index { font-size: 21rpx; line-height: 1.4; color: #d2d2d2; font-variant-numeric: tabular-nums; }
.tk__wallet-hint { font-size: 21rpx; line-height: 1.4; color: #929292; }
.tk__carousel { width: 100%; height: 450rpx; }
.tk__carousel--multiple { height: 510rpx; }
.tk__slide { box-sizing: border-box; padding: 0 8rpx 20rpx; }
.tk__pass {
  position: relative;
  height: 430rpx;
  overflow: hidden;
  border-radius: 22rpx;
  background: #f7f7f7;
  color: #171717;
  box-shadow: 0 -4rpx 0 rgba(255, 255, 255, 0.16);
  transition: transform 180ms cubic-bezier(0.22, 1, 0.36, 1), opacity 180ms ease-out;
}
.tk__pass.is-dim { filter: saturate(0.25); }
.tk__pass--pressed { transform: scale(0.99); }
.tk__pass-head {
  height: 116rpx;
  padding: 22rpx 26rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  background: #1b1b1b;
  color: #f5f5f5;
}
.tk__pass-head--poker { background: #1b1916; color: #eadbc3; }
.tk__pass-head--coast { background: #dfe8e8; color: #182122; }
.tk__pass-head--city { background: #303944; color: #f4f5f6; }
.tk__pass-head--member { background: #d9d4c8; color: #171717; }
.tk__pass-heading { flex: 1; min-width: 0; }
.tk__pass-brand {
  display: block;
  font-size: 15rpx;
  line-height: 1.2;
  font-weight: 600;
  letter-spacing: 3rpx;
  opacity: 0.66;
}
.tk__pass-title {
  display: block;
  margin-top: 7rpx;
  font-size: 28rpx;
  line-height: 1.2;
  font-weight: 700;
  color: currentColor;
}
.tk__status { flex: none; display: flex; align-items: center; gap: 8rpx; color: currentColor; }
.tk__status--used,
.tk__status--expired { opacity: 0.66; }
.tk__status-dot { width: 10rpx; height: 10rpx; border-radius: 50%; background: currentColor; flex: none; }
.tk__status-text { font-size: 20rpx; line-height: 1.3; color: currentColor; white-space: nowrap; }
.tk__pass-body {
  height: 200rpx;
  padding: 28rpx 26rpx 20rpx;
  box-sizing: border-box;
  display: flex;
  gap: 24rpx;
  background: #f7f7f7;
}
.tk__pass-facts { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 22rpx; }
.tk__pass-fact { min-width: 0; display: flex; flex-direction: column; gap: 5rpx; }
.tk__pass-label { font-size: 18rpx; line-height: 1.35; color: #777777; }
.tk__pass-value {
  max-width: 100%;
  font-size: 24rpx;
  line-height: 1.35;
  font-weight: 600;
  color: #222222;
}
.tk__poster {
  width: 116rpx;
  height: 150rpx;
  flex: none;
  overflow: hidden;
  border-radius: 8rpx;
  background: #e7e7e7;
  display: flex;
  align-items: center;
  justify-content: center;
}
.tk__poster-img { width: 100%; height: 100%; display: block; }
.tk__poster-ph { width: 100%; height: 100%; box-sizing: border-box; padding: 16rpx 10rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; background: #111111; color: #e8e8e8; }
.tk__poster-ph--coast { background: #dfe8e8; color: #182122; }
.tk__poster-ph--city { background: #303944; color: #f4f5f6; }
.tk__poster-ph--member { background: #d8d5cc; color: #171717; }
.tk__poster-sub { font-size: 15rpx; font-weight: 700; letter-spacing: 3rpx; opacity: 0.68; }
.tk__pass-cut { position: relative; height: 28rpx; background: #f7f7f7; }
.tk__pass-cut::before,
.tk__pass-cut::after {
  content: "";
  position: absolute;
  top: 0;
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: #000000;
}
.tk__pass-cut::before { left: -14rpx; }
.tk__pass-cut::after { right: -14rpx; }
.tk__pass-cutline { position: absolute; left: 28rpx; right: 28rpx; top: 13rpx; border-top: 2rpx dashed #d8d8d8; }
.tk__pass-foot {
  height: 86rpx;
  padding: 0 26rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  background: #f7f7f7;
}
.tk__ticket { flex: 1; min-width: 0; font-size: 23rpx; line-height: 1.3; font-weight: 600; color: #252525; }
.tk__open { flex: none; display: flex; align-items: center; gap: 9rpx; font-size: 21rpx; line-height: 1.3; font-weight: 600; color: #555555; }
.tk__qricon { width: 30rpx; height: 30rpx; display: block; opacity: 0.78; }

/* 卡包展开态：票券业务信息与原 ticket-code 页面保持一致。 */
.tc-modal { position: fixed; inset: 0; z-index: 1000; }
.tc-modal__mask {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.94);
  animation: wallet-fade-in 180ms ease-out both;
}
.tc-modal__scroll {
  position: relative;
  z-index: 1;
  width: 100%;
  height: 100%;
  animation: wallet-rise 240ms cubic-bezier(0.22, 1, 0.36, 1) both;
}
.tc-modal__chrome {
  height: 96rpx;
  padding: 0 32rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.tc-modal__label { font-size: 17rpx; font-weight: 600; letter-spacing: 3rpx; color: #8c8c8c; }
.tc-modal__close {
  min-width: 80rpx;
  padding: 18rpx 0 18rpx 24rpx;
  font-size: 25rpx;
  line-height: 1.2;
  font-weight: 600;
  color: #f2f2f2;
  text-align: right;
}
.tc-modal__close--hover { opacity: 0.62; }

.tc {
  min-height: 100vh;
  padding: 32rpx 28rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #000000;
  color: #171717;
}
.tc--modal { min-height: auto; padding-top: 0; background: transparent; }
.tc__ticket {
  position: relative;
  width: 100%;
  max-width: 694rpx;
  margin: 0 auto;
  overflow: hidden;
  border-radius: 16rpx;
  background: #ffffff;
}

.tc__head {
  min-height: 330rpx;
  padding: 46rpx 40rpx 38rpx;
  box-sizing: border-box;
  display: flex;
  gap: 28rpx;
}
.tc__head-main { flex: 1; min-width: 0; }
.tc__title {
  display: block;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 36rpx;
  line-height: 1.25;
  font-weight: 700;
  color: #171717;
}
.tc__type { display: block; margin-top: 14rpx; font-size: 24rpx; color: #555555; }
.tc__facts { margin-top: 40rpx; display: flex; flex-wrap: wrap; row-gap: 26rpx; }
.tc__fact { width: 34%; min-width: 0; display: flex; flex-direction: column; gap: 5rpx; }
.tc__fact--wide { width: 66%; }
.tc__fact--location { width: 100%; }
.tc__fact-label { font-size: 19rpx; line-height: 1.4; color: #777777; }
.tc__fact-value { max-width: 100%; font-size: 26rpx; line-height: 1.35; font-weight: 600; color: #202020; }
.tc__poster {
  width: 124rpx;
  height: 160rpx;
  flex: none;
  overflow: hidden;
  border-radius: 8rpx;
  background: #eeeeee;
}
.tc__poster-image { width: 100%; height: 100%; display: block; }
.tc__poster-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #151515;
  color: #ffffff;
  font-size: 16rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}
.tc__poster-placeholder--member { background: #d8d5cc; color: #171717; }

.tc__cut { position: relative; height: 34rpx; background: #ffffff; }
.tc__cut::before,
.tc__cut::after {
  content: "";
  position: absolute;
  top: 0;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: #000000;
}
.tc__cut::before { left: -17rpx; }
.tc__cut::after { right: -17rpx; }
.tc__cut-line {
  position: absolute;
  left: 34rpx;
  right: 34rpx;
  top: 16rpx;
  border-top: 2rpx dashed #e6e6e6;
}

.tc__body { padding: 30rpx 40rpx 46rpx; display: flex; flex-direction: column; align-items: center; }
.tc__body-head { width: 100%; display: flex; align-items: center; justify-content: space-between; }
.tc__body-title { font-size: 30rpx; line-height: 1.4; font-weight: 700; color: #171717; }
.tc__status { font-size: 21rpx; color: #666666; }
.tc__qr { position: relative; margin-top: 40rpx; }
.tc__qr .ic-qr { padding: 64rpx; border: none; border-radius: 0; }
.tc__qr .ic-qr__cell { width: 16rpx; height: 16rpx; }
.tc__qr.is-disabled .ic-qr { opacity: 0.3; }
.tc__stamp {
  position: absolute;
  right: -10rpx;
  bottom: 16rpx;
  min-width: 126rpx;
  height: 70rpx;
  padding: 0 18rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid #d96b6b;
  border-radius: 50%;
  transform: rotate(-12deg);
  color: #c95050;
  font-size: 24rpx;
  font-weight: 700;
}
.tc__code {
  width: 100%;
  min-height: 96rpx;
  margin-top: 34rpx;
  padding: 0 26rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  border: 1rpx solid #e4e4e4;
  border-radius: 12rpx;
}
.tc__code--hover { background: #f5f5f5; }
.tc__code-label { font-size: 22rpx; color: #777777; }
.tc__code-num { font-size: 28rpx; font-weight: 700; color: #202020; letter-spacing: 3rpx; font-variant-numeric: tabular-nums; }
.tc__code .ic-ic { color: #777777; }
.tc__hint { margin-top: 22rpx; font-size: 21rpx; line-height: 1.5; color: #777777; text-align: center; }
.tc__detail {
  min-height: 76rpx;
  margin-top: 26rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 23rpx;
  line-height: 1.4;
  font-weight: 600;
  color: #3f3f3f;
}
.tc__detail--hover { color: #777777; }

@keyframes wallet-fade-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes wallet-rise {
  from { opacity: 0.65; transform: translateY(44rpx) scale(0.985); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

@media (prefers-reduced-motion: reduce) {
  .tk__pass { transition: none; }
  .tc-modal__mask,
  .tc-modal__scroll { animation: none; }
}
