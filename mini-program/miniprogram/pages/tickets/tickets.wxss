.tk { min-height: 100vh; background: var(--ic-bg); }
.tk__seg { background: var(--ic-white); padding: 0 24rpx; }
.tk__list { padding: 0 32rpx; background: var(--ic-white); }
.tk__card { display: flex; align-items: flex-start; gap: 24rpx; padding: 28rpx 0; border-bottom: 1rpx solid var(--ic-line); }
.tk__card:last-child { border-bottom: none; }
.tk__card.is-dim { opacity: 0.6; }
.tk__poster { width: 168rpx; height: 168rpx; flex: none; overflow: hidden; background: var(--ic-fill); border-radius: 8rpx; display: flex; align-items: center; justify-content: center; }
.tk__poster-img { width: 100%; height: 100%; display: block; }
.tk__poster-ph { width: 100%; height: 100%; box-sizing: border-box; padding: 16rpx 10rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; background: #111; color: #fff; }
.tk__poster-ph--member { background: #e8e5dc; color: #111; }
.tk__poster-sub { font-size: 16rpx; letter-spacing: 4rpx; opacity: 0.62; }
.tk__poster-title { max-width: 100%; margin-top: 12rpx; font-size: 24rpx; line-height: 1.18; font-weight: 700; overflow: hidden; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.tk__main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 11rpx; }
.tk__title { display: block; max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 26rpx; font-weight: 700; color: var(--ic-black); }
.tk__meta { display: flex; align-items: center; gap: 8rpx; min-width: 0; }
.tk__meta-icon { width: 26rpx; height: 26rpx; flex: none; display: block; }
.tk__time { font-size: 22rpx; color: var(--ic-text-2); }
.tk__store { flex: 1; min-width: 0; font-size: 20rpx; color: var(--ic-text-3); }
.tk__ticket { margin-top: 4rpx; font-size: 22rpx; color: var(--ic-text); }
.tk__action { width: 136rpx; flex: none; display: flex; flex-direction: column; align-items: center; justify-content: flex-start; gap: 18rpx; align-self: stretch; padding-top: 0; }
.tk__status { display: flex; align-items: center; justify-content: center; gap: 8rpx; height: 34rpx; line-height: 34rpx; color: var(--ic-black); }
.tk__status--used { color: var(--ic-text-2); }
.tk__status--expired { color: var(--ic-text-4); }
.tk__status-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: currentColor; flex: none; }
.tk__status-text { font-size: 22rpx; color: currentColor; white-space: nowrap; }
.tk__view { font-size: 22rpx; color: var(--ic-text-3); }
.tk__codebtn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  width: 136rpx;
  color: var(--ic-black);
}
.tk__codebtn--hover { opacity: 0.72; }
.tk__qricon { width: 48rpx; height: 48rpx; display: block; }
.tk__codehint { display: block; width: 120rpx; font-size: 20rpx; line-height: 1.25; color: var(--ic-text-3); text-align: center; }

.tk-modal { position: fixed; inset: 0; z-index: 1000; display: flex; align-items: center; justify-content: center; padding: 48rpx; box-sizing: border-box; }
.tk-modal__mask { position: absolute; inset: 0; background: rgba(0, 0, 0, 0.45); }
.tk-modal__panel {
  position: relative;
  z-index: 1;
  width: 100%;
  max-width: 620rpx;
  box-sizing: border-box;
  background: var(--ic-white);
  border-radius: 24rpx;
  padding: 56rpx 36rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.tk-modal__close { position: absolute; right: 18rpx; top: 18rpx; width: 56rpx; height: 56rpx; display: flex; align-items: center; justify-content: center; }
.tk-modal__x { width: 28rpx; height: 28rpx; position: relative; }
.tk-modal__x::before, .tk-modal__x::after { content: ""; position: absolute; top: 50%; left: 0; width: 100%; height: 3rpx; background: var(--ic-text-3); }
.tk-modal__x::before { transform: rotate(45deg); }
.tk-modal__x::after { transform: rotate(-45deg); }
.tk-modal__title { max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 28rpx; font-weight: 700; color: var(--ic-black); text-align: center; }
.tk-modal__sub { margin-top: 12rpx; font-size: 22rpx; color: var(--ic-text-3); text-align: center; }
.tk-modal__qr { margin-top: 38rpx; }
.tk-modal__code { display: flex; align-items: center; gap: 14rpx; margin-top: 34rpx; }
.tk-modal__code-num { font-size: 30rpx; font-weight: 700; color: var(--ic-black); letter-spacing: 4rpx; font-variant-numeric: tabular-nums; }
.tk-modal__hint { margin-top: 16rpx; font-size: 22rpx; color: var(--ic-text-3); }
