<ic-app-background />
<view class="ic-scroll-shell">
<ic-page-nav title="邀请好友" />
<scroll-view class="ic-scroll-view" scroll-y enhanced show-scrollbar="{{false}}" bounces="{{false}}">
<ic-loading wx:if="{{loading}}" />

<view wx:elif="{{info}}" class="iv">
  <view class="iv__code-card ic-glass-recessed">
    <text class="iv__code-label">我的邀请码</text>
    <view class="iv__code-row">
      <view class="iv__code-main">
        <text class="iv__code">{{info.inviteCode}}</text>
        <view class="iv__copy" bindtap="copyCode" aria-role="button" aria-label="复制邀请码">
          <view class="ic-ic ic-ic-copy ic-ic--sm"></view>
        </view>
      </view>
      <view class="iv__invited">
        <text class="iv__invited-num">{{info.invited}}</text>
        <text class="iv__invited-label">已邀请</text>
      </view>
    </view>
    <button class="ic-btn ic-btn-primary ic-btn-block iv__share" open-type="share">
      <view class="ic-ic ic-ic-share ic-ic--sm iv__share-ico"></view>
      <text>分享给好友</text>
    </button>
  </view>

  <view wx:if="{{info.rules.length}}" class="iv__rules ic-glass-recessed">
    <view class="iv__rule" wx:for="{{info.rules}}" wx:key="title">
      <view class="ic-ic {{item.icon}} ic-ic--sm"></view>
      <view class="iv__rule-main">
        <text class="iv__rule-title">{{item.title}}</text>
        <text class="iv__rule-desc">{{item.desc}}</text>
      </view>
    </view>
  </view>

  <view wx:if="{{!info.inviterBound}}" class="iv__bind ic-glass-recessed">
    <view class="iv__bind-copy">
      <text class="iv__bind-title">绑定邀请码</text>
      <text class="iv__bind-desc">填写邀请人的邀请码，绑定后不可更改</text>
    </view>
    <view class="iv__bind-row">
      <input
        class="iv__bind-input"
        value="{{bindCode}}"
        maxlength="32"
        placeholder="请输入邀请码"
        placeholder-class="iv__bind-placeholder"
        confirm-type="done"
        bindinput="onBindCodeInput"
        bindconfirm="bindInvitation"
      />
      <button
        class="ic-btn ic-btn-primary iv__bind-btn {{binding || !bindCode ? 'ic-disabled' : ''}}"
        loading="{{binding}}"
        disabled="{{binding || !bindCode}}"
        bindtap="bindInvitation"
      >绑定</button>
    </view>
  </view>

  <view class="iv__records">
    <text class="ic-h2 iv__records-title">邀请记录</text>
    <view class="iv__record ic-glass-recessed" wx:if="{{info.records.length}}">
      <view class="iv__record-row" wx:for="{{info.records}}" wx:key="id">
        <view class="iv__record-avatar">
          <image wx:if="{{item.avatarUrl}}" class="iv__record-avatar-img" src="{{item.avatarUrl}}" mode="aspectFill" />
          <text wx:else class="iv__record-avatar-text">{{item.avatarText}}</text>
        </view>
        <view class="iv__record-main">
          <text class="iv__record-name">{{item.name}}</text>
          <text class="iv__record-date">{{item.registeredAt}}</text>
        </view>
      </view>
    </view>
    <ic-empty wx:else text="暂无邀请记录" compact="{{true}}" />
  </view>
</view>
</scroll-view>
</view>
