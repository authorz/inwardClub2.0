<ic-app-background />
<view class="ic-scroll-shell">
  <ic-page-nav title="邀请好友" />
  <scroll-view class="ic-scroll-view" scroll-y enhanced show-scrollbar="{{false}}" bounces="{{false}}">
    <ic-loading wx:if="{{loading}}" />

    <view wx:elif="{{info}}" class="iv">
      <view class="iv__hero">
        <text class="iv__brand">INWARD CLUB MEMBER INVITE</text>
        <text class="iv__headline">把好友带进 Inward Club</text>
        <text class="iv__headline iv__headline--muted">{{info.reward.enabled ? '奖励持续到账' : '一起加入会员'}}</text>
      </view>

      <view wx:if="{{info.reward.enabled}}" class="iv__pass" aria-label="Inward Club 会员邀请奖励">
        <view class="iv__pass-head">
          <view class="iv__pass-brand">
            <text class="iv__pass-logo">inward club</text>
            <text class="iv__pass-type">MEMBER INVITE</text>
          </view>
          <text class="iv__pass-index">IC / INVITE</text>
        </view>

        <view class="iv__reward-head">
          <view>
            <text class="iv__reward-kicker">邀请奖励</text>
            <text class="iv__reward-title">{{info.reward.cardTitle}}</text>
          </view>
          <text class="iv__reward-target">{{info.reward.targetText}}</text>
        </view>

        <view wx:if="{{info.reward.firstCoins || info.reward.firstPoints}}" class="iv__reward-grid">
          <view wx:if="{{info.reward.firstCoins}}" class="iv__reward-item">
            <text class="iv__reward-value">{{info.reward.firstCoins}}</text>
            <text class="iv__reward-label">首次低消奖励金币</text>
          </view>
          <view wx:if="{{info.reward.firstPoints}}" class="iv__reward-item">
            <text class="iv__reward-value">{{info.reward.firstPoints}}</text>
            <text class="iv__reward-label">首次低消奖励积分</text>
          </view>
        </view>
        <text class="iv__reward-note">{{info.reward.note}}</text>
      </view>

      <button class="ic-btn ic-btn-block iv__share" open-type="share">
        <image class="iv__share-icon" src="/pages/invitations/assets/invite-share.svg" mode="aspectFit" />
        <text>邀请微信好友</text>
      </button>
      <view class="iv__code-line">
        <text class="iv__code-label">我的邀请码</text>
        <view class="iv__code-action" bindtap="copyCode" aria-role="button" aria-label="复制邀请码 {{info.inviteCode}}">
          <text class="iv__code">{{info.inviteCode}}</text>
          <image class="iv__copy-icon" src="/pages/invitations/assets/invite-copy.svg" mode="aspectFit" />
        </view>
      </view>
      <text class="iv__invite-hint">{{info.reward.enabled ? '分享后，邀请奖励会自动累计' : '分享给好友并邀请对方完成注册'}}</text>

      <view wx:if="{{!info.inviterBound}}" class="iv__bind">
        <view class="iv__section-head">
          <text class="iv__section-title">绑定邀请码</text>
          <text class="iv__section-desc">填写邀请人的邀请码，绑定后不可更改</text>
        </view>
        <view class="iv__bind-row">
          <input
            class="iv__bind-input"
            value="{{bindCode}}"
            maxlength="32"
            placeholder="请输入邀请码"
            placeholder-class="iv__bind-placeholder"
            confirm-type="done"
            bindinput="onBindCodeInput"
            bindconfirm="bindInvitation"
          />
          <button
            class="ic-btn iv__bind-btn {{binding || !bindCode ? 'ic-disabled' : ''}}"
            loading="{{binding}}"
            disabled="{{binding || !bindCode}}"
            bindtap="bindInvitation"
          >绑定</button>
        </view>
      </view>

      <view wx:if="{{info.reward.enabled}}" class="iv__section iv__steps">
        <view class="iv__section-head">
          <text class="iv__section-title">参与步骤</text>
          <text class="iv__section-desc">分享邀请，好友达标后奖励自动入账</text>
        </view>
        <view class="iv__step-list">
          <view class="iv__step">
            <text class="iv__step-no">01</text>
            <view class="iv__step-copy">
              <text class="iv__step-title">分享邀请</text>
              <text class="iv__step-desc">发送小程序链接给微信好友</text>
            </view>
          </view>
          <view class="iv__step">
            <text class="iv__step-no">02</text>
            <view class="iv__step-copy">
              <text class="iv__step-title">好友注册</text>
              <text class="iv__step-desc">通过链接进入并完成手机号注册</text>
            </view>
          </view>
          <view class="iv__step">
            <text class="iv__step-no">03</text>
            <view class="iv__step-copy">
              <text class="iv__step-title">完成首次低消</text>
              <text class="iv__step-desc">按门店低消规则完成微信支付</text>
            </view>
          </view>
          <view class="iv__step">
            <text class="iv__step-no">04</text>
            <view class="iv__step-copy">
              <text class="iv__step-title">奖励到账</text>
              <text class="iv__step-desc">{{info.reward.awardStep}}</text>
            </view>
          </view>
        </view>
      </view>

      <view class="iv__section iv__overview">
        <view class="iv__section-head">
          <text class="iv__section-title">邀请概览</text>
          <text class="iv__section-desc">记录邀请人数、已获奖励人数和累计金币</text>
        </view>
        <view class="iv__overview-metrics">
          <view class="iv__overview-metric">
            <text class="iv__overview-label">邀请好友</text>
            <text class="iv__overview-value">{{info.invited}}</text>
          </view>
          <view class="iv__overview-metric">
            <text class="iv__overview-label">累计金币奖励</text>
            <text class="iv__overview-value">{{info.reward.cumulativeRewardCoins}}</text>
          </view>
          <view class="iv__overview-metric">
            <text class="iv__overview-label">已获奖励</text>
            <text class="iv__overview-value">{{info.reward.rewardedMembers}}</text>
          </view>
        </view>
        <text wx:if="{{info.reward.cumulativeRewardPoints}}" class="iv__overview-points">另累计获得 {{info.reward.cumulativeRewardPoints}} 积分</text>

        <view class="iv__record-list" wx:if="{{info.records.length}}">
          <view class="iv__record-row" wx:for="{{info.records}}" wx:key="id">
            <view class="iv__record-avatar">
              <image wx:if="{{item.avatarUrl}}" class="iv__record-avatar-img" src="{{item.avatarUrl}}" mode="aspectFill" />
              <text wx:else class="iv__record-avatar-text">{{item.avatarText}}</text>
            </view>
            <view class="iv__record-main">
              <text class="iv__record-name">{{item.name}}</text>
              <text class="iv__record-date">{{item.registeredAt}}</text>
            </view>
            <text class="iv__record-status">已注册</text>
          </view>
        </view>
        <view wx:else class="iv__empty">
          <text class="iv__empty-title">暂无邀请记录</text>
          <text class="iv__empty-desc">邀请好友注册后，记录会显示在这里</text>
        </view>
      </view>

      <view wx:if="{{info.reward.enabled && info.reward.rules.length}}" class="iv__section iv__rules">
        <view class="iv__section-head">
          <text class="iv__section-title">邀请规则</text>
        </view>
        <view class="iv__rule-list">
          <view class="iv__rule" wx:for="{{info.reward.rules}}" wx:key="no">
            <text class="iv__rule-no">{{item.no}}</text>
            <text class="iv__rule-copy">{{item.copy}}</text>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>
</view>
