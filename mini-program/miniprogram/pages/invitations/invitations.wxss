.iv {
  min-height: 100%;
  padding: 40rpx 36rpx calc(72rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: rgba(8, 10, 13, 0.78);
  color: rgba(255, 255, 255, 0.96);
}

.iv__hero { padding: 12rpx 0 34rpx; }
.iv__brand {
  display: block;
  margin-bottom: 24rpx;
  color: rgba(255, 255, 255, 0.58);
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1.4;
  letter-spacing: 2rpx;
}
.iv__headline {
  display: block;
  max-width: 620rpx;
  color: rgba(255, 255, 255, 0.98);
  font-size: 58rpx;
  font-weight: 700;
  line-height: 1.18;
  letter-spacing: -1rpx;
}
.iv__headline--muted { color: rgba(255, 255, 255, 0.64); }

.iv__pass {
  padding: 34rpx 32rpx 30rpx;
  overflow: hidden;
  box-sizing: border-box;
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  border-radius: 24rpx;
  background: rgba(9, 11, 14, 0.92);
}
.iv__pass-head,
.iv__reward-head,
.iv__invite-meta,
.iv__overview-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}
.iv__pass-brand { display: flex; flex-direction: column; gap: 6rpx; }
.iv__pass-logo { font-size: 30rpx; font-weight: 650; line-height: 1.2; letter-spacing: -1rpx; }
.iv__pass-type,
.iv__pass-index { color: rgba(255, 255, 255, 0.5); font-size: 17rpx; line-height: 1.4; letter-spacing: 2rpx; }
.iv__pass-index { flex: none; text-align: right; }

.iv__reward-head {
  align-items: flex-end;
  margin-top: 58rpx;
  padding-bottom: 30rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.16);
}
.iv__reward-kicker { display: block; color: rgba(255, 255, 255, 0.56); font-size: 20rpx; line-height: 1.4; }
.iv__reward-title { display: block; margin-top: 8rpx; font-size: 30rpx; font-weight: 600; line-height: 1.4; }
.iv__reward-target {
  flex: none;
  padding: 11rpx 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.32);
  border-radius: 999rpx;
  color: rgba(255, 255, 255, 0.9);
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1.3;
}
.iv__reward-grid { display: flex; border-bottom: 1rpx solid rgba(255, 255, 255, 0.16); }
.iv__reward-item { flex: 1; min-width: 0; padding: 28rpx 0 26rpx; }
.iv__reward-item + .iv__reward-item { padding-left: 28rpx; border-left: 1rpx solid rgba(255, 255, 255, 0.16); }
.iv__reward-value { display: block; font-size: 48rpx; font-weight: 650; line-height: 1.15; font-variant-numeric: tabular-nums; }
.iv__reward-label { display: block; margin-top: 8rpx; color: rgba(255, 255, 255, 0.58); font-size: 20rpx; line-height: 1.4; }
.iv__reward-note { display: block; padding-top: 24rpx; color: rgba(255, 255, 255, 0.62); font-size: 21rpx; line-height: 1.6; }

.iv__share {
  height: 92rpx;
  margin: 28rpx 0 0;
  border-radius: 999rpx;
  background: #ffffff;
  color: #111111;
  font-size: 26rpx;
}
.iv__share-icon { margin-right: 12rpx; color: #111111; }
.iv__invite-meta { min-height: 76rpx; padding: 4rpx 4rpx 0; }
.iv__invite-hint { min-width: 0; color: rgba(255, 255, 255, 0.58); font-size: 22rpx; line-height: 1.45; }
.iv__code-action { flex: none; min-height: 72rpx; display: flex; align-items: center; gap: 8rpx; color: rgba(255, 255, 255, 0.88); }
.iv__copy-icon { transform: scale(0.72); }
.iv__code { max-width: 210rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 20rpx; font-weight: 600; letter-spacing: 1rpx; }

.iv__section,
.iv__bind { margin-top: 64rpx; padding-top: 40rpx; border-top: 1rpx solid rgba(255, 255, 255, 0.18); }
.iv__section-head { min-width: 0; }
.iv__section-title { display: block; font-size: 36rpx; font-weight: 650; line-height: 1.3; color: rgba(255, 255, 255, 0.96); }
.iv__section-desc { display: block; max-width: 560rpx; margin-top: 10rpx; color: rgba(255, 255, 255, 0.58); font-size: 24rpx; line-height: 1.55; }

.iv__bind-row { display: flex; align-items: center; gap: 16rpx; margin-top: 26rpx; }
.iv__bind-input {
  flex: 1;
  width: 0;
  min-width: 0;
  height: 88rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(255, 255, 255, 0.24);
  border-radius: 12rpx;
  background: rgba(8, 10, 13, 0.5);
  color: rgba(255, 255, 255, 0.94);
  font-size: 24rpx;
}
.iv__bind-placeholder { color: rgba(255, 255, 255, 0.54); }
.iv__bind-btn {
  flex: 0 0 128rpx;
  width: 128rpx;
  min-width: 128rpx;
  height: 88rpx;
  margin: 0;
  padding: 0;
  border-radius: 12rpx;
  background: #ffffff;
  color: #111111;
  font-size: 24rpx;
}
.iv__bind-btn.ic-disabled { background: rgba(255, 255, 255, 0.18); color: rgba(255, 255, 255, 0.48); }

.iv__step-list { margin-top: 30rpx; }
.iv__step { position: relative; display: flex; gap: 24rpx; min-height: 112rpx; padding-bottom: 22rpx; }
.iv__step:last-child { min-height: 0; padding-bottom: 0; }
.iv__step::after {
  position: absolute;
  top: 42rpx;
  bottom: 0;
  left: 25rpx;
  width: 1rpx;
  background: rgba(255, 255, 255, 0.18);
  content: "";
}
.iv__step:last-child::after { display: none; }
.iv__step-no {
  position: relative;
  z-index: 1;
  flex: none;
  width: 52rpx;
  height: 52rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.32);
  border-radius: 50%;
  background: rgba(8, 10, 13, 0.9);
  color: rgba(255, 255, 255, 0.88);
  font-size: 18rpx;
  line-height: 52rpx;
  text-align: center;
  font-variant-numeric: tabular-nums;
}
.iv__step-copy { min-width: 0; padding-top: 4rpx; }
.iv__step-title { display: block; font-size: 26rpx; font-weight: 600; line-height: 1.4; }
.iv__step-desc { display: block; margin-top: 6rpx; color: rgba(255, 255, 255, 0.58); font-size: 24rpx; line-height: 1.5; }

.iv__overview-head { align-items: flex-end; }
.iv__overview-total { flex: none; padding-bottom: 2rpx; text-align: right; }
.iv__overview-num { font-size: 52rpx; font-weight: 650; line-height: 1; font-variant-numeric: tabular-nums; }
.iv__overview-unit { margin-left: 8rpx; color: rgba(255, 255, 255, 0.58); font-size: 20rpx; }
.iv__record-list { margin-top: 30rpx; border-top: 1rpx solid rgba(255, 255, 255, 0.16); }
.iv__record-row { display: flex; align-items: center; gap: 20rpx; min-height: 112rpx; border-bottom: 1rpx solid rgba(255, 255, 255, 0.14); }
.iv__record-avatar { flex: none; width: 64rpx; height: 64rpx; overflow: hidden; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: rgba(255, 255, 255, 0.12); }
.iv__record-avatar-img { width: 100%; height: 100%; }
.iv__record-avatar-text { font-size: 22rpx; font-weight: 600; color: rgba(255, 255, 255, 0.9); }
.iv__record-main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 5rpx; }
.iv__record-name { overflow: hidden; color: rgba(255, 255, 255, 0.92); font-size: 24rpx; text-overflow: ellipsis; white-space: nowrap; }
.iv__record-date { color: rgba(255, 255, 255, 0.54); font-size: 22rpx; }
.iv__record-status { flex: none; color: rgba(255, 255, 255, 0.58); font-size: 22rpx; }
.iv__empty { margin-top: 30rpx; padding: 36rpx 0 8rpx; border-top: 1rpx solid rgba(255, 255, 255, 0.16); }
.iv__empty-title { display: block; font-size: 24rpx; color: rgba(255, 255, 255, 0.78); }
.iv__empty-desc { display: block; margin-top: 8rpx; color: rgba(255, 255, 255, 0.52); font-size: 24rpx; line-height: 1.5; }

.iv__rule-list { margin-top: 28rpx; }
.iv__rule { display: flex; align-items: flex-start; gap: 24rpx; padding: 24rpx 0; border-top: 1rpx solid rgba(255, 255, 255, 0.14); }
.iv__rule-no { flex: none; width: 42rpx; color: rgba(255, 255, 255, 0.5); font-size: 22rpx; line-height: 1.65; font-variant-numeric: tabular-nums; }
.iv__rule-copy { flex: 1; min-width: 0; color: rgba(255, 255, 255, 0.72); font-size: 24rpx; line-height: 1.65; }
