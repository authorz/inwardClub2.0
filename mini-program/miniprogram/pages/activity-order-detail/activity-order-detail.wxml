<ic-loading wx:if="{{loading}}" />

<view wx:elif="{{order}}" class="od">
  <view class="od-head">
    <view class="od-head__icon"><view class="ic-ic {{showCode ? 'ic-ic-ticket' : 'ic-ic-check'}} ic-ic--sm"></view></view>
    <text class="od-head__status">{{order.statusText}}</text>
    <text class="od-head__no">#{{order.orderNo}}</text>
  </view>

  <view class="od-card od-card--pad aod__act">
    <view class="aod__poster"><ic-poster title="{{order.activityTitle}}" tone="poker" radius="12rpx" /></view>
    <view class="aod__act-main">
      <text class="aod__act-title ic-ellipsis">{{order.activityTitle}}</text>
      <text class="aod__act-sub">{{order.timeText}}</text>
      <text class="aod__act-sub ic-ellipsis">{{order.storeName}}</text>
      <text class="aod__act-ticket">{{order.ticketName}} x{{order.qty}}</text>
    </view>
  </view>

  <view wx:if="{{showCode}}" class="od-card od-card--pad aod__code">
    <view class="ic-qr">
      <view class="ic-qr__row" wx:for="{{qr}}" wx:for-item="row" wx:key="id">
        <view class="ic-qr__cell {{cell.on ? 'ic-qr__cell--on' : ''}}" wx:for="{{row.cells}}" wx:for-item="cell" wx:key="id"></view>
      </view>
    </view>
    <view class="aod__code-info">
      <text class="aod__code-label">核销码</text>
      <view class="aod__code-num" bindtap="copyCode"><text>{{order.verifyCode}}</text><view class="ic-ic ic-ic-copy ic-ic--sm"></view></view>
      <text class="aod__code-hint">入场时向工作人员出示</text>
    </view>
  </view>

  <view class="od-card">
    <view class="od-row"><text class="od-row__label">支付方式</text><text class="od-row__value">{{order.payChannelText}}</text></view>
    <view class="od-row"><text class="od-row__label">订单金额</text><text class="od-row__value od-row__value--strong">¥{{order.amountText}}</text></view>
    <view class="od-row"><text class="od-row__label">购买时间</text><text class="od-row__value">{{order.createdText}}</text></view>
  </view>

  <view class="od-bar">
    <button class="ic-btn ic-btn-primary ic-btn-block" bindtap="goActivity">查看活动详情</button>
  </view>
</view>
