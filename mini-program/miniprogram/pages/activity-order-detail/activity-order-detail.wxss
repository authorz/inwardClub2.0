.aod__act { display: flex; gap: 24rpx; }
.aod__poster { width: 132rpx; height: 180rpx; flex: none; }
.aod__act-main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 10rpx; }
.aod__act-title { font-size: 34rpx; font-weight: 700; color: var(--ic-black); }
.aod__act-sub { font-size: 24rpx; color: var(--ic-text-3); }
.aod__act-ticket { margin-top: 6rpx; font-size: 28rpx; color: var(--ic-text); }

.aod__code { display: flex; align-items: center; gap: 32rpx; }
.aod__code-info { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 12rpx; }
.aod__code-label { font-size: 24rpx; color: var(--ic-text-3); }
.aod__code-num { display: inline-flex; align-items: center; gap: 14rpx; font-size: 44rpx; font-weight: 700; color: var(--ic-black); letter-spacing: 2rpx; font-variant-numeric: tabular-nums; }
.aod__code-hint { font-size: 24rpx; color: var(--ic-text-3); }
