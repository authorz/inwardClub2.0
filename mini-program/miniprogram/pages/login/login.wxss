page { color: rgba(255, 255, 255, 0.9); }

.login-page {
  min-height: calc(100vh - 88rpx);
  padding: 56rpx 40rpx calc(64rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: transparent;
}

.login-page__hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.login-page__logo {
  width: 300rpx;
  height: 132rpx;
  display: block;
}

.login-page__title {
  margin-top: 44rpx;
  color: rgba(255, 255, 255, 0.96);
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.3;
}

.login-page__desc {
  margin-top: 16rpx;
  color: rgba(255, 255, 255, 0.66);
  font-size: 24rpx;
  line-height: 1.6;
}

.login-page__welcome,
.login-page__form {
  width: 100%;
  margin-top: 64rpx;
  padding: 36rpx 28rpx;
  box-sizing: border-box;
}

.login-page__primary {
  position: relative;
  z-index: 1;
  width: 100% !important;
  min-width: 100%;
  max-width: none;
  height: 92rpx;
  margin: 0 !important;
  padding: 0;
  border-radius: 999rpx;
  color: rgba(255, 255, 255, 0.96);
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1;
}

.login-page__primary.ic-glass-recessed {
  border-color: rgba(255, 255, 255, 0.24);
  background: rgba(168, 180, 198, 0.2);
  -webkit-backdrop-filter: blur(40rpx) saturate(155%) brightness(0.98);
  backdrop-filter: blur(40rpx) saturate(155%) brightness(0.98);
}
.login-page__primary.ic-glass-recessed::before { right: 22rpx; left: 22rpx; height: 40rpx; border-radius: 999rpx 999rpx 45% 45%; }

.login-page__primary::after,
.login-page__avatar::after,
.login-page__phone-button::after { border: none; }

.login-page__primary[disabled] {
  color: rgba(255, 255, 255, 0.58);
  opacity: 0.62;
}

.login-page__note {
  position: relative;
  z-index: 1;
  display: block;
  margin-top: 24rpx;
  color: rgba(255, 255, 255, 0.58);
  font-size: 20rpx;
  text-align: center;
}

.login-page__avatar {
  position: relative;
  z-index: 1;
  width: 144rpx;
  height: 144rpx;
  margin: 0 auto 40rpx;
  padding: 0;
  overflow: hidden;
  border-radius: 28rpx;
  color: rgba(255, 255, 255, 0.82);
}

.login-page__avatar-image { width: 100%; height: 100%; display: block; }

.login-page__avatar-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: rgba(255, 255, 255, 0.78);
}

.login-page__avatar-plus { font-size: 30rpx; font-weight: 300; line-height: 1; }
.login-page__avatar-text { margin-top: 8rpx; font-size: 20rpx; }

.login-page__field {
  position: relative;
  z-index: 1;
  min-height: 104rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.14);
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.login-page__field:last-of-type { border-bottom: none; }

.login-page__label {
  width: 112rpx;
  flex: none;
  color: rgba(255, 255, 255, 0.88);
  font-size: 24rpx;
  font-weight: 600;
}

.login-page__input,
.login-page__phone { min-width: 0; flex: 1; }

.login-page__input {
  height: 80rpx;
  color: rgba(255, 255, 255, 0.94);
  font-size: 24rpx;
  line-height: 80rpx;
  text-align: right;
}

.login-page__placeholder { color: rgba(255, 255, 255, 0.5); }
.login-page__phone { display: flex; justify-content: flex-end; }

.login-page__phone-value {
  color: rgba(255, 255, 255, 0.72);
  font-size: 24rpx;
  font-variant-numeric: tabular-nums;
}

.login-page__phone-button {
  width: 188rpx;
  height: 68rpx;
  margin: 0;
  padding: 0;
  border-radius: 999rpx;
  color: rgba(255, 255, 255, 0.94);
  font-size: 22rpx;
  font-weight: 600;
  line-height: 68rpx;
}
.login-page__phone-button.ic-glass-recessed::before { right: 14rpx; left: 14rpx; height: 28rpx; border-radius: 999rpx 999rpx 45% 45%; }

.login-page__gender {
  min-width: 0;
  flex: 1;
  display: flex;
  justify-content: flex-end;
  gap: 36rpx;
}

.login-page__gender-item {
  height: 80rpx;
  display: flex;
  align-items: center;
  color: rgba(255, 255, 255, 0.88);
  font-size: 24rpx;
}

.login-page__gender-radio { transform: scale(0.82); }
.login-page__gender-icon { width: 32rpx; height: 32rpx; margin: 0 8rpx 0 2rpx; filter: brightness(0) invert(1); opacity: 0.86; }
.login-page__submit { margin-top: 48rpx !important; }
