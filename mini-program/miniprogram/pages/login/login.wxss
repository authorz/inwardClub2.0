.login-page {
  min-height: 100vh;
  padding: 88rpx 48rpx calc(64rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: var(--ic-white);
  color: var(--ic-black);
}

.login-page__hero {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.login-page__logo {
  width: 244rpx;
  height: auto;
}

.login-page__title {
  margin-top: 72rpx;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.3;
}

.login-page__desc {
  margin-top: 18rpx;
  color: var(--ic-text-3);
  font-size: 24rpx;
  line-height: 1.6;
}

.login-page__welcome,
.login-page__form {
  width: 100%;
  margin-top: 88rpx;
  box-sizing: border-box;
}

.login-page__primary {
  width: 100% !important;
  min-width: 100%;
  max-width: none;
  height: 92rpx;
  margin-left: 0 !important;
  margin-right: 0 !important;
  padding: 0;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 10rpx;
  background: var(--ic-black);
  color: var(--ic-white);
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1;
  text-align: center;
}

.login-page__primary::after,
.login-page__avatar::after,
.login-page__phone-button::after {
  border: none;
}

.login-page__primary[disabled] {
  background: var(--ic-black);
  color: var(--ic-white);
  opacity: 0.62;
}

.login-page__note {
  display: block;
  margin-top: 24rpx;
  color: var(--ic-text-4);
  font-size: 20rpx;
  text-align: center;
}

.login-page__avatar {
  width: 144rpx;
  height: 144rpx;
  margin: 0 0 48rpx;
  padding: 0;
  overflow: hidden;
  border-radius: 12rpx;
  background: var(--ic-fill);
}

.login-page__avatar-image {
  width: 100%;
  height: 100%;
  display: block;
}

.login-page__avatar-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: var(--ic-text-2);
}

.login-page__avatar-plus {
  font-size: 30rpx;
  font-weight: 300;
  line-height: 1;
}

.login-page__avatar-text {
  margin-top: 8rpx;
  font-size: 20rpx;
}

.login-page__field {
  min-height: 104rpx;
  border-bottom: 1rpx solid var(--ic-line);
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.login-page__label {
  width: 112rpx;
  flex: none;
  font-size: 24rpx;
  font-weight: 600;
}

.login-page__input,
.login-page__phone {
  min-width: 0;
  flex: 1;
}

.login-page__input {
  height: 80rpx;
  color: var(--ic-black);
  font-size: 24rpx;
  line-height: 80rpx;
  text-align: right;
}

.login-page__placeholder {
  color: var(--ic-text-4);
}

.login-page__phone {
  display: flex;
  justify-content: flex-end;
}

.login-page__phone-value {
  color: var(--ic-text-2);
  font-size: 24rpx;
  font-variant-numeric: tabular-nums;
}

.login-page__phone-button {
  width: 176rpx;
  height: 68rpx;
  margin: 0;
  padding: 0;
  border-radius: 8rpx;
  background: var(--ic-fill);
  color: var(--ic-black);
  font-size: 22rpx;
  font-weight: 600;
  line-height: 68rpx;
}

.login-page__gender {
  min-width: 0;
  flex: 1;
  display: flex;
  justify-content: flex-end;
  gap: 36rpx;
}

.login-page__gender-item {
  height: 80rpx;
  display: flex;
  align-items: center;
  color: var(--ic-text);
  font-size: 24rpx;
}

.login-page__gender-radio {
  transform: scale(0.82);
}

.login-page__gender-icon {
  width: 32rpx;
  height: 32rpx;
  margin: 0 8rpx 0 2rpx;
}

.login-page__submit {
  margin-top: 64rpx;
}
