<ic-loading wx:if="{{loading}}" />

<view wx:elif="{{store}}" class="sd">
  <view class="sd__hero">
    <text class="sd__hero-brand">INWARD CLUB</text>
    <text class="sd__hero-name">{{store.name}}</text>
    <text wx:if="{{distanceText}}" class="sd__hero-dist">距您 {{distanceText}}</text>
  </view>

  <view class="sd__card ic-card">
    <view class="sd__row">
      <text class="sd__label">营业时间</text>
      <text class="sd__value">{{store.hours}}</text>
    </view>
    <view class="sd__row">
      <text class="sd__label">状态</text>
      <text class="sd__value {{store.open ? 'is-open' : ''}}">{{store.open ? '营业中' : '休息中'}}</text>
    </view>
    <view class="sd__row sd__row--last">
      <text class="sd__label">地址</text>
      <text class="sd__value sd__value--addr">{{store.address}}{{store.addressDetail ? ' · ' + store.addressDetail : ''}}</text>
    </view>
  </view>

  <view wx:if="{{store.intro}}" class="sd__card ic-card sd__intro">
    <text class="ic-h2">门店介绍</text>
    <text class="sd__intro-text">{{store.intro}}</text>
  </view>

  <view class="sd__actions">
    <button class="ic-btn ic-btn-ghost sd__act" bindtap="onNav">导航前往</button>
    <button class="ic-btn ic-btn-ghost sd__act" bindtap="onCall">拨打电话</button>
  </view>

  <view class="sd__bar">
    <button class="ic-btn ic-btn-primary ic-btn-block" bindtap="setCurrent">设为当前门店</button>
  </view>
</view>
