.sd { min-height: 100vh; background: var(--ic-bg); padding: 0 24rpx calc(160rpx + env(safe-area-inset-bottom)); }

.sd__hero { display: flex; flex-direction: column; align-items: center; padding: 60rpx 0 40rpx; background: linear-gradient(160deg, #2a2622, #0e0d0c); margin: 0 -24rpx; }
.sd__hero-brand { font-size: 22rpx; letter-spacing: 5rpx; color: rgba(255,255,255,0.55); }
.sd__hero-name { margin-top: 16rpx; font-size: 40rpx; font-weight: 700; color: #fff; }
.sd__hero-dist { margin-top: 12rpx; font-size: 24rpx; color: rgba(255,255,255,0.55); }

.sd__card { margin-top: 24rpx; padding: 8rpx 32rpx; }
.sd__row { display: flex; align-items: flex-start; justify-content: space-between; gap: 24rpx; min-height: 100rpx; padding: 24rpx 0; border-bottom: 1rpx solid var(--ic-line); }
.sd__row--last { border-bottom: none; }
.sd__label { font-size: 30rpx; color: var(--ic-text-2); flex: none; }
.sd__value { flex: 1; text-align: right; font-size: 30rpx; color: var(--ic-black); }
.sd__value.is-open { color: var(--ic-black); }
.sd__value--addr { line-height: 1.6; }

.sd__intro { padding: 30rpx 32rpx; }
.sd__intro-text { display: block; margin-top: 18rpx; font-size: 28rpx; color: var(--ic-text-2); line-height: 1.7; }

.sd__actions { display: flex; gap: 20rpx; margin-top: 28rpx; }
.sd__act { flex: 1; }

.sd__bar { position: fixed; left: 0; right: 0; bottom: 0; padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom)); background: var(--ic-white); border-top: 1rpx solid var(--ic-line); }
