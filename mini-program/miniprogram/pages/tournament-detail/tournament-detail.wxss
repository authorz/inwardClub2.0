.td { height: 100vh; display: flex; flex-direction: column; background: var(--ic-white); }
.td__nav { flex: none; background: var(--ic-white); }.td__nav-bar { position: relative; display: flex; align-items: center; justify-content: center; box-sizing: border-box; }.td__nav-title { font-size: 28rpx; font-weight: 700; color: var(--ic-black); }
.td__back { position: absolute; left: 20rpx; top: 0; bottom: 0; width: 72rpx; display: flex; align-items: center; justify-content: center; }.td__back--hover { opacity: .6; }.td__back-arrow { width: 20rpx; height: 20rpx; border-left: 4rpx solid var(--ic-black); border-bottom: 4rpx solid var(--ic-black); transform: rotate(45deg); }
.td__scroll { flex: 1; min-height: 0; box-sizing: border-box; }.td__cover { display: block; width: 100%; height: 300rpx; background: var(--ic-fill); }.td__main { padding: 34rpx 32rpx calc(64rpx + env(safe-area-inset-bottom)); }
.td__title { display: block; font-size: 30rpx; line-height: 1.35; font-weight: 700; color: var(--ic-black); }.td__summary { display: block; margin-top: 14rpx; font-size: 24rpx; line-height: 1.65; color: var(--ic-text-2); }
.td__meta { margin-top: 30rpx; padding: 20rpx 0; border-top: 1rpx solid var(--ic-line); border-bottom: 1rpx solid var(--ic-line); }.td__meta-row { display: flex; align-items: flex-start; gap: 28rpx; padding: 10rpx 0; }.td__meta-label { width: 112rpx; flex: none; font-size: 22rpx; color: var(--ic-text-3); }.td__meta-value { flex: 1; min-width: 0; font-size: 22rpx; line-height: 1.55; color: var(--ic-text); }
.td__detail { padding-top: 36rpx; }.td__section-title { display: block; font-size: 26rpx; font-weight: 700; color: var(--ic-black); }.td__rich { display: block; margin-top: 22rpx; overflow: hidden; font-size: 24rpx; line-height: 1.8; color: var(--ic-text-2); }.td__empty-text { display: block; margin-top: 22rpx; font-size: 24rpx; color: var(--ic-text-3); }
