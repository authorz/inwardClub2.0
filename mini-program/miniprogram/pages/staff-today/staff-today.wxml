<ic-app-background />
<view class="ic-scroll-shell">
<scroll-view class="ic-scroll-view sto__scroll" scroll-y enhanced show-scrollbar="{{false}}" bounces="{{false}}">
<view class="sto">
  <view class="sto__head">
    <text class="sto__title">今日营业明细</text>
    <text class="sto__date">{{date}}</text>
  </view>

  <view class="sto__summary">
    <view class="sto__summary-item">
      <text class="sto__summary-num">{{summary.coinConsumptionAmountText}}</text>
      <text class="sto__summary-label">金币消费 · {{summary.coinConsumptionCount}} 笔</text>
    </view>
    <view class="sto__summary-item">
      <text class="sto__summary-num">{{summary.pointDepositAmountText}}</text>
      <text class="sto__summary-label">积分存入 · {{summary.pointDepositCount}} 笔</text>
    </view>
    <view class="sto__summary-item">
      <text class="sto__summary-num">{{summary.pointWithdrawalAmountText}}</text>
      <text class="sto__summary-label">积分提取 · {{summary.pointWithdrawalCount}} 笔</text>
    </view>
  </view>

  <scroll-view class="sto__tabs" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="sto__tabs-inner">
      <view class="sto__tab {{activeType === item.key ? 'is-active' : ''}}" wx:for="{{tabs}}" wx:key="key" data-type="{{item.key}}" bindtap="selectType">{{item.label}}</view>
    </view>
  </scroll-view>

  <ic-loading wx:if="{{loading}}" />
  <view wx:elif="{{list.length}}" class="sto__list">
    <view class="sto__row" wx:for="{{list}}" wx:key="recordKey">
      <view class="sto__main">
        <view class="sto__row-head">
          <text class="sto__type">{{item.typeLabel}}</text>
          <text class="sto__member ic-ellipsis">{{item.memberName}}</text>
        </view>
        <text class="sto__meta">{{item.phoneText}} · {{item.timeText}}</text>
        <text wx:if="{{item.orderText}}" class="sto__order ic-ellipsis">订单 {{item.orderText}}</text>
      </view>
      <view class="sto__value">
        <text class="sto__amount">{{item.amountText}}</text>
        <text class="sto__status">{{item.statusLabel}}</text>
      </view>
    </view>
  </view>
  <ic-empty wx:else text="今日暂无此类营业记录" />
</view>
</scroll-view>
</view>
