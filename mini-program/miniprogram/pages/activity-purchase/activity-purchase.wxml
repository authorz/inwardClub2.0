<ic-app-background />
<ic-loading wx:if="{{loading}}" theme="dark" />

<view wx:elif="{{loadError}}" class="ap__empty">
  <ic-empty text="{{loadError}}" />
</view>

<view wx:elif="{{activity}}" class="ap">
  <view class="ap__summary ic-glass-recessed">
    <image wx:if="{{activity.imageUrl}}" class="ap__cover" src="{{activity.imageUrl}}" mode="aspectFill" />
    <view class="ap__summary-main">
      <text class="ap__title">{{activity.title}}</text>
      <text wx:if="{{activity.dateText}}" class="ap__meta">{{activity.dateText}}</text>
      <text wx:if="{{activity.storeName}}" class="ap__meta">{{activity.storeName}}</text>
    </view>
  </view>

  <view class="ap__section ic-glass-recessed">
    <text class="ap__section-title">选择票种</text>
    <view wx:if="{{tickets.length}}" class="ap__tickets">
      <view
        class="ap__ticket {{ticketId === item.id ? 'is-active' : ''}} {{item.disabled ? 'is-disabled' : ''}}"
        wx:for="{{tickets}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onPickTicket"
      >
        <view class="ap__radio"><view wx:if="{{ticketId === item.id}}" class="ap__radio-on"></view></view>
        <view class="ap__ticket-main">
          <view class="ap__ticket-line">
            <text class="ap__ticket-name">{{item.name}}</text>
            <text class="ap__ticket-price">¥{{item.priceText}}</text>
          </view>
          <text class="ap__ticket-stock">{{item.metaText}}</text>
        </view>
        <view wx:if="{{ticketId === item.id && payMethod !== 'coupon'}}" class="ap__qty" catchtap="noop">
          <text class="ap__qty-label">购买数量</text>
          <ic-stepper value="{{qty}}" min="{{1}}" max="{{ticket.maxQuantity}}" size="sm" theme="dark" bind:change="onQty" />
        </view>
        <view wx:elif="{{ticketId === item.id}}" class="ap__qty" catchtap="noop">
          <text class="ap__qty-label">兑换数量</text>
          <text class="ap__qty-fixed">1 张</text>
        </view>
      </view>
    </view>
    <view wx:else class="ap__no-ticket">暂无可售门票</view>
  </view>

  <view wx:if="{{ticket}}" class="ap__section ic-glass-recessed">
    <text class="ap__section-title">支付方式</text>
    <ic-pay-methods methods="{{payMethods}}" value="{{payMethod}}" layout="list" theme="dark" bind:change="onPay" />
  </view>

  <view wx:if="{{ticket && payMethod === 'coupon'}}" class="ap__section ic-glass-recessed">
    <text class="ap__section-title">使用门票券</text>
    <view class="ap__coupon-selected" bindtap="openCouponPicker">
      <image class="ap__coupon-icon" src="{{couponIconUrl}}" mode="aspectFit" />
      <view class="ap__coupon-copy">
        <text class="ap__coupon-name">{{selectedCoupon.name}}</text>
        <text class="ap__coupon-expiry">{{selectedCoupon.admissionCount}} 人票券 · 有效期至 {{selectedCoupon.expiryText}}</text>
      </view>
      <text class="ap__coupon-change">更换</text>
      <text class="ap__coupon-chevron">›</text>
    </view>
  </view>

  <view wx:if="{{ticket}}" class="ap__section ap__amount ic-glass-recessed">
    <text class="ap__amount-label">订单金额</text>
    <text class="ap__amount-value">¥{{totalText}}</text>
  </view>

  <view class="ap__bar">
    <view class="ap__bar-total">
      <text class="ap__bar-label">合计</text>
      <text class="ap__bar-amount">¥{{totalText}}</text>
    </view>
    <button
      class="ic-btn ic-glass-recessed ap__submit {{ticket ? '' : 'ic-disabled'}}"
      disabled="{{!ticket}}"
      loading="{{submitting}}"
      bindtap="confirmPurchase"
    >{{payMethod === 'coupon' ? '确认兑换' : '确认支付'}}</button>
  </view>

  <view wx:if="{{couponPickerVisible}}" class="ap__picker-mask" bindtap="closeCouponPicker">
    <view class="ap__picker" catchtap="noop">
      <view class="ap__picker-handle"></view>
      <view class="ap__picker-head">
        <view>
          <text class="ap__picker-title">选择门票券</text>
          <text class="ap__picker-subtitle">按到期时间排序，优先展示即将到期的券</text>
        </view>
        <text class="ap__picker-close" bindtap="closeCouponPicker">关闭</text>
      </view>
      <scroll-view class="ap__picker-list" scroll-y enhanced show-scrollbar="{{false}}">
        <view
          class="ap__coupon ap__picker-item {{couponEntitlementId === item.id ? 'is-active' : ''}}"
          wx:for="{{ticketCoupons}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="onPickCoupon"
        >
          <image class="ap__coupon-icon" src="{{couponIconUrl}}" mode="aspectFit" />
          <view class="ap__coupon-copy">
            <text class="ap__coupon-name">{{item.name}}</text>
            <text class="ap__coupon-expiry">{{item.admissionCount}} 人票券 · 有效期至 {{item.expiryText}}</text>
          </view>
          <view class="ap__radio"><view wx:if="{{couponEntitlementId === item.id}}" class="ap__radio-on"></view></view>
        </view>
      </scroll-view>
    </view>
  </view>
</view>
