.ap {
  min-height: 100vh;
  padding: 24rpx 24rpx calc(176rpx + env(safe-area-inset-bottom));
  background: transparent;
  color: rgba(255, 255, 255, 0.92);
  box-sizing: border-box;
}
.ap__empty { padding-top: 120rpx; }

.ap__summary {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx;
}
.ap__cover {
  width: 136rpx;
  height: 136rpx;
  flex: none;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  border-radius: 18rpx;
  background: rgba(4, 7, 11, 0.34);
  box-sizing: border-box;
}
.ap__summary-main {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  gap: 10rpx;
}
.ap__title {
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.4;
  color: #fff;
}
.ap__meta { font-size: 22rpx; color: rgba(255, 255, 255, 0.68); }

.ap__section {
  margin-top: 20rpx;
  padding: 30rpx 24rpx;
}
.ap__section-title {
  display: block;
  margin-bottom: 22rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #fff;
}
.ap__coupon-selected {
  display: flex;
  align-items: center;
  min-height: 90rpx;
  padding-top: 2rpx;
}
.ap__coupon-icon {
  width: 56rpx;
  height: 56rpx;
  margin-right: 20rpx;
  flex: none;
}
.ap__coupon { display: flex; align-items: center; min-height: 116rpx; border-top: 1rpx solid rgba(255, 255, 255, 0.16); }
.ap__coupon:first-child { border-top: none; }
.ap__coupon-copy { min-width: 0; flex: 1; display: flex; flex-direction: column; gap: 7rpx; }
.ap__coupon-name { font-size: 25rpx; font-weight: 650; color: rgba(255, 255, 255, 0.94); }
.ap__coupon-expiry { font-size: 20rpx; color: rgba(255, 255, 255, 0.58); }
.ap__coupon-change { margin-left: 18rpx; flex: none; font-size: 22rpx; color: rgba(255, 255, 255, 0.78); }
.ap__coupon-chevron { margin-left: 8rpx; flex: none; font-size: 34rpx; line-height: 1; color: rgba(255, 255, 255, 0.56); }
.ap__ticket {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  padding: 26rpx 0;
  border-top: 1rpx solid rgba(255, 255, 255, 0.18);
}
.ap__ticket:first-child { border-top: none; }
.ap__ticket.is-disabled .ap__ticket-name,
.ap__ticket.is-disabled .ap__ticket-price { color: rgba(255, 255, 255, 0.45); }
.ap__ticket.is-disabled .ap__radio { border-color: rgba(255, 255, 255, 0.28); }
.ap__radio {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 38rpx;
  height: 38rpx;
  margin-right: 20rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.5);
  border-radius: 50%;
  box-sizing: border-box;
  flex: none;
}
.ap__ticket.is-active .ap__radio { border-color: #fff; }
.ap__radio-on { width: 18rpx; height: 18rpx; border-radius: 50%; background: #fff; }
.ap__ticket-main { flex: 1; min-width: 0; }
.ap__ticket-line { display: flex; align-items: baseline; justify-content: space-between; gap: 24rpx; }
.ap__ticket-name { font-size: 26rpx; font-weight: 600; color: #fff; }
.ap__ticket-price { flex: none; font-size: 28rpx; font-weight: 700; color: #fff; }
.ap__ticket-stock { display: block; margin-top: 8rpx; font-size: 20rpx; color: rgba(255, 255, 255, 0.62); }
.ap__qty {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  margin-top: 24rpx;
  padding: 22rpx 0 0 58rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.18);
  box-sizing: border-box;
}
.ap__qty-label { font-size: 24rpx; color: #fff; }
.ap__no-ticket { padding: 30rpx 0 12rpx; font-size: 24rpx; color: rgba(255, 255, 255, 0.62); }

.ap__amount { display: flex; align-items: center; justify-content: space-between; }
.ap__amount-label { font-size: 24rpx; color: #fff; }
.ap__amount-value { font-size: 28rpx; font-weight: 700; color: #fff; }

.ap__bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 40;
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 30rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(41, 41, 44, 0), rgba(41, 41, 44, 0.94) 42%);
  box-sizing: border-box;
}
.ap__bar-total { display: flex; min-width: 180rpx; flex-direction: column; }
.ap__bar-label { font-size: 20rpx; color: #fff; }
.ap__bar-amount { margin-top: 2rpx; font-size: 30rpx; font-weight: 700; color: #fff; }
.ap__submit {
  flex: 1;
  width: auto !important;
  height: 88rpx;
  margin-left: 0 !important;
  margin-right: 0 !important;
  border-radius: 999rpx;
  color: rgba(255, 255, 255, 0.96);
}
.ap__submit.ic-glass-recessed {
  border-color: rgba(255, 255, 255, 0.24);
  background: rgba(168, 180, 198, 0.2);
  -webkit-backdrop-filter: blur(40rpx) saturate(155%) brightness(0.98);
  backdrop-filter: blur(40rpx) saturate(155%) brightness(0.98);
}
.ap__submit.ic-glass-recessed::before {
  right: 22rpx;
  left: 22rpx;
  height: 38rpx;
  border-radius: 999rpx 999rpx 45% 45%;
}
.ap__submit.ic-disabled {
  border-color: rgba(255, 255, 255, 0.1);
  background: rgba(168, 180, 198, 0.09);
  color: rgba(255, 255, 255, 0.46);
}

.ap__picker-mask {
  position: fixed;
  z-index: 90;
  inset: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(0, 0, 0, 0.56);
}
.ap__picker {
  width: 100%;
  padding: 14rpx 30rpx calc(24rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 36rpx 36rpx 0 0;
  background: rgba(20, 24, 30, 0.88);
  -webkit-backdrop-filter: blur(40rpx) saturate(145%);
  backdrop-filter: blur(40rpx) saturate(145%);
  box-sizing: border-box;
}
.ap__picker-handle {
  width: 72rpx;
  height: 7rpx;
  margin: 0 auto 26rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.28);
}
.ap__picker-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 28rpx;
  padding-bottom: 20rpx;
}
.ap__picker-title { display: block; font-size: 30rpx; font-weight: 700; color: #fff; }
.ap__picker-subtitle { display: block; margin-top: 8rpx; font-size: 20rpx; color: rgba(255, 255, 255, 0.58); }
.ap__picker-close { padding: 4rpx 0 16rpx 24rpx; flex: none; font-size: 23rpx; color: rgba(255, 255, 255, 0.72); }
.ap__picker-list { max-height: 620rpx; }
.ap__picker-item { padding: 6rpx 0; }
.ap__picker-item.is-active .ap__radio { border-color: #fff; }
.ap__picker-item .ap__radio { margin-right: 0; margin-left: 20rpx; }
