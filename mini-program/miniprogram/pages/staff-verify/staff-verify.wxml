<ic-app-background />
<view class="ic-scroll-shell">
<scroll-view class="ic-scroll-view sv__scroll" scroll-y enhanced show-scrollbar="{{false}}" lower-threshold="120" bindscrolltolower="loadMore" refresher-enabled refresher-triggered="{{refreshing}}" bindrefresherrefresh="onPullDownRefresh">
<ic-loading wx:if="{{loading}}" />

<view wx:else class="sv">
  <view class="sv__store">
    <text class="sv__store-label">当前门店</text>
    <text class="sv__store-name ic-ellipsis">{{storeName}}</text>
  </view>

  <view class="sv__actions">
    <view class="sv__action" hover-class="sv__action--hover" bindtap="scan">
      <view class="ic-ic ic-ic-scan"></view>
      <text class="sv__action-text">扫码核销</text>
    </view>
    <view class="sv__action" hover-class="sv__action--hover" bindtap="manual">
      <view class="ic-ic ic-ic-doc"></view>
      <text class="sv__action-text">手输核销码</text>
    </view>
  </view>

  <view wx:if="{{lastResult}}" class="sv__result {{lastResult.success ? 'is-ok' : 'is-fail'}}">
    <text class="sv__result-title">{{lastResult.resultLabel}}</text>
    <text class="sv__result-code">{{lastResult.codeText}}</text>
    <text wx:if="{{lastResult.message}}" class="sv__result-msg">{{lastResult.message}}</text>
  </view>

  <view wx:if="{{todayActivity}}" class="sv__today ic-card">
    <view class="sv__today-head"><view class="ic-ic ic-ic-calendar ic-ic--sm"></view><text>今日活动</text></view>
    <view class="sv__today-body">
      <view class="sv__today-main">
        <text class="sv__today-title">{{todayActivity.title}}</text>
        <text class="sv__today-time">{{todayActivity.timeText}}</text>
      </view>
      <view class="sv__today-pending"><text class="sv__today-num">{{todayActivity.pendingVerify}}</text><text class="sv__today-label">待核销</text></view>
    </view>
  </view>

  <view class="sv__stats ic-card">
    <view class="sv__stats-head"><view class="ic-ic ic-ic-doc ic-ic--sm"></view><text>核销结果</text></view>
    <view class="sv__stats-row">
      <view class="sv__stat"><text class="sv__stat-num">{{stats.today}}</text><text class="sv__stat-label">今日核销</text></view>
      <view class="sv__stat"><text class="sv__stat-num">{{stats.total}}</text><text class="sv__stat-label">累计核销</text></view>
    </view>
  </view>

  <view class="sv__history">
    <text class="ic-h2 sv__history-title">核销历史</text>
    <view class="sv__state" wx:if="{{errorText && !verifications.length}}">
      <text class="sv__state-text">{{errorText}}</text>
      <button class="sv__retry" bindtap="retry">重新加载</button>
    </view>
    <view class="sv__hist ic-card" wx:elif="{{verifications.length}}">
      <view class="sv__hist-row" wx:for="{{verifications}}" wx:key="id">
        <view class="sv__hist-main">
          <text class="sv__hist-code">{{item.code}}</text>
          <text class="sv__hist-time">{{item.timeText}} · {{item.memberName}}</text>
        </view>
        <text class="sv__hist-result {{item.success ? 'is-ok' : 'is-fail'}}">{{item.resultLabel}}</text>
      </view>
    </view>
    <ic-empty wx:else text="暂无核销记录" compact="{{true}}" />
    <view wx:if="{{loadingMore}}" class="sv__footer">正在加载…</view>
    <view wx:elif="{{verifications.length && !hasMore}}" class="sv__footer">已经到底了</view>
  </view>
</view>
</scroll-view>
</view>
