.wl { min-height: calc(100vh - 88rpx); background: transparent; padding: 28rpx 32rpx calc(48rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
.wl__filters { padding: 18rpx; }
.wl__seg { margin-top: 0; }
.wl__dir { margin-top: 8rpx; padding: 0 8rpx; }
.wl__list { margin-top: 24rpx; padding: 6rpx 28rpx; }
.wl__row { display: flex; align-items: center; justify-content: space-between; gap: 24rpx; padding: 30rpx 0; border-bottom: 1rpx solid rgba(255, 255, 255, 0.12); }
.wl__row:last-child { border-bottom: none; }
.wl__row-main { display: flex; flex-direction: column; gap: 8rpx; min-width: 0; }
.wl__row-title { font-size: 24rpx; font-weight: 500; line-height: 1.45; color: rgba(255, 255, 255, 0.94); }
.wl__row-meta { display: flex; align-items: center; gap: 8rpx; min-width: 0; font-size: 22rpx; line-height: 1.4; color: rgba(255, 255, 255, 0.58); }
.wl__row-note { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.wl__row-separator, .wl__row-time { flex: none; }
.wl__row-delta { flex: none; font-size: 28rpx; font-weight: 500; line-height: 1.3; color: rgba(255, 255, 255, 0.96); font-variant-numeric: tabular-nums; }
.wl__foot { display: block; text-align: center; margin-top: 32rpx; font-size: 20rpx; line-height: 1.4; color: rgba(255, 255, 255, 0.48); }
