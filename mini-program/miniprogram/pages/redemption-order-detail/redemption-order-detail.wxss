.rod__item { display: flex; align-items: center; gap: 24rpx; }
.rod__glass { width: 88rpx; height: 88rpx; border-radius: 16rpx; background: var(--ic-fill); display: flex; align-items: center; justify-content: center; flex: none; }
.rod__item-main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 8rpx; }
.rod__item-title { font-size: 28rpx; font-weight: 700; color: var(--ic-black); }
.rod__item-sub { font-size: 22rpx; color: var(--ic-text-3); }
.rod__valid { font-size: 20rpx; color: var(--ic-text-3); flex: none; }

.rod__code { display: flex; flex-direction: column; align-items: center; gap: 16rpx; }
.rod__code-label { font-size: 22rpx; color: var(--ic-text-3); margin-top: 8rpx; }
.rod__code-num { display: inline-flex; align-items: center; gap: 14rpx; font-size: 30rpx; font-weight: 700; color: var(--ic-black); letter-spacing: 4rpx; font-variant-numeric: tabular-nums; }
.rod__code-hint { font-size: 22rpx; color: var(--ic-text-3); }
