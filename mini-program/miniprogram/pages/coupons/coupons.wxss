.cp { min-height: 100vh; background: var(--ic-bg); }
.cp__seg { background: var(--ic-white); padding: 0 24rpx; }
.cp__count { display: block; padding: 24rpx 32rpx 4rpx; font-size: 22rpx; font-weight: 600; color: var(--ic-text-3); }
.cp__list { padding: 14rpx 24rpx 8rpx; }
.cp__card {
  position: relative;
  display: flex;
  align-items: center;
  gap: 24rpx;
  min-height: 180rpx;
  background: var(--ic-white);
  border-radius: 16rpx;
  padding: 28rpx 28rpx 28rpx 30rpx;
  margin-bottom: 18rpx;
  overflow: hidden;
}
.cp__card::before,
.cp__card::after {
  content: "";
  position: absolute;
  top: 50%;
  width: 26rpx;
  height: 52rpx;
  margin-top: -26rpx;
  border-radius: 999rpx;
  background: var(--ic-bg);
}
.cp__card::before { left: -13rpx; }
.cp__card::after { right: -13rpx; }
.cp__card.is-dim { background: #fbfbfb; }
.cp__card.is-dim .cp__icon { filter: grayscale(1); opacity: 0.28; }
.cp__card.is-dim .cp__name,
.cp__card.is-dim .cp__amount,
.cp__card.is-dim .cp__desc,
.cp__card.is-dim .cp__valid { color: var(--ic-text-4); }
.cp__left {
  width: 96rpx;
  height: 96rpx;
  border-radius: 12rpx;
  background: var(--ic-fill-2);
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}
.cp__icon { width: 78rpx; height: 78rpx; display: block; }
.cp__mid { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 8rpx; }
.cp__name { font-size: 28rpx; font-weight: 700; color: var(--ic-black); line-height: 1.2; }
.cp__amount { font-size: 24rpx; font-weight: 700; color: var(--ic-black); line-height: 1.3; }
.cp__desc { font-size: 22rpx; color: var(--ic-text-2); line-height: 1.35; }
.cp__valid { font-size: 22rpx; color: var(--ic-text-4); line-height: 1.35; }
.cp__right { width: 230rpx; flex: none; display: flex; justify-content: flex-end; }
.cp__action {
  width: 220rpx;
  height: 72rpx;
  border-radius: 999rpx;
  background: var(--ic-black);
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}
.cp__action--hover { opacity: 0.82; }
.cp__stamp {
  min-width: 136rpx;
  height: 56rpx;
  padding: 0 22rpx;
  border: 2rpx solid var(--ic-line-strong);
  border-radius: 999rpx;
  color: var(--ic-text-3);
  font-size: 22rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}
.cp__stamp--used { color: #606060; border-color: #cfcfcf; }
.cp__stamp--expired { color: #a8a8a8; border-color: #dedede; }
.cp__records { display: flex; align-items: center; justify-content: center; gap: 10rpx; padding: 34rpx 0 48rpx; font-size: 24rpx; color: var(--ic-text-2); }
