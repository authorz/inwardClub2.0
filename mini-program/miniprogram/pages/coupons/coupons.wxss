.cp { min-height: 0; padding: 24rpx 24rpx calc(48rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
.cp__seg { padding: 0 18rpx; box-sizing: border-box; white-space: nowrap; }
.cp__count { display: block; padding: 26rpx 8rpx 4rpx; font-size: 22rpx; font-weight: 600; color: rgba(255, 255, 255, 0.62); }
.cp__list { padding: 14rpx 0 8rpx; }
.cp__card {
  position: relative;
  display: flex;
  align-items: center;
  gap: 24rpx;
  min-height: 180rpx;
  padding: 28rpx 28rpx 28rpx 30rpx;
  margin-bottom: 18rpx;
  overflow: hidden;
}
.cp__left {
  width: 96rpx;
  height: 96rpx;
  border-radius: 12rpx;
  background: rgba(4, 7, 11, 0.22);
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}
.cp__icon { width: 78rpx; height: 78rpx; display: block; }
.cp__mid { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 8rpx; }
.cp__name { font-size: 28rpx; font-weight: 700; color: rgba(255, 255, 255, 0.96); line-height: 1.2; }
.cp__type { font-size: 23rpx; font-weight: 650; color: rgba(255, 255, 255, 0.86); line-height: 1.3; }
.cp__desc { font-size: 22rpx; color: rgba(255, 255, 255, 0.68); line-height: 1.35; }
.cp__valid { font-size: 22rpx; color: rgba(255, 255, 255, 0.5); line-height: 1.35; }
.cp__right { width: 170rpx; flex: none; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12rpx; }
.cp__countdown {
  width: 100%;
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  line-height: 1.3;
  text-align: center;
}
.cp__action {
  width: 164rpx;
  height: 72rpx;
  border-radius: 999rpx;
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}
.cp__action--hover { opacity: 0.82; }
.cp__records { display: flex; align-items: center; justify-content: center; gap: 10rpx; padding: 34rpx 0 48rpx; font-size: 24rpx; color: rgba(255, 255, 255, 0.72); }
