/* 近期活动 — 深色黑灰渐变，自定义导航，扇形相册堆叠卡片 */
.al {
  position: relative;
  height: 100vh;
  min-height: 0;
  width: 100%;
  max-width: 100vw;
  padding-bottom: 0;
  box-sizing: border-box;
  /* Cards fan past the viewport edge; clip horizontally so the neighbours
     peek off-screen instead of creating a scrollable strip / white edge. */
  overflow-x: hidden;
  background: linear-gradient(180deg, #303030 0%, #1c1c1c 42%, #0c0c0c 100%);
}
.al__scroll { height: 100%; }

/* The selected poster supplies atmosphere only: it fills the viewport's upper
   half, while the shade keeps navigation and content legible. */
.al__backdrop {
  position: absolute;
  z-index: 0;
  top: 0;
  left: 0;
  width: 100%;
  height: 50vh;
  overflow: hidden;
  pointer-events: none;
}
.al__backdrop-image {
  position: absolute;
  top: -5%;
  left: -5%;
  width: 110%;
  height: 110%;
  filter: blur(30rpx);
  opacity: 0.58;
}
.al__backdrop-shade {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: linear-gradient(180deg, rgba(12, 12, 12, 0.28) 0%, rgba(12, 12, 12, 0.46) 58%, #1c1c1c 100%);
}
.al__foreground {
  position: relative;
  z-index: 1;
  min-height: 100%;
  padding-bottom: 80rpx;
  box-sizing: border-box;
}

/* ---- custom navigation ---- */
.al__nav { position: fixed; top: 0; right: 0; left: 0; z-index: 40; }
.al__nav-spacer { width: 100%; pointer-events: none; }
.al__nav-bar {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  padding-left: 24rpx;
}
.al__nav-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.al__nav-arrow {
  width: 20rpx;
  height: 20rpx;
  border-left: 4rpx solid rgba(255, 255, 255, 0.92);
  border-bottom: 4rpx solid rgba(255, 255, 255, 0.92);
  transform: rotate(45deg);
  margin-left: 6rpx;
}
/* ---- left-aligned heading: 近期活动 / 精彩回顾 tabs ---- */
.al__head {
  display: flex;
  align-items: baseline;
  gap: 28rpx;
  padding: 40rpx 48rpx 36rpx;
}
.al__head-title {
  font-size: 34rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.4);
  letter-spacing: 2rpx;
  transition: color 0.2s, font-size 0.2s;
}
.al__head-title.is-active {
  font-size: 38rpx;
  color: rgba(255, 255, 255, 0.95);
}
.al__body { margin-top: 20px; }

/* ---- 精彩回顾 list ---- */
.al__reviews { padding: 8rpx 32rpx 40rpx; }
.al__review {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 18rpx;
}
.al__review.ic-glass-recessed {
  border-color: rgba(255, 255, 255, 0.2);
  border-radius: 24rpx;
  background: rgba(168, 180, 198, 0.17);
  -webkit-backdrop-filter: blur(38rpx) saturate(150%) brightness(0.98);
  backdrop-filter: blur(38rpx) saturate(150%) brightness(0.98);
  box-shadow:
    inset 0 5rpx 9rpx rgba(4, 7, 11, 0.27),
    inset 0 -2rpx 3rpx rgba(255, 255, 255, 0.16),
    inset 1rpx 0 2rpx rgba(0, 0, 0, 0.08),
    inset -1rpx 0 2rpx rgba(255, 255, 255, 0.05);
}
.al__review.ic-glass-recessed::before {
  right: 16rpx;
  left: 16rpx;
  height: 40rpx;
  border-radius: 24rpx 24rpx 40% 40%;
}
.al__review + .al__review { margin-top: 20rpx; }
.al__review:active { background: rgba(188, 199, 213, 0.23); }
.al__review-media {
  position: relative;
  z-index: 1;
  width: 184rpx;
  height: 196rpx;
  flex: none;
  overflow: hidden;
  box-sizing: border-box;
  border: 1rpx solid rgba(255, 255, 255, 0.13);
  border-radius: 14rpx;
  background: rgba(4, 7, 11, 0.3);
}
.al__review-image {
  display: block;
  width: 100%;
  height: 100%;
  transform: scale(1.35);
  transform-origin: center top;
}
.al__review-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.04);
}
.al__review-placeholder-logo { width: 116rpx; height: 52rpx; opacity: 0.26; }
.al__review-main { position: relative; z-index: 1; flex: 1; min-width: 0; }
.al__review-title { display: block; font-size: 28rpx; font-weight: 600; line-height: 1.4; color: rgba(255, 255, 255, 0.94); }
.al__review-meta { display: flex; align-items: center; gap: 16rpx; margin-top: 12rpx; min-width: 0; }
.al__review-time { flex: none; font-size: 22rpx; color: rgba(255, 255, 255, 0.6); }
.al__review-store { font-size: 22rpx; color: rgba(255, 255, 255, 0.6); min-width: 0; }
.al__review-arrow {
  position: relative;
  z-index: 1;
  flex: none;
  width: 16rpx;
  height: 16rpx;
  border-top: 3rpx solid rgba(255, 255, 255, 0.62);
  border-right: 3rpx solid rgba(255, 255, 255, 0.62);
  transform: rotate(45deg);
}
.al__review-footer {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(255, 255, 255, 0.38);
  font-size: 22rpx;
}
.al__review-retry { color: rgba(255, 255, 255, 0.72); }

/* ---- empty ---- */
.al__empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
}
.al__empty-icon { width: 320rpx; height: 320rpx; }
.al__empty-text { margin-top: 20rpx; font-size: 24rpx; color: rgba(255, 255, 255, 0.42); }
.al__empty--error { padding-top: 240rpx; }
.al__empty-title { font-size: 26rpx; color: rgba(255, 255, 255, 0.72); }
.al__retry {
  min-width: 200rpx;
  height: 72rpx;
  margin-top: 28rpx;
  padding: 0 32rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.92);
  color: #111111;
  font-size: 24rpx;
  line-height: 72rpx;
}
.al__retry::after { border: none; }

/* ---- card stack carousel lives in the ic-tower-swiper component ---- */

.al__dots { display: flex; justify-content: center; gap: 12rpx; margin-top: 22rpx; }
.al__dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: rgba(255, 255, 255, 0.25); transition: width 0.25s; }
.al__dot.is-active { background: #ffffff; width: 26rpx; border-radius: 6rpx; }

/* ---- selected info ---- */
.al__info { display: flex; flex-direction: column; align-items: center; padding: 20rpx 48rpx 8rpx; text-align: center; }
.al__info-title { font-size: 30rpx; font-weight: 700; color: #ffffff; line-height: 1.35; }
.al__date { margin-top: 20rpx; color: rgba(255, 255, 255, 0.42); font-size: 24rpx; letter-spacing: 1rpx; }
.al__detail {
  margin-top: 40rpx;
  min-width: 320rpx;
  height: 96rpx;
  padding: 0 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  line-height: 1;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.92);
  color: #111111;
  font-size: 26rpx;
  font-weight: 600;
}
.al__detail::after { border: none; }
.al__detail .ic-ic { width: 40rpx; height: 40rpx; color: #111111; }
