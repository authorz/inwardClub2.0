/* 近期活动 — 深色黑灰渐变，自定义导航，扇形相册堆叠卡片 */
.al {
  position: relative;
  min-height: 100vh;
  width: 100%;
  max-width: 100vw;
  padding-bottom: 80rpx;
  box-sizing: border-box;
  /* Cards fan past the viewport edge; clip horizontally so the neighbours
     peek off-screen instead of creating a scrollable strip / white edge. */
  overflow-x: hidden;
  background: linear-gradient(180deg, #303030 0%, #1c1c1c 42%, #0c0c0c 100%);
}

/* The selected poster supplies atmosphere only: it fills the viewport's upper
   half, while the shade keeps navigation and content legible. */
.al__backdrop {
  position: absolute;
  z-index: 0;
  top: 0;
  left: 0;
  width: 100%;
  height: 50vh;
  overflow: hidden;
  pointer-events: none;
}
.al__backdrop-image {
  position: absolute;
  top: -5%;
  left: -5%;
  width: 110%;
  height: 110%;
  filter: blur(30rpx);
  opacity: 0.58;
}
.al__backdrop-shade {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: linear-gradient(180deg, rgba(12, 12, 12, 0.28) 0%, rgba(12, 12, 12, 0.46) 58%, #1c1c1c 100%);
}
.al__foreground {
  position: relative;
  z-index: 1;
}

/* ---- custom navigation ---- */
.al__nav { position: relative; }
.al__nav-bar {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  padding-left: 24rpx;
}
.al__nav-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.al__nav-arrow {
  width: 20rpx;
  height: 20rpx;
  border-left: 4rpx solid rgba(255, 255, 255, 0.92);
  border-bottom: 4rpx solid rgba(255, 255, 255, 0.92);
  transform: rotate(45deg);
  margin-left: 6rpx;
}
/* ---- left-aligned heading: 近期活动 / 精彩回顾 tabs ---- */
.al__head {
  display: flex;
  align-items: baseline;
  gap: 28rpx;
  padding: 40rpx 48rpx 36rpx;
}
.al__head-title {
  font-size: 28rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.4);
  letter-spacing: 2rpx;
  transition: color 0.2s, font-size 0.2s;
}
.al__head-title.is-active {
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.95);
}

/* ---- 精彩回顾 list ---- */
.al__reviews { padding: 8rpx 32rpx 40rpx; }
.al__review {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 32rpx 28rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}
.al__review + .al__review { margin-top: 20rpx; }
.al__review:active { background: rgba(255, 255, 255, 0.1); }
.al__review-main { flex: 1; min-width: 0; }
.al__review-title { display: block; font-size: 28rpx; font-weight: 600; color: rgba(255, 255, 255, 0.92); }
.al__review-meta { display: flex; align-items: center; gap: 16rpx; margin-top: 12rpx; min-width: 0; }
.al__review-time { flex: none; font-size: 22rpx; color: rgba(255, 255, 255, 0.42); }
.al__review-store { font-size: 22rpx; color: rgba(255, 255, 255, 0.42); min-width: 0; }
.al__review-arrow {
  flex: none;
  width: 16rpx;
  height: 16rpx;
  border-top: 3rpx solid rgba(255, 255, 255, 0.35);
  border-right: 3rpx solid rgba(255, 255, 255, 0.35);
  transform: rotate(45deg);
}

/* ---- empty ---- */
.al__empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
}
.al__empty-icon { width: 320rpx; height: 320rpx; }
.al__empty-text { margin-top: 20rpx; font-size: 24rpx; color: rgba(255, 255, 255, 0.42); }

/* ---- card stack carousel lives in the ic-tower-swiper component ---- */

.al__dots { display: flex; justify-content: center; gap: 12rpx; margin-top: 22rpx; }
.al__dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: rgba(255, 255, 255, 0.25); transition: width 0.25s; }
.al__dot.is-active { background: #ffffff; width: 26rpx; border-radius: 6rpx; }

/* ---- selected info ---- */
.al__info { display: flex; flex-direction: column; align-items: center; padding: 20rpx 48rpx 8rpx; text-align: center; }
.al__info-title { font-size: 30rpx; font-weight: 700; color: #ffffff; line-height: 1.35; }
.al__date { margin-top: 20rpx; color: rgba(255, 255, 255, 0.42); font-size: 24rpx; letter-spacing: 1rpx; }
.al__detail {
  margin-top: 40rpx;
  min-width: 320rpx;
  height: 96rpx;
  padding: 0 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  line-height: 1;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.92);
  color: #111111;
  font-size: 26rpx;
  font-weight: 600;
}
.al__detail::after { border: none; }
.al__detail .ic-ic { width: 40rpx; height: 40rpx; color: #111111; }
