/* =====================================================================
 * InwardClub 2.0 — reusable utility classes (class selectors ONLY).
 *
 * Safe to @import from both app.wxss (pages) and component wxss: it contains
 * NO `page` / tag / id / attribute selectors, so WeChat's component-scope
 * selector restriction never triggers. The design variables and page base
 * live in styles/vars.wxss (imported globally); the var(--ic-*) tokens used
 * below are inherited into components from `page`.
 * ===================================================================== */

/* ---- layout helpers ---- */
.ic-page { min-height: 100vh; box-sizing: border-box; }
.ic-safe-bottom { padding-bottom: calc(env(safe-area-inset-bottom) + 24rpx); }
.ic-section { background: var(--ic-white); }
.ic-band { height: 20rpx; background: var(--ic-bg); }
.ic-pad { padding: var(--ic-pad); }
.ic-px { padding-left: var(--ic-pad); padding-right: var(--ic-pad); }
.ic-divider { height: 1rpx; background: var(--ic-line); }
.ic-row { display: flex; align-items: center; }
.ic-between { display: flex; align-items: center; justify-content: space-between; }
.ic-col { display: flex; flex-direction: column; }
.ic-grow { flex: 1; min-width: 0; }
.ic-center { display: flex; align-items: center; justify-content: center; }

/* ---- typography ---- */
.ic-title { font-size: 40rpx; font-weight: 700; color: var(--ic-black); }
.ic-h2 { font-size: 34rpx; font-weight: 700; color: var(--ic-black); }
.ic-num { font-size: 48rpx; font-weight: 700; color: var(--ic-black); font-variant-numeric: tabular-nums; }
.ic-body { font-size: 28rpx; color: var(--ic-text); }
.ic-sub { font-size: 24rpx; color: var(--ic-text-3); }
.ic-muted { color: var(--ic-text-3); }
.ic-strong { font-weight: 600; color: var(--ic-black); }
.ic-ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.ic-clamp-2 {
  display: -webkit-box; -webkit-box-orient: vertical;
  -webkit-line-clamp: 2; overflow: hidden;
}
.ic-price::before { content: "¥"; font-size: 0.72em; margin-right: 2rpx; }

/* ---- buttons ---- */
.ic-btn {
  display: inline-flex; align-items: center; justify-content: center;
  height: 96rpx; padding: 0 40rpx; border-radius: var(--ic-radius);
  font-size: 30rpx; font-weight: 600; box-sizing: border-box; border: none;
}
.ic-btn::after { border: none; }
.ic-btn-primary { background: var(--ic-black); color: var(--ic-white); }
.ic-btn-primary.ic-disabled { background: #cccccc; color: #ffffff; }
.ic-btn-ghost { background: var(--ic-white); color: var(--ic-black); border: 1rpx solid var(--ic-line-strong); }
.ic-btn-pill { border-radius: var(--ic-radius-pill); }
.ic-btn-block { width: 100%; }
.ic-btn-sm { height: 64rpx; padding: 0 28rpx; font-size: 24rpx; }

/* ---- pills / tags ---- */
.ic-tag {
  display: inline-flex; align-items: center; height: 40rpx; padding: 0 16rpx;
  border-radius: 8rpx; font-size: 22rpx; background: var(--ic-fill); color: var(--ic-text-2);
}
.ic-tag-dark { background: var(--ic-black); color: var(--ic-white); }
.ic-dot { width: 12rpx; height: 12rpx; border-radius: 50%; margin-right: 10rpx; }

/* status text colors (never color-only: paired with text/icon in markup) */
.is-success { color: var(--ic-success); }
.is-danger { color: var(--ic-danger); }
.is-warn { color: var(--ic-warn); }

/* generic cell (label / value / arrow) */
.ic-cell { display: flex; align-items: center; min-height: 108rpx; padding: 24rpx 0; }
.ic-cell__label { color: var(--ic-text); font-size: 30rpx; }
.ic-cell__value { flex: 1; text-align: right; color: var(--ic-text-2); font-size: 30rpx; }
.ic-arrow { width: 14rpx; height: 14rpx; margin-left: 12rpx; border-right: 3rpx solid var(--ic-text-4); border-top: 3rpx solid var(--ic-text-4); transform: rotate(45deg); }

/* fade-in for lazily loaded content */
.ic-fade { animation: ic-fade 0.24s ease; }
@keyframes ic-fade { from { opacity: 0; } to { opacity: 1; } }

/* ---- detail page scaffold (order / reservation details) ---- */
.od { min-height: 100vh; background: var(--ic-bg); padding: 24rpx; box-sizing: border-box; }
.od-head { display: flex; flex-direction: column; align-items: center; padding: 30rpx 0 34rpx; }
.od-head__icon { width: 96rpx; height: 96rpx; border-radius: 50%; background: var(--ic-black); display: flex; align-items: center; justify-content: center; margin-bottom: 20rpx; }
.od-head__icon .ic-ic { color: #fff; }
.od-head__status { font-size: 34rpx; font-weight: 700; color: var(--ic-black); }
.od-head__no { margin-top: 12rpx; font-size: 24rpx; color: var(--ic-text-3); }
.od-card { background: var(--ic-white); border-radius: var(--ic-radius); padding: 4rpx 32rpx; margin-bottom: 24rpx; }
.od-card--pad { padding: 30rpx 32rpx; }
.od-row { display: flex; align-items: center; justify-content: space-between; gap: 24rpx; min-height: 96rpx; padding: 22rpx 0; border-bottom: 1rpx solid var(--ic-line); }
.od-row:last-child { border-bottom: none; }
.od-row__label { font-size: 30rpx; color: var(--ic-text-2); flex: none; }
.od-row__value { flex: 1; text-align: right; font-size: 30rpx; color: var(--ic-black); min-width: 0; }
.od-row__value--strong { font-weight: 700; }
.od-row__value--big { font-size: 40rpx; font-weight: 700; font-variant-numeric: tabular-nums; }
.od-bar { display: flex; gap: 20rpx; margin-top: 12rpx; }
.od-bar .ic-btn { flex: 1; }

/* ---- code block (核销码/兑换码 rendered from interface data) ---- */
.ic-qr { display: inline-flex; flex-direction: column; padding: 18rpx; background: #fff; border: 1rpx solid var(--ic-line); border-radius: 16rpx; }
.ic-qr__row { display: flex; }
.ic-qr__cell { width: 12rpx; height: 12rpx; }
.ic-qr__cell--on { background: #111; }

/* ---- bottom-sheet content helpers (shared by asset sheets, purchase, confirm) ---- */
.sheet-row { display: flex; align-items: center; justify-content: space-between; padding: 24rpx 0; }
.sheet-row--bordered { border-top: 1rpx solid var(--ic-line); }
.sheet-row__label { font-size: 30rpx; color: var(--ic-text); }
.sheet-row__num { font-size: 40rpx; font-weight: 700; color: var(--ic-black); font-variant-numeric: tabular-nums; }
.sheet-note { display: block; margin-top: 16rpx; font-size: 22rpx; color: var(--ic-text-3); }

/* ---- generic containers (compose, never nest cards in cards) ---- */
.ic-card { background: var(--ic-white); border-radius: var(--ic-radius); overflow: hidden; }
.ic-card-pad { padding: var(--ic-pad); }
.ic-page--tab { padding-bottom: calc(140rpx + env(safe-area-inset-bottom)); }
.ic-hairline { border-bottom: 1rpx solid var(--ic-line); }

/* =====================================================================
 * Line icons — pure CSS, class + pseudo-element selectors only (safe to
 * @import into component wxss). Stroke uses currentColor so a parent's
 * `color` tints/sizes the whole set; masks assume a white surface.
 * Usage: <view class="ic-ic ic-ic-ticket"></view>
 * ===================================================================== */
.ic-ic { display: inline-block; position: relative; width: 44rpx; height: 44rpx; box-sizing: border-box; flex: none; color: var(--ic-black); }
.ic-ic--sm { width: 36rpx; height: 36rpx; }

.ic-ic-ticket { border: 2rpx solid currentColor; border-radius: 8rpx; }
.ic-ic-ticket::before, .ic-ic-ticket::after { content: ""; position: absolute; top: 50%; width: 14rpx; height: 14rpx; margin-top: -7rpx; border-radius: 50%; background: var(--ic-white); border: 2rpx solid currentColor; }
.ic-ic-ticket::before { left: -8rpx; }
.ic-ic-ticket::after { right: -8rpx; }

.ic-ic-coupon { background: url("/assets/icons/coupon-gpt.png") center / contain no-repeat; }

.ic-ic-list::before { content: ""; position: absolute; left: 4rpx; right: 4rpx; top: 10rpx; height: 3rpx; background: currentColor; box-shadow: 0 11rpx 0 currentColor, 0 22rpx 0 currentColor; }

.ic-ic-dining::before { content: ""; position: absolute; left: 4rpx; right: 4rpx; top: 12rpx; height: 20rpx; border: 2rpx solid currentColor; border-bottom: none; border-radius: 20rpx 20rpx 0 0; }
.ic-ic-dining::after { content: ""; position: absolute; left: 2rpx; right: 2rpx; top: 32rpx; height: 2rpx; background: currentColor; }

.ic-ic-calendar { border: 2rpx solid currentColor; border-radius: 6rpx; }
.ic-ic-calendar::before { content: ""; position: absolute; left: -2rpx; right: -2rpx; top: 9rpx; height: 2rpx; background: currentColor; }
.ic-ic-calendar::after { content: ""; position: absolute; top: -6rpx; left: 12rpx; width: 2rpx; height: 8rpx; background: currentColor; box-shadow: 18rpx 0 0 currentColor; }

.ic-ic-wallet { border: 2rpx solid currentColor; border-radius: 8rpx; }
.ic-ic-wallet::before { content: ""; position: absolute; right: -2rpx; top: 13rpx; width: 14rpx; height: 14rpx; border: 2rpx solid currentColor; border-radius: 4rpx; background: var(--ic-white); }

.ic-ic-bag::before { content: ""; position: absolute; left: 6rpx; right: 6rpx; top: 14rpx; bottom: 4rpx; border: 2rpx solid currentColor; border-radius: 0 0 6rpx 6rpx; }
.ic-ic-bag::after { content: ""; position: absolute; left: 13rpx; top: 6rpx; width: 18rpx; height: 14rpx; border: 2rpx solid currentColor; border-bottom: none; border-radius: 10rpx 10rpx 0 0; }

.ic-ic-person::before { content: ""; position: absolute; left: 50%; top: 6rpx; width: 16rpx; height: 16rpx; margin-left: -8rpx; border: 2rpx solid currentColor; border-radius: 50%; }
.ic-ic-person::after { content: ""; position: absolute; left: 50%; top: 26rpx; width: 28rpx; height: 16rpx; margin-left: -14rpx; border: 2rpx solid currentColor; border-bottom: none; border-radius: 16rpx 16rpx 0 0; }

.ic-ic-invite::before { content: ""; position: absolute; left: 10rpx; top: 8rpx; width: 16rpx; height: 16rpx; border: 2rpx solid currentColor; border-radius: 50%; }
.ic-ic-invite::after { content: ""; position: absolute; left: 4rpx; top: 26rpx; width: 26rpx; height: 14rpx; border: 2rpx solid currentColor; border-bottom: none; border-radius: 14rpx 14rpx 0 0; }
.ic-ic-invite { background: linear-gradient(currentColor, currentColor) no-repeat, linear-gradient(currentColor, currentColor) no-repeat; background-size: 12rpx 2rpx, 2rpx 12rpx; background-position: 30rpx 16rpx, 35rpx 11rpx; }

.ic-ic-rank { background: linear-gradient(currentColor, currentColor) no-repeat; background-size: 6rpx 18rpx; background-position: 30rpx 18rpx; }
.ic-ic-rank::before { content: ""; position: absolute; left: 8rpx; bottom: 8rpx; width: 6rpx; height: 12rpx; background: currentColor; }
.ic-ic-rank::after { content: ""; position: absolute; left: 19rpx; bottom: 8rpx; width: 6rpx; height: 24rpx; background: currentColor; }

.ic-ic-diamond { width: 30rpx; height: 30rpx; margin: 7rpx; border: 2rpx solid currentColor; border-radius: 4rpx; transform: rotate(45deg); }

.ic-ic-staff::before { content: ""; position: absolute; left: 12rpx; top: 6rpx; width: 16rpx; height: 16rpx; border: 2rpx solid currentColor; border-radius: 50%; }
.ic-ic-staff::after { content: ""; position: absolute; left: 6rpx; top: 25rpx; width: 22rpx; height: 14rpx; border: 2rpx solid currentColor; border-bottom: none; border-radius: 12rpx 12rpx 0 0; }

.ic-ic-scan { border: 2rpx solid currentColor; border-radius: 6rpx; }
.ic-ic-scan::before { content: ""; position: absolute; left: 6rpx; right: 6rpx; top: 50%; height: 2rpx; margin-top: -1rpx; background: currentColor; }

.ic-ic-pin { background: url("/assets/icons/location.svg") center / contain no-repeat; }

.ic-ic-clock { width: 36rpx; height: 36rpx; margin: 4rpx; border: 2rpx solid currentColor; border-radius: 50%; }
.ic-ic-clock::before { content: ""; position: absolute; left: 15rpx; top: 8rpx; width: 2rpx; height: 11rpx; background: currentColor; }
.ic-ic-clock::after { content: ""; position: absolute; left: 15rpx; top: 17rpx; width: 9rpx; height: 2rpx; background: currentColor; }

.ic-ic-copy::before { content: ""; position: absolute; left: 6rpx; top: 6rpx; width: 22rpx; height: 26rpx; border: 2rpx solid currentColor; border-radius: 4rpx; }
.ic-ic-copy::after { content: ""; position: absolute; left: 16rpx; top: 14rpx; width: 22rpx; height: 26rpx; border: 2rpx solid currentColor; border-radius: 4rpx; background: var(--ic-white); }

.ic-ic-gift { background: linear-gradient(currentColor, currentColor) no-repeat; background-size: 34rpx 8rpx; background-position: 5rpx 10rpx; }
.ic-ic-gift::before { content: ""; position: absolute; left: 7rpx; right: 7rpx; top: 18rpx; bottom: 4rpx; border: 2rpx solid currentColor; border-top: none; }
.ic-ic-gift::after { content: ""; position: absolute; left: 50%; top: 10rpx; bottom: 4rpx; width: 2rpx; margin-left: -1rpx; background: currentColor; }

.ic-ic-doc { width: 30rpx; height: 36rpx; margin: 4rpx 7rpx; border: 2rpx solid currentColor; border-radius: 4rpx; }
.ic-ic-doc::before { content: ""; position: absolute; left: 6rpx; right: 6rpx; top: 11rpx; height: 2rpx; background: currentColor; box-shadow: 0 8rpx 0 currentColor, 0 16rpx 0 currentColor; }

.ic-ic-shield::before { content: ""; position: absolute; left: 50%; top: 6rpx; width: 26rpx; height: 30rpx; margin-left: -13rpx; border: 2rpx solid currentColor; border-radius: 6rpx 6rpx 16rpx 16rpx; }
.ic-ic-shield::after { content: ""; position: absolute; left: 16rpx; top: 16rpx; width: 8rpx; height: 4rpx; border-left: 2rpx solid currentColor; border-bottom: 2rpx solid currentColor; transform: rotate(-45deg); }

.ic-ic-nav::before { content: ""; position: absolute; left: 9rpx; top: 7rpx; width: 0; height: 0; border-left: 13rpx solid transparent; border-right: 13rpx solid transparent; border-bottom: 26rpx solid currentColor; transform: rotate(35deg); }
.ic-ic-nav::after { content: ""; position: absolute; left: 19rpx; top: 20rpx; width: 6rpx; height: 12rpx; background: var(--ic-white); transform: rotate(35deg); }

.ic-ic-phone::before { content: ""; position: absolute; left: 8rpx; top: 8rpx; width: 20rpx; height: 20rpx; border: 3rpx solid currentColor; border-radius: 8rpx 8rpx 8rpx 2rpx; border-right-color: transparent; border-top-color: transparent; transform: rotate(-45deg); }

.ic-ic-share::before { content: ""; position: absolute; left: 9rpx; top: 12rpx; width: 20rpx; height: 20rpx; border: 2rpx solid currentColor; border-radius: 4rpx; border-top-color: transparent; }
.ic-ic-share::after { content: ""; position: absolute; left: 20rpx; top: 5rpx; width: 2rpx; height: 20rpx; background: currentColor; box-shadow: -7rpx 7rpx 0 -1rpx currentColor, 7rpx 7rpx 0 -1rpx currentColor; }

.ic-ic-check::before { content: ""; position: absolute; left: 10rpx; top: 12rpx; width: 20rpx; height: 10rpx; border-left: 3rpx solid currentColor; border-bottom: 3rpx solid currentColor; transform: rotate(-45deg); }

.ic-ic-headset::before { content: ""; position: absolute; left: 9rpx; top: 8rpx; right: 9rpx; height: 16rpx; border: 2rpx solid currentColor; border-bottom: none; border-radius: 16rpx 16rpx 0 0; }
.ic-ic-headset::after { content: ""; position: absolute; top: 22rpx; left: 8rpx; width: 6rpx; height: 12rpx; background: currentColor; border-radius: 2rpx; box-shadow: 24rpx 0 0 currentColor; }
