@import "../../styles/tokens.wxss";
.orow {
  position: relative;
  overflow: hidden;
  padding: 30rpx 28rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  border-radius: 28rpx;
  background: rgba(168, 180, 198, 0.18);
  -webkit-backdrop-filter: blur(40rpx) saturate(150%) brightness(1.04);
  backdrop-filter: blur(40rpx) saturate(150%) brightness(1.04);
  box-shadow:
    inset 0 5rpx 10rpx rgba(4, 7, 11, 0.28),
    inset 0 -2rpx 3rpx rgba(255, 255, 255, 0.14),
    inset 1rpx 0 2rpx rgba(0, 0, 0, 0.08),
    inset -1rpx 0 2rpx rgba(255, 255, 255, 0.05);
}
.orow::before {
  position: absolute;
  top: 0;
  right: 20rpx;
  left: 20rpx;
  height: 44rpx;
  border-radius: 28rpx 28rpx 40% 40%;
  background: linear-gradient(180deg, rgba(4, 7, 11, 0.2), rgba(4, 7, 11, 0));
  content: "";
  pointer-events: none;
}
.orow--last { border-bottom-color: rgba(255, 255, 255, 0.18); }
.orow--hover { opacity: 0.72; }

/* top: 标题 + 订单号同行(左) · 状态文字 + 箭头(右) */
.orow__top { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.orow__head { display: flex; align-items: baseline; gap: 16rpx; min-width: 0; }
.orow__title { font-size: 26rpx; font-weight: 600; color: rgba(255, 255, 255, 0.95); }
.orow__code { font-size: 24rpx; color: rgba(255, 255, 255, 0.56); }
.orow__status { display: flex; align-items: center; gap: 12rpx; flex: none; }
.orow__statustext { font-size: 24rpx; color: rgba(255, 255, 255, 0.78); }
.orow__arrow {
  width: 14rpx; height: 14rpx;
  border-right: 3rpx solid rgba(255, 255, 255, 0.52);
  border-top: 3rpx solid rgba(255, 255, 255, 0.52);
  transform: rotate(45deg);
}

/* body: 门店行(上) · meta(desc/时间 与 金额/支付方式) */
.orow__body { margin-top: 22rpx; display: flex; flex-direction: column; gap: 20rpx; }

/* 门店信息行：CSS 线性店铺图标 + 门店名称 */
.orow__store { display: flex; align-items: center; gap: 14rpx; }
.orow__storename { font-size: 26rpx; color: rgba(255, 255, 255, 0.82); }
.orow__shop { position: relative; width: 34rpx; height: 34rpx; flex: none; color: rgba(255, 255, 255, 0.76); }
.orow__shop::before {
  content: ""; position: absolute; top: 2rpx; left: 0; right: 0; height: 11rpx;
  border: 2rpx solid currentColor; border-radius: 8rpx 8rpx 0 0;
}
.orow__shop::after {
  content: ""; position: absolute; top: 13rpx; left: 3rpx; right: 3rpx; bottom: 2rpx;
  border: 2rpx solid currentColor; border-top: none; border-radius: 0 0 4rpx 4rpx;
}

/* meta：左列 desc/时间，右列 金额/支付方式（底部对齐，金额与 desc 同高） */
.orow__meta { display: flex; align-items: flex-end; justify-content: space-between; gap: 20rpx; }
.orow__metaL { display: flex; flex-direction: column; gap: 14rpx; min-width: 0; }
.orow__metaR { display: flex; flex-direction: column; align-items: flex-end; gap: 12rpx; }
.orow__desc { font-size: 24rpx; color: rgba(255, 255, 255, 0.62); }
.orow__time { font-size: 22rpx; color: rgba(255, 255, 255, 0.46); margin-top: 12rpx; }
.orow__amount { font-size: 30rpx; font-weight: 600; color: rgba(255, 255, 255, 0.96); font-variant-numeric: tabular-nums; }
.orow__paytext { font-size: 22rpx; color: rgba(255, 255, 255, 0.48); margin-top: 12rpx; }
