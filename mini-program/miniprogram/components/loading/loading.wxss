.loading { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 110rpx 0; }
.loading__dots { display: flex; gap: 14rpx; }
.loading__dot {
  width: 14rpx; height: 14rpx; border-radius: 50%; background: #cfcfcf;
  animation: loading-bounce 1s infinite ease-in-out both;
}
.loading__dot:nth-child(2) { animation-delay: 0.15s; }
.loading__dot:nth-child(3) { animation-delay: 0.3s; }
.loading__text { margin-top: 22rpx; font-size: 24rpx; color: #b8b8b8; }
@keyframes loading-bounce {
  0%, 80%, 100% { transform: scale(0.6); opacity: 0.4; }
  40% { transform: scale(1); opacity: 1; }
}
