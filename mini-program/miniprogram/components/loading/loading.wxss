.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 110rpx 32rpx;
  background: transparent;
}
.loading--fullscreen {
  position: fixed;
  inset: 0;
  width: 100vw;
  height: 100vh;
  padding-top: 0;
  padding-bottom: 0;
}
.loading__logo {
  display: block;
  width: 280rpx;
  height: 124rpx;
  filter: brightness(1.2) drop-shadow(0 0 14rpx rgba(255, 255, 255, 0.24));
}
.loading--fullscreen .loading__logo { width: 360rpx; height: 160rpx; }
.loading--light .loading__logo { filter: brightness(0); }
.loading__text { margin-top: 18rpx; font-size: 22rpx; line-height: 1.4; color: rgba(255, 255, 255, 0.72); }
.loading--light .loading__text { color: rgba(0, 0, 0, 0.58); }
