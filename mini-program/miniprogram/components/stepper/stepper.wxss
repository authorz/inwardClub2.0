.stepper { display: inline-flex; align-items: center; }
.stepper__btn {
  width: 52rpx; height: 52rpx; border-radius: 50%;
  border: 1.5rpx solid #d8d8d8; display: flex; align-items: center; justify-content: center;
}
.stepper__btn.is-disabled { opacity: 0.4; }
.stepper__val { min-width: 60rpx; text-align: center; font-size: 30rpx; color: #111; font-variant-numeric: tabular-nums; }
.stepper__minus { width: 22rpx; height: 3rpx; background: #333; }
.stepper__plus { width: 22rpx; height: 3rpx; background: #333; position: relative; }
.stepper__plus::after { content: ""; position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); width: 3rpx; height: 22rpx; background: #333; }
.stepper--sm .stepper__btn { width: 44rpx; height: 44rpx; }
.stepper--sm .stepper__val { min-width: 48rpx; font-size: 28rpx; }

.stepper--dark .stepper__btn { border-color: rgba(255, 255, 255, 0.5); }
.stepper--dark .stepper__val { color: #fff; }
.stepper--dark .stepper__minus,
.stepper--dark .stepper__plus,
.stepper--dark .stepper__plus::after { background: #fff; }
