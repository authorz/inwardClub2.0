@import "../../styles/tokens.wxss";
.astrip { display: flex; align-items: center; }
.astrip__col { flex: 1; display: flex; align-items: center; justify-content: center; gap: 18rpx; padding: 20rpx 0; }
.astrip__col--hover { opacity: 0.6; }
.astrip__div { width: 1rpx; height: 64rpx; background: var(--ic-line); }
.astrip__icon { width: 56rpx; height: 56rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; }
.astrip__icon--coin { background: transparent; }
.astrip__icon-img { width: 100%; height: 100%; display: block; }
.astrip__icon--point { background: #9a9a9a; }
.astrip__star { color: #fff; font-size: 26rpx; line-height: 1; }
.astrip__icon--coupon { background: transparent; }
.astrip__meta { display: flex; flex-direction: column; }
.astrip__label { font-size: 22rpx; color: var(--ic-text-3); }
.astrip__num { font-size: 30rpx; font-weight: 700; color: var(--ic-black); font-variant-numeric: tabular-nums; }
.astrip__unit { font-size: 22rpx; font-weight: 400; margin-left: 4rpx; }
