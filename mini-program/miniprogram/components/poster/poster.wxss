.poster { position: relative; width: 100%; height: 100%; overflow: hidden; background: #1a1a1a; }
.poster__img { width: 100%; height: 100%; display: block; }
.poster__ph { width: 100%; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 32rpx; text-align: center; }
.poster__sub { font-size: 20rpx; letter-spacing: 4rpx; color: rgba(255, 255, 255, 0.6); }
.poster__title { margin-top: 14rpx; font-size: 46rpx; font-weight: 700; color: #fff; letter-spacing: 2rpx; }
.poster__spade { margin-top: 22rpx; font-size: 60rpx; color: rgba(255, 255, 255, 0.85); line-height: 1; }
/* content-image placeholders: restrained dark tones (posters may carry color) */
.poster--poker { background: linear-gradient(160deg, #2a2622 0%, #0e0d0c 100%); }
.poster--poker .poster__title, .poster--poker .poster__spade { color: #d9c08a; }
.poster--coast { background: linear-gradient(160deg, #263440 0%, #0e1418 100%); }
.poster--city { background: linear-gradient(160deg, #23302e 0%, #0d1211 100%); }
.poster--member { background: linear-gradient(160deg, #eceae5 0%, #cfcbc2 100%); }
.poster--member .poster__sub { color: rgba(0, 0, 0, 0.5); }
.poster--member .poster__title, .poster--member .poster__spade { color: #1a1a1a; }
