.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 520rpx;
  padding: 120rpx 48rpx;
  text-align: center;
  box-sizing: border-box;
}
.empty--compact { min-height: 320rpx; padding: 72rpx 48rpx; }
.empty__mark {
  width: 128rpx;
  height: 128rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 30rpx;
  opacity: 0.18;
}
.empty__mark:empty {
  border-radius: 50%;
  background: linear-gradient(180deg, #f0f0f0 0%, #e2e2e2 100%);
}
.empty__icon { width: 100%; height: 100%; display: block; }
.empty__text { font-size: 24rpx; font-weight: 600; color: #9a9a9a; }
.empty__hint { font-size: 22rpx; color: #b8b8b8; margin-top: 10rpx; }
.empty__slot { margin-top: 28rpx; }
