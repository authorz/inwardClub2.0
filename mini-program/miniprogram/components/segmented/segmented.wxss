@import "../../styles/tokens.wxss";

/* ---- block: rounded track, black active fill ---- */
.seg--block {
  display: flex;
  padding: 6rpx;
  background: var(--ic-fill);
  border-radius: 16rpx;
}
.seg--block .seg__item {
  flex: 1;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: var(--ic-text-2);
}
.seg--block .seg__item.is-active {
  background: var(--ic-black);
  color: #fff;
  font-weight: 600;
}

/* ---- pill: pill track, black active pill ---- */
.seg--pill {
  display: flex;
  padding: 8rpx;
  background: var(--ic-fill);
  border-radius: 999rpx;
}
.seg--pill .seg__item {
  flex: 1;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: var(--ic-text-2);
}
.seg--pill .seg__item.is-active {
  background: var(--ic-black);
  color: #fff;
  font-weight: 600;
}

/* ---- line: underline tabs ---- */
.seg--line { display: flex; }
.seg--line .seg__item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
  font-size: 26rpx;
  color: var(--ic-text-3);
}
.seg--line .seg__item.is-active { color: var(--ic-black); font-weight: 700; }
.seg--line .seg__underline { width: 44rpx; height: 6rpx; border-radius: 6rpx; margin-top: 12rpx; background: transparent; }
.seg--line .seg__item.is-active .seg__underline { background: var(--ic-black); }

/* ---- dark: glass surfaces on the shared graphite background ---- */
.seg--dark.seg--block,
.seg--dark.seg--pill { background: rgba(4, 7, 11, 0.2); }
.seg--dark.seg--block .seg__item,
.seg--dark.seg--pill .seg__item,
.seg--dark.seg--line .seg__item { color: rgba(255, 255, 255, 0.6); }
.seg--dark.seg--block .seg__item.is-active,
.seg--dark.seg--pill .seg__item.is-active {
  background: rgba(255, 255, 255, 0.16);
  color: rgba(255, 255, 255, 0.96);
}
.seg--dark.seg--line .seg__item.is-active { color: rgba(255, 255, 255, 0.96); }
.seg--dark.seg--line .seg__item.is-active .seg__underline { background: rgba(255, 255, 255, 0.9); }

/* ---- quiet: reduced emphasis for dense, data-led pages ---- */
.seg--quiet .seg__item.is-active { font-weight: 500; }
