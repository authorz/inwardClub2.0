.page-nav {
  position: relative;
  z-index: 80;
  flex: none;
  box-sizing: border-box;
  overflow: hidden;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.13);
  background: rgba(18, 21, 27, 0.34);
  -webkit-backdrop-filter: blur(40rpx) saturate(150%) brightness(0.94);
  backdrop-filter: blur(40rpx) saturate(150%) brightness(0.94);
  box-shadow:
    inset 0 5rpx 10rpx rgba(4, 7, 11, 0.3),
    inset 0 -2rpx 3rpx rgba(255, 255, 255, 0.1);
}

.page-nav::before {
  position: absolute;
  top: 0;
  right: 44rpx;
  left: 44rpx;
  height: 42rpx;
  border-radius: 0 0 50% 50%;
  background: linear-gradient(180deg, rgba(3, 5, 8, 0.2), rgba(3, 5, 8, 0));
  content: "";
  pointer-events: none;
}

.page-nav__bar {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.page-nav__title {
  color: rgba(255, 255, 255, 0.96);
  font-size: 30rpx;
  line-height: 1;
  font-weight: 650;
  letter-spacing: 1rpx;
}

.page-nav__back,
.page-nav__left {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 24rpx;
  display: flex;
  align-items: center;
}

.page-nav__back {
  width: 80rpx;
  justify-content: flex-start;
}

.page-nav__back--pressed {
  opacity: 0.58;
}

.page-nav__left--action {
  width: 250rpx;
  gap: 8rpx;
}

.page-nav__left--pressed {
  opacity: 0.58;
}

.page-nav__left-icon {
  width: 28rpx;
  height: 28rpx;
  flex: none;
  filter: brightness(0) invert(1);
}

.page-nav__left-text {
  min-width: 0;
  overflow: hidden;
  color: rgba(255, 255, 255, 0.88);
  font-size: 22rpx;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.page-nav__back-icon {
  width: 20rpx;
  height: 20rpx;
  margin-left: 10rpx;
  transform: rotate(45deg);
  border-bottom: 4rpx solid rgba(255, 255, 255, 0.94);
  border-left: 4rpx solid rgba(255, 255, 255, 0.94);
  border-radius: 2rpx;
}

.page-nav__store {
  position: relative;
  display: flex;
  align-items: center;
  min-height: 116rpx;
  margin: 0 24rpx 18rpx;
  padding: 18rpx 22rpx;
  gap: 16rpx;
  box-sizing: border-box;
  border-top: 1rpx solid rgba(255, 255, 255, 0.1);
}

.page-nav__store--pressed {
  opacity: 0.64;
}

.page-nav__store-icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  flex: none;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
  box-shadow: inset 0 3rpx 6rpx rgba(3, 5, 8, 0.22);
}

.page-nav__store-icon {
  width: 30rpx;
  height: 30rpx;
  filter: brightness(0) invert(1);
  opacity: 0.84;
}

.page-nav__store-main {
  flex: 1;
  min-width: 0;
}

.page-nav__store-head {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.page-nav__store-name {
  min-width: 0;
  overflow: hidden;
  color: rgba(255, 255, 255, 0.94);
  font-size: 27rpx;
  line-height: 1.25;
  font-weight: 650;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.page-nav__store-tag {
  flex: none;
  padding: 3rpx 9rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 999rpx;
  color: rgba(255, 255, 255, 0.66);
  font-size: 17rpx;
  line-height: 1.3;
}

.page-nav__store-meta {
  display: flex;
  align-items: center;
  min-width: 0;
  margin-top: 8rpx;
  gap: 18rpx;
}

.page-nav__store-address,
.page-nav__store-hours {
  min-width: 0;
  overflow: hidden;
  color: rgba(255, 255, 255, 0.54);
  font-size: 19rpx;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.page-nav__store-address {
  flex: 1.2;
}

.page-nav__store-hours {
  flex: 1;
}

.page-nav__store-caret {
  width: 12rpx;
  height: 12rpx;
  flex: none;
  transform: rotate(-45deg);
  border-right: 2rpx solid rgba(255, 255, 255, 0.54);
  border-bottom: 2rpx solid rgba(255, 255, 255, 0.54);
}
