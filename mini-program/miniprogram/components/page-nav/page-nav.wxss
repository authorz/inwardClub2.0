.page-nav {
  position: relative;
  z-index: 80;
  flex: none;
  box-sizing: border-box;
  overflow: hidden;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.13);
  background: rgba(18, 21, 27, 0.34);
  -webkit-backdrop-filter: blur(40rpx) saturate(150%) brightness(0.94);
  backdrop-filter: blur(40rpx) saturate(150%) brightness(0.94);
  box-shadow:
    inset 0 5rpx 10rpx rgba(4, 7, 11, 0.3),
    inset 0 -2rpx 3rpx rgba(255, 255, 255, 0.1);
}

.page-nav::before {
  position: absolute;
  top: 0;
  right: 44rpx;
  left: 44rpx;
  height: 42rpx;
  border-radius: 0 0 50% 50%;
  background: linear-gradient(180deg, rgba(3, 5, 8, 0.2), rgba(3, 5, 8, 0));
  content: "";
  pointer-events: none;
}

.page-nav__bar {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.page-nav__title {
  color: rgba(255, 255, 255, 0.96);
  font-size: 30rpx;
  line-height: 1;
  font-weight: 650;
  letter-spacing: 1rpx;
}

.page-nav__back,
.page-nav__left {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 24rpx;
  display: flex;
  align-items: center;
}

.page-nav__back {
  width: 80rpx;
  justify-content: flex-start;
}

.page-nav__back--pressed {
  opacity: 0.58;
}

.page-nav__left--action {
  width: 250rpx;
  gap: 8rpx;
}

.page-nav__left--pressed {
  opacity: 0.58;
}

.page-nav__left-icon {
  width: 28rpx;
  height: 28rpx;
  flex: none;
  filter: brightness(0) invert(1);
}

.page-nav__left-text {
  min-width: 0;
  overflow: hidden;
  color: rgba(255, 255, 255, 0.88);
  font-size: 22rpx;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.page-nav__back-icon {
  width: 20rpx;
  height: 20rpx;
  margin-left: 10rpx;
  transform: rotate(45deg);
  border-bottom: 4rpx solid rgba(255, 255, 255, 0.94);
  border-left: 4rpx solid rgba(255, 255, 255, 0.94);
  border-radius: 2rpx;
}
