@import "./styles/vars.wxss";
@import "./styles/tokens.wxss";

/*
 * Shared app backdrop. Individual pages only define content surfaces; the
 * index page keeps its own full-screen, carousel-driven ambient layer above
 * this fallback.
 */
page {
  background-color: #171b22;
  background-image:
    url("data:image/svg+xml;base64,"),
    radial-gradient(circle at 8% 14%, rgba(134, 65, 80, 0.4) 0%, rgba(79, 43, 54, 0.2) 30%, transparent 56%),
    radial-gradient(circle at 92% 38%, rgba(57, 92, 128, 0.42) 0%, rgba(36, 63, 91, 0.2) 32%, transparent 58%),
    radial-gradient(circle at 12% 80%, rgba(43, 102, 104, 0.34) 0%, rgba(29, 69, 73, 0.16) 30%, transparent 54%),
    linear-gradient(155deg, rgba(255, 255, 255, 0.035), rgba(255, 255, 255, 0) 46%);
  background-repeat: no-repeat;
  background-position: center 58%, center, center, center, center;
  background-size: 620rpx auto, 100% 100%, 100% 100%, 100% 100%, 100% 100%;
}

/* Shared recessed iOS-style glass. Keep one surface per business region. */
.ic-glass-recessed {
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  border-radius: 32rpx;
  background: rgba(168, 180, 198, 0.18);
  -webkit-backdrop-filter: blur(40rpx) saturate(150%) brightness(1.04);
  backdrop-filter: blur(40rpx) saturate(150%) brightness(1.04);
  box-shadow:
    inset 0 5rpx 10rpx rgba(4, 7, 11, 0.28),
    inset 0 -2rpx 3rpx rgba(255, 255, 255, 0.16),
    inset 1rpx 0 2rpx rgba(0, 0, 0, 0.08),
    inset -1rpx 0 2rpx rgba(255, 255, 255, 0.05);
}

.ic-glass-recessed::before {
  position: absolute;
  top: 0;
  right: 20rpx;
  left: 20rpx;
  height: 48rpx;
  border-radius: 32rpx 32rpx 40% 40%;
  background: linear-gradient(180deg, rgba(4, 7, 11, 0.2), rgba(4, 7, 11, 0));
  content: "";
  pointer-events: none;
}

/*
 * No global tag-name reset here. Every page uses components (global
 * usingComponents in app.json), so WeChat compiles page styles with
 * component-level scoping, where tag / id / attribute selectors are
 * rejected ("Some selectors are not allowed in component wxss") and
 * silently dropped. A `view, text, … { box-sizing: border-box }` reset
 * therefore never actually applied and only produced console warnings.
 * box-sizing is set on the shared layout primitives in styles/tokens.wxss
 * (.ic-page, .ic-btn, .ic-tag, …); pages compose those classes.
 */
